---
interface Props {
  current?: string;
}
const { current = 'home' } = Astro.props;
---

<nav class="bottom-nav" id="appBottomNav">
  <a href="/" class={`bottom-nav-item ${current === 'home' ? 'active' : ''}`} id="btnNavHome">
    <div class="nav-icon-pod">
      <i class="fa-solid fa-house"></i>
    </div>
    <span class="nav-label">Beranda</span>
  </a>
  <a href="/#areaKatalog" onclick="if(window.navAksiCari) { window.navAksiCari(event); } else { window.location.href='/#areaKatalog'; }" class={`bottom-nav-item ${current === 'search' ? 'active' : ''}`} id="btnNavSearch">
    <div class="nav-icon-pod">
      <i class="fa-solid fa-compass"></i>
    </div>
    <span class="nav-label">Eksplor</span>
  </a>
  <a href="/#areaKatalog" onclick="if(window.filterKategori) { window.filterKategori(document.querySelector('.tab-btn[data-kategori=\'Favorit\']'), 'Favorit'); } else { window.location.href='/?cat=Favorit#areaKatalog'; }" class={`bottom-nav-item ${current === 'wishlist' ? 'active' : ''}`} id="btnNavWishlist">
    <div class="nav-icon-pod" style="position: relative;">
      <i class="fa-solid fa-heart"></i>
      <span class="nav-badge" id="navWishlistBadge" style="display:none;">0</span>
    </div>
    <span class="nav-label">Favorit</span>
  </a>
  <a href="/profil" class={`bottom-nav-item ${current === 'orders' ? 'active' : ''}`} id="btnNavTiket">
    <div class="nav-icon-pod">
      <i class="fa-solid fa-ticket"></i>
    </div>
    <span class="nav-label">Tiket</span>
  </a>
  <a href="/login" class={`bottom-nav-item ${current === 'profile' || current === 'owner' ? 'active' : ''}`} id="btnNavAkun">
    <div class="nav-icon-pod">
      <i class="fa-solid fa-circle-user" id="iconNavAkun"></i>
    </div>
    <span class="nav-label" id="labelNavAkun">Akun</span>
  </a>
</nav>

<style is:inline>
  .bottom-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .bottom-nav {
      display: flex;
      justify-content: space-around;
      align-items: center;
      position: fixed;
      bottom: 12px;
      left: 14px;
      right: 14px;
      height: 64px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border-radius: 28px;
      border: 1.5px solid rgba(254, 215, 170, 0.85);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08), 0 3px 12px rgba(255, 94, 31, 0.15);
      z-index: 1000;
      padding: 0 6px;
    }

    .bottom-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      flex: 1;
      height: 100%;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      position: relative;
    }

    /* Modern Icon Pod (Tidak Polos, Memiliki Kedalaman & Warna) */
    .nav-icon-pod {
      width: 40px;
      height: 32px;
      border-radius: 12px;
      background: linear-gradient(135deg, #FFFDFB 0%, #FFF7ED 100%);
      border: 1px solid #FED7AA;
      color: #EA580C;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 2px 5px rgba(255, 94, 31, 0.06);
    }

    .nav-icon-pod i {
      transition: transform 0.2s ease;
    }

    .nav-label {
      font-size: 10.5px;
      font-weight: 600;
      color: #64748B;
      margin-top: 3px;
      transition: color 0.2s ease, font-weight 0.2s ease;
      line-height: 1;
    }

    /* Active Glowing State (Ultra Kekinian) */
    .bottom-nav-item.active .nav-icon-pod {
      background: linear-gradient(135deg, #FF5E1F 0%, #FF8A00 100%) !important;
      color: #FFFFFF !important;
      border-color: #FF5E1F !important;
      box-shadow: 0 5px 16px rgba(255, 94, 31, 0.45) !important;
      transform: translateY(-4px) scale(1.08);
      border-radius: 14px;
    }

    .bottom-nav-item.active .nav-icon-pod i {
      color: #FFFFFF !important;
    }

    .bottom-nav-item.active .nav-label {
      color: #FF5E1F !important;
      font-weight: 800 !important;
    }

    /* Active Dot Indicator */
    .bottom-nav-item.active::after {
      content: '';
      position: absolute;
      bottom: 4px;
      width: 4px;
      height: 4px;
      background: #FF5E1F;
      border-radius: 50%;
      box-shadow: 0 0 6px #FF5E1F;
    }

    /* Wishlist Counter Badge */
    .nav-badge {
      position: absolute;
      top: -5px;
      right: -6px;
      background: #EF4444;
      color: #FFFFFF;
      font-size: 9.5px;
      font-weight: 800;
      border-radius: 10px;
      padding: 1px 5px;
      min-width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #FFFFFF;
      box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
    }

    /* Touch Feedback */
    .bottom-nav-item:active .nav-icon-pod {
      transform: scale(0.92);
    }

    body {
      padding-bottom: 88px !important;
    }

    .floating-cs {
      bottom: 88px !important;
    }
  }
</style>

<script is:inline>
  function sesuaikanBottomNav() {
    try {
      let user = localStorage.getItem("kamawak_user");
      let role = (localStorage.getItem("kamawak_role") || "").toLowerCase();
      let btnAkun = document.getElementById("btnNavAkun");
      let labelAkun = document.getElementById("labelNavAkun");
      let iconAkun = document.getElementById("iconNavAkun");
      if (!btnAkun) return;

      if (user && user !== "") {
        if (role.includes("owner") || role.includes("mitra")) {
          btnAkun.href = "/owner";
          if (labelAkun) labelAkun.innerText = "Mitra";
          if (iconAkun) iconAkun.className = "fa-solid fa-store";
        } else if (role.includes("admin")) {
          btnAkun.href = "/admin";
          if (labelAkun) labelAkun.innerText = "Admin";
          if (iconAkun) iconAkun.className = "fa-solid fa-gauge-high";
        } else {
          btnAkun.href = "/profil";
          if (labelAkun) labelAkun.innerText = "Profil";
          if (iconAkun) iconAkun.className = "fa-solid fa-circle-user";
        }
      } else {
        btnAkun.href = "/login";
        if (labelAkun) labelAkun.innerText = "Masuk";
        if (iconAkun) iconAkun.className = "fa-solid fa-circle-user";
      }

      // Sinkronisasi badge wishlist pada tombol Favorit
      try {
        let savedWishlist = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');
        let badgeFav = document.getElementById('navWishlistBadge');
        if (badgeFav) {
          if (savedWishlist.length > 0) {
            badgeFav.innerText = savedWishlist.length;
            badgeFav.style.display = 'flex';
          } else {
            badgeFav.style.display = 'none';
          }
        }
      } catch(e) {}
    } catch(e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sesuaikanBottomNav);
  } else {
    sesuaikanBottomNav();
  }
</script>
