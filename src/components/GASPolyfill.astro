<script is:inline>
  const API_URL = "https://script.google.com/macros/s/AKfycbx-Pq4wVKrDIpI0mND2sCE7OnjplvdUkvPM9dhXQ558uLLN1duBy92EsUETgSCd_9hn/exec";
  
  function createRunner() {
    let successCb = null;
    let failureCb = null;
    const runner = new Proxy({}, {
      get: function(target, prop) {
        if (prop === 'withSuccessHandler') return function(cb) { successCb = cb; return runner; };
        if (prop === 'withFailureHandler') return function(cb) { failureCb = cb; return runner; };
        return async function(...args) {
           try {
             const argsJson = JSON.stringify(args);
             let res;
             if (argsJson.length > 800) {
               res = await fetch(API_URL, {
                 method: 'POST',
                 headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                 body: JSON.stringify({ action: prop, args: args })
               });
             } else {
               const argsStr = encodeURIComponent(argsJson);
               const url = `${API_URL}?api=true&action=${prop}&args=${argsStr}`;
               res = await fetch(url);
             }
             const text = await res.text();
             let parsed = text;
             try { parsed = JSON.parse(text); } catch(e) {}
             if(successCb) successCb(parsed);
           } catch(e) {
             if(failureCb) failureCb(e);
           }
        }
      }
    });
    return runner;
  }
  
  window.google = {
    script: {
      get run() {
        return createRunner();
      }
    }
  };
</script>
