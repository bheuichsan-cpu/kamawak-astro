<script is:inline>
  const API_URL = "https://script.google.com/macros/s/AKfycbx-Pq4wVKrDIpI0mND2sCE7OnjplvdUkvPM9dhXQ558uLLN1duBy92EsUETgSCd_9hn/exec";
  
  function createRunner() {
    let successCb = null;
    let failureCb = null;
    const runner = new Proxy({}, {
      get: function(target, prop) {
        if (prop === 'withSuccessHandler') return function(cb) { successCb = cb; return runner; };
        if (prop === 'withFailureHandler') return function(cb) { failureCb = cb; return runner; };
        return async function(...args) {
           try {
             const argsJson = JSON.stringify(args);
             let res;
             if (argsJson.length > 800) {
               res = await fetch(API_URL, {
                 method: 'POST',
                 headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                 body: JSON.stringify({ action: prop, args: args })
               });
             } else {
               const argsStr = encodeURIComponent(argsJson);
               const url = `${API_URL}?api=true&action=${prop}&args=${argsStr}`;
               res = await fetch(url);
             }
             const text = await res.text();
             let parsed = text;
             try { parsed = JSON.parse(text); } catch(e) {}
             if(successCb) successCb(parsed);
           } catch(e) {
             if(failureCb) failureCb(e);
           }
        }
      }
    });
    return runner;
  }
  
  window.google = {
    script: {
      get run() {
        return createRunner();
      }
    }
  };

  // --- Sinkronisasi Logo Global Platform Kamawak ---
  window.updateNavbarLogo = function() {
    try {
      let logoUrl = localStorage.getItem("kamawak_prof_logo") || "";
      let namaUsaha = localStorage.getItem("kamawak_prof_nama") || "Kamawak";
      let logoEls = document.querySelectorAll('.logo');
      logoEls.forEach(logoEl => {
        let badge = logoEl.querySelector('span') ? logoEl.querySelector('span').outerHTML : '';
        let isAuthCard = logoEl.closest && logoEl.closest('.auth-card');
        if (logoUrl && logoUrl.trim() !== '') {
          let imgStyle = isAuthCard 
            ? "max-height: 48px; max-width: 180px; object-fit: contain; vertical-align: middle; border-radius: 6px; margin-bottom: 6px; display: inline-block;"
            : "max-height: 34px; max-width: 150px; object-fit: contain; vertical-align: middle; border-radius: 4px; margin-right: 6px; display: inline-block;";
          logoEl.innerHTML = `<img src="${logoUrl}" alt="${namaUsaha}" style="${imgStyle}" onerror="this.onerror=null; this.outerHTML='<i class=\\'fa-solid fa-mountain-sun\\' style=\\'color:var(--primary);\\'></i> '"> ${badge}`;
        } else {
          let icon = '<i class="fa-solid fa-mountain-sun" style="color:var(--primary); margin-right:6px;"></i> ';
          logoEl.innerHTML = `${icon} ${namaUsaha}. ${badge}`;
        }
      });
    } catch(e) {
      console.warn("Update navbar logo error:", e);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.updateNavbarLogo);
  } else {
    window.updateNavbarLogo();
  }

  // Jika logo belum ada di cache browser lokal, tarik otomatis dari backend
  if (!localStorage.getItem("kamawak_prof_logo")) {
    setTimeout(function() {
      if (window.google && window.google.script && window.google.script.run) {
        window.google.script.run.withSuccessHandler(function(config) {
          if (config && config.PROFIL_LOGO) {
            localStorage.setItem("kamawak_prof_logo", config.PROFIL_LOGO);
            if (config.PROFIL_NAMA_USAHA) {
              localStorage.setItem("kamawak_prof_nama", config.PROFIL_NAMA_USAHA);
            }
            window.updateNavbarLogo();
          }
        }).getPengaturan();
      }
    }, 200);
  }
</script>
