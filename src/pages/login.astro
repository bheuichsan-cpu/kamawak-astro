---
import GASPolyfill from '../components/GASPolyfill.astro';
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Autentikasi - Kamawak</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style is:inline>
    :root { --primary: #FF5E1F; --bg-color: #F5F7FA; --text-dark: #1C2430; --text-gray: #6B7280; --white: #FFFFFF; --shadow: 0 10px 30px rgba(0,0,0,0.1); --radius: 16px; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: url('https://images.unsplash.com/photo-1574958269340-fa927503f3cb?w=1200') center/cover; color: var(--text-dark); display: flex; align-items: center; justify-content: center; min-height: 100vh; position: relative; padding: 20px; }
    .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(rgba(28, 36, 48, 0.7), rgba(255, 94, 31, 0.6)); z-index: 1; }
    
    .auth-card { background: var(--white); padding: 40px; border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; max-width: 450px; text-align: center; position: relative; z-index: 2; border-top: 6px solid var(--primary); max-height: 90vh; overflow-y: auto; }
    .auth-card::-webkit-scrollbar { width: 6px; }
    .auth-card::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 10px; }

    .logo { font-family: 'Poppins', sans-serif; font-size: 32px; font-weight: 700; color: var(--primary); margin-bottom: 8px; display: block; text-decoration: none; }
    .auth-card p { color: var(--text-gray); margin-bottom: 25px; font-size: 14px; line-height: 1.5; }
    
    .form-group { text-align: left; margin-bottom: 15px; position: relative; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text-dark); }
    .input-wrapper { position: relative; display: flex; align-items: center; }
    .input-wrapper i.icon-left { position: absolute; left: 15px; color: var(--text-gray); font-size: 15px; }
    
    .form-control { width: 100%; padding: 12px 15px 12px 42px; border: 1px solid #E5E7EB; border-radius: 10px; font-size: 14px; outline: none; transition: 0.3s; background: #F9FAFB; color: var(--text-dark); }
    .form-control:focus { border-color: var(--primary); background: var(--white); box-shadow: 0 0 0 4px rgba(255, 94, 31, 0.1); }
    
    .otp-input { text-align: center; font-size: 24px; letter-spacing: 10px; font-weight: 700; padding: 15px; }
    
    .eye-btn { position: absolute; right: 15px; color: var(--text-gray); cursor: pointer; padding: 5px; font-size: 16px; transition: 0.2s; }
    .eye-btn:hover { color: var(--primary); }

    .btn-submit { background: var(--primary); color: var(--white); border: none; padding: 14px; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 15px; width: 100%; transition: 0.3s; margin-top: 10px; box-shadow: 0 4px 15px rgba(255, 94, 31, 0.3); }
    .btn-submit:hover { background: #E04D14; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 94, 31, 0.4); }
    
    .loading-text { color: var(--primary); font-weight: 600; display: none; margin-top: 20px; font-size: 14px; }
    .msg-box { padding: 12px; border-radius: 8px; font-weight: 600; display: none; margin-top: 20px; font-size: 13px; }
    .msg-error { background: #FEE2E2; color: #DC2626; border: 1px solid #FCA5A5; }
    .msg-success { background: #D1FAE5; color: #059669; border: 1px solid #6EE7B7; }
    
    .footer-link { margin-top: 25px; font-size: 13px; color: var(--text-gray); }
    .footer-link a { color: var(--primary); text-decoration: none; font-weight: 600; cursor: pointer; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    
    /* ANIMASI TAMBAHAN */
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .auth-card { animation: fadeIn 0.4s ease-out; }

    /* RESPONSIVE DESIGN (MOBILE) */
    @media (max-width: 768px) {
        .split-layout { grid-template-columns: 1fr; }
        .brand-panel { display: none; }
        .login-panel { padding: 30px 20px; align-items: flex-start; }
        .login-box { max-width: 100%; padding: 0; }
        .form-row { grid-template-columns: 1fr; gap: 10px; }
    }
  </style>
  <GASPolyfill />
</head>
<body>
  <div class="overlay"></div>
  
  <!-- KARTU 1: LOGIN -->
  <div class="auth-card" id="cardLogin">
    <a href="/" class="logo">Kamawak.</a>
    <p>Selamat Datang Kembali!<br>Masuk dengan aman ke portal Anda.</p>

    <div class="form-group">
      <label>Username / Email / No. WhatsApp</label>
      <div class="input-wrapper">
        <i class="fa-solid fa-user icon-left"></i>
        <input type="text" id="logIdentitas" class="form-control" placeholder="Masukkan identitas">
      </div>
    </div>
    
    <div class="form-group">
      <label>Kata Sandi</label>
      <div class="input-wrapper">
        <i class="fa-solid fa-lock icon-left"></i>
        <input type="password" id="logPassword" class="form-control" placeholder="Masukkan kata sandi">
        <i class="fa-solid fa-eye-slash eye-btn" id="eyeLogin" onclick="togglePass('logPassword', 'eyeLogin')"></i>
      </div>
    </div>

    <button class="btn-submit" id="btnMasuk" onclick="prosesLogin()">Masuk ke Dasbor</button>
    
    <div id="loadingLogin" class="loading-text"><i class="fa-solid fa-spinner fa-spin"></i> Memverifikasi kredensial...</div>
    <div id="msgLogin" class="msg-box msg-error"><i class="fa-solid fa-circle-exclamation"></i> <span id="txtLogin"></span></div>
    
    <div class="footer-link">
      Belum memiliki akun? <a onclick="tukarMode('register')">Daftar Sekarang</a>
    </div>
  </div>

  <!-- KARTU 2: REGISTER -->
  <div class="auth-card" id="cardRegister" style="display:none;">
    <a href="/" class="logo">Kamawak.</a>
    <p>Bergabung Bersama Kami<br>Buat akun baru dalam hitungan detik.</p>

    <div class="form-group">
      <label>Nama Lengkap</label>
      <div class="input-wrapper"><i class="fa-solid fa-id-card icon-left"></i><input type="text" id="regNama" class="form-control" placeholder="Nama sesuai KTP"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Username</label><div class="input-wrapper"><i class="fa-solid fa-at icon-left"></i><input type="text" id="regUser" class="form-control" placeholder="namasaya"></div></div>
      <div class="form-group"><label>No. WhatsApp</label><div class="input-wrapper"><i class="fa-brands fa-whatsapp icon-left"></i><input type="tel" id="regWA" class="form-control" placeholder="0812..."></div></div>
    </div>
    <div class="form-group">
      <label>Alamat Email (Wajib Aktif)</label>
      <div class="input-wrapper"><i class="fa-solid fa-envelope icon-left"></i><input type="email" id="regEmail" class="form-control" placeholder="email@anda.com"></div>
    </div>
    
    <!-- FITUR BARU: Sandi dan Konfirmasi Sandi -->
    <div class="form-row">
      <div class="form-group">
        <label>Kata Sandi Baru</label>
        <div class="input-wrapper">
          <i class="fa-solid fa-lock icon-left"></i>
          <input type="password" id="regPassword" class="form-control" placeholder="Buat sandi">
          <i class="fa-solid fa-eye-slash eye-btn" id="eyeReg" onclick="togglePass('regPassword', 'eyeReg')"></i>
        </div>
      </div>
      <div class="form-group">
        <label>Ulangi Sandi</label>
        <div class="input-wrapper">
          <i class="fa-solid fa-check-double icon-left"></i>
          <input type="password" id="regConfirm" class="form-control" placeholder="Konfirmasi">
          <i class="fa-solid fa-eye-slash eye-btn" id="eyeRegConfirm" onclick="togglePass('regConfirm', 'eyeRegConfirm')"></i>
        </div>
      </div>
    </div>

    <button class="btn-submit" id="btnDaftar" onclick="prosesRegister()">Daftar & Kirim OTP</button>
    
    <div id="loadingReg" class="loading-text"><i class="fa-solid fa-spinner fa-spin"></i> Mengirim OTP ke Email Anda...</div>
    <div id="msgReg" class="msg-box"><i class="fa-solid fa-circle-info"></i> <span id="txtReg"></span></div>
    
    <div class="footer-link">Sudah memiliki akun? <a onclick="tukarMode('login')">Masuk di sini</a></div>
  </div>

  <!-- KARTU 3: VERIFIKASI OTP -->
  <div class="auth-card" id="cardOTP" style="display:none;">
    <i class="fa-solid fa-envelope-open-text" style="font-size: 50px; color: var(--primary); margin-bottom: 15px;"></i>
    <h2 style="font-family: 'Poppins'; font-size: 22px; margin-bottom: 5px;">Cek Email Anda</h2>
    <p style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 15px;">Kami telah mengirimkan 6 digit kode OTP ke email <br><b id="displayEmail" style="color: var(--text-main);"></b></p>

    <div class="form-group">
      <input type="text" id="inputOTP" class="form-control otp-input" placeholder="000000" maxlength="6" oninput="this.value = this.value.replace(/[^0-9]/g, '')" onkeypress="if(event.key === 'Enter') prosesOTP()">
    </div>

    <div style="font-size: 12px; color: #718096; margin-bottom: 15px; line-height: 1.5; background: #fff8f0; padding: 10px 14px; border-radius: 8px; border: 1px solid #fed7aa; text-align: left;">
      <i class="fa-solid fa-circle-question" style="color: #ea580c; margin-right: 5px;"></i> Tidak menemukan email di Kotak Masuk? Pastikan untuk memeriksa folder <b>Spam</b> atau <b>Promosi</b>.
    </div>

    <button class="btn-submit" id="btnVerifikasi" onclick="prosesOTP()">Verifikasi Akun</button>
    
    <div style="margin-top: 15px; font-size: 13px; color: var(--text-muted);">
      Belum menerima kode? 
      <button id="btnKirimUlangOTP" onclick="kirimUlangOTP()" style="background: none; border: none; color: var(--primary); font-weight: 600; cursor: pointer; padding: 0; text-decoration: underline;" disabled>
        Kirim Ulang (<span id="otpTimer">60</span>s)
      </button>
    </div>

    <div id="loadingOTP" class="loading-text"><i class="fa-solid fa-spinner fa-spin"></i> Memvalidasi kode...</div>
    <div id="msgOTP" class="msg-box"><i class="fa-solid fa-circle-info"></i> <span id="txtOTP"></span></div>
    
    <div class="footer-link" style="margin-top: 15px;">Salah memasukkan email? <a onclick="tukarMode('register')">Kembali</a></div>
  </div>

  <script>
    import { supabase } from '../lib/supabase.js';

    window.onload = function() {
      if (typeof window.updateNavbarLogo === 'function') window.updateNavbarLogo();
    };

    // --- Fungsi Hash Sandi ---
    async function hashPassword(password) {
      if (!window.crypto || !window.crypto.subtle) {
          // Fallback untuk testing di jaringan lokal tanpa HTTPS
          console.warn("Web Crypto API tidak tersedia. Menggunakan fallback Base64.");
          return btoa(password);
      }
      const msgBuffer = new TextEncoder().encode(password);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    // --- Fungsi Beralih Antar Kartu (UI) ---
    window.tukarMode = function(mode) {
      document.getElementById('cardLogin').style.display = 'none';
      document.getElementById('cardRegister').style.display = 'none';
      document.getElementById('cardOTP').style.display = 'none';
      if(mode === 'login') document.getElementById('cardLogin').style.display = 'block';
      if(mode === 'register') document.getElementById('cardRegister').style.display = 'block';
      if(mode === 'otp') document.getElementById('cardOTP').style.display = 'block';
    }
    
    window.togglePass = function(inputId, iconId) {
      let ipt = document.getElementById(inputId); let icn = document.getElementById(iconId);
      if(ipt.type === "password") { ipt.type = "text"; icn.className = "fa-solid fa-eye eye-btn"; } 
      else { ipt.type = "password"; icn.className = "fa-solid fa-eye-slash eye-btn"; }
    }

    // --- 1. PROSES LOGIN ---
    window.prosesLogin = async function() {
      let identitas = document.getElementById('logIdentitas').value.trim();
      let pass = document.getElementById('logPassword').value.trim();
      let loader = document.getElementById('loadingLogin'); 
      let msgBox = document.getElementById('msgLogin'); 
      let txtBox = document.getElementById('txtLogin'); 
      let btn = document.getElementById('btnMasuk');
      
      if (!identitas || !pass) { txtBox.innerText = "Identitas dan Sandi wajib diisi."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block"; return; }
      btn.style.display = "none"; loader.style.display = "block"; msgBox.style.display = "none";

      let hashedPass = await hashPassword(pass);

      // Coba cari dengan password yang sudah di-hash
      let { data, error } = await supabase
        .from('users')
        .select('*')
        .or(`nama.eq."${identitas}",email.eq."${identitas}",username.eq."${identitas}",wa.eq."${identitas}"`)
        .eq('password', hashedPass)
        .single();
        
      if (error || !data) {
          // Jika tidak ketemu, coba cari dengan plaintext (Migrasi)
          let { data: dataLegacy, error: errLegacy } = await supabase
            .from('users')
            .select('*')
            .or(`nama.eq."${identitas}",email.eq."${identitas}",username.eq."${identitas}",wa.eq."${identitas}"`)
            .eq('password', pass)
            .single();
            
          if (dataLegacy) {
              data = dataLegacy;
              // Update sandi ke versi hash secara background
              await supabase.from('users').update({password: hashedPass}).eq('id', dataLegacy.id);
          }
      }
      
      loader.style.display = "none"; btn.style.display = "block";
      
      if (!data) {
          txtBox.innerText = "Kredensial tidak valid atau tidak ditemukan."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
      } else {
          localStorage.setItem("kamawak_user", data.nama); 
          localStorage.setItem("kamawak_role", data.role);
          
          let roleStr = data.role.toLowerCase();
          if (roleStr === "admin") { window.location.href = "/admin"; }
          else if (roleStr === "owner" || roleStr === "mitra") { window.location.href = "/owner"; }
          else { window.location.href = "/"; }
      }
    };

    let tempRegData = null;
    let tempOTP = null;

    // --- 2. PROSES REGISTER ---
    window.prosesRegister = async function() {
      let rawPass = document.getElementById('regPassword').value.trim();
      let hashedPass = await hashPassword(rawPass);
      
      let data = {
        nama: document.getElementById('regNama').value.trim(), username: document.getElementById('regUser').value.trim(),
        wa: document.getElementById('regWA').value.trim(), email: document.getElementById('regEmail').value.trim(),
        password: hashedPass
      };
      
      let passConfirm = document.getElementById('regConfirm').value.trim();
      
      let loader = document.getElementById('loadingReg'); let msgBox = document.getElementById('msgReg'); let txtBox = document.getElementById('txtReg'); let btn = document.getElementById('btnDaftar');
      
      if (!data.nama || !data.username || !data.wa || !data.email || !rawPass || !passConfirm) { txtBox.innerText = "Mohon lengkapi seluruh form pendaftaran."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block"; return; }
      if (rawPass !== passConfirm) { txtBox.innerText = "Konfirmasi kata sandi tidak cocok!"; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block"; return; }
      
      btn.style.display = "none"; loader.style.display = "block"; msgBox.style.display = "none";
      
      // CEK SUPABASE
      const { data: existingUser, error: errCek } = await supabase
        .from('users')
        .select('id, nama, email, username, wa')
        .or(`nama.eq."${data.nama}",email.eq."${data.email}",username.eq."${data.username}",wa.eq."${data.wa}"`);
        
      if (existingUser && existingUser.length > 0) {
         let conflict = existingUser[0];
         let msg = "Identitas sudah terdaftar: ";
         if(conflict.nama === data.nama) msg += "Nama Lengkap ";
         else if(conflict.email === data.email) msg += "Email ";
         else if(conflict.username === data.username) msg += "Username ";
         else if(conflict.wa === data.wa) msg += "WhatsApp ";
         
         loader.style.display = "none"; btn.style.display = "block";
         txtBox.innerText = msg + "sudah digunakan. Silakan gunakan yang lain atau langsung masuk."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
         return;
      }

      tempOTP = Math.floor(100000 + Math.random() * 900000).toString();
      tempRegData = data;

      google.script.run.withFailureHandler(function(err) {
        loader.style.display = "none"; btn.style.display = "block";
        txtBox.innerText = "Error koneksi pengiriman email: " + (err.message || err); msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
      }).withSuccessHandler(function(resString) {
        try {
          let res = typeof resString === 'string' ? JSON.parse(resString) : resString; 
          loader.style.display = "none"; btn.style.display = "block";
          if (res && (res.success || !res.error)) {
            document.getElementById('displayEmail').innerText = data.email;
            window.tukarMode('otp');
            startOtpCountdown(60);
          } else {
            txtBox.innerText = "Gagal mengirim OTP: " + (res.error || res.message || "Layanan email sibuk."); 
            msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
          }
        } catch(e) { 
          loader.style.display = "none"; btn.style.display = "block"; 
          txtBox.innerText = "Terjadi kesalahan sistem pengiriman OTP: " + e.message; 
          msgBox.className = "msg-box msg-error"; msgBox.style.display = "block"; 
        }
      }).kirimEmailOTP(data.email, data.nama, tempOTP);
    };

    // --- FITUR COUNTDOWN & KIRIM ULANG OTP ---
    let otpTimerInterval = null;
    function startOtpCountdown(seconds = 60) {
      let btnKirimUlang = document.getElementById('btnKirimUlangOTP');
      if (!btnKirimUlang) return;

      clearInterval(otpTimerInterval);
      let timeLeft = seconds;
      btnKirimUlang.disabled = true;
      btnKirimUlang.style.opacity = '0.6';
      btnKirimUlang.style.cursor = 'not-allowed';
      btnKirimUlang.innerHTML = `Kirim Ulang (<span id="otpTimer">${timeLeft}</span>s)`;

      otpTimerInterval = setInterval(() => {
        timeLeft--;
        let span = document.getElementById('otpTimer');
        if (span) span.innerText = timeLeft;
        if (timeLeft <= 0) {
          clearInterval(otpTimerInterval);
          btnKirimUlang.disabled = false;
          btnKirimUlang.style.opacity = '1';
          btnKirimUlang.style.cursor = 'pointer';
          btnKirimUlang.innerHTML = 'Kirim Ulang OTP';
        }
      }, 1000);
    }

    window.kirimUlangOTP = function() {
      if (!tempRegData || !tempRegData.email) {
        Swal.fire('Perhatian', 'Sesi pendaftaran tidak ditemukan. Silakan daftar kembali.', 'warning').then(() => {
          window.tukarMode('register');
        });
        return;
      }
      
      let btnKirimUlang = document.getElementById('btnKirimUlangOTP');
      btnKirimUlang.disabled = true;
      btnKirimUlang.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...';
      
      tempOTP = Math.floor(100000 + Math.random() * 900000).toString();

      google.script.run.withFailureHandler(function(err) {
        btnKirimUlang.disabled = false;
        btnKirimUlang.innerHTML = 'Kirim Ulang OTP';
        Swal.fire('Gagal Mengirim', 'Terjadi gangguan jaringan: ' + (err.message || err), 'error');
      }).withSuccessHandler(function(resString) {
        try {
          let res = typeof resString === 'string' ? JSON.parse(resString) : resString;
          if (res && (res.success || !res.error)) {
            Swal.fire({
              icon: 'success',
              title: 'OTP Terkirim!',
              text: 'Kode OTP baru telah dikirimkan ke email ' + tempRegData.email,
              timer: 2500,
              showConfirmButton: false
            });
            startOtpCountdown(60);
          } else {
            btnKirimUlang.disabled = false;
            btnKirimUlang.innerHTML = 'Kirim Ulang OTP';
            Swal.fire('Gagal Mengirim', (res && res.error) ? res.error : 'Layanan email sibuk.', 'error');
          }
        } catch(e) {
          btnKirimUlang.disabled = false;
          btnKirimUlang.innerHTML = 'Kirim Ulang OTP';
          Swal.fire('Gagal Mengirim', 'Kesalahan respon: ' + e.message, 'error');
        }
      }).kirimEmailOTP(tempRegData.email, tempRegData.nama, tempOTP);
    };

    // --- 3. PROSES OTP ---
    window.prosesOTP = async function() {
      let otpInput = document.getElementById('inputOTP').value.trim();
      let loader = document.getElementById('loadingOTP'); let msgBox = document.getElementById('msgOTP'); let txtBox = document.getElementById('txtOTP'); let btn = document.getElementById('btnVerifikasi');
      
      if(otpInput.length < 6) { txtBox.innerText = "Masukkan 6 digit kode OTP."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block"; return; }
      btn.style.display = "none"; loader.style.display = "block"; msgBox.style.display = "none";

      if (!tempOTP || !tempRegData) {
        loader.style.display = "none"; btn.style.display = "block";
        txtBox.innerText = "Sesi verifikasi kadaluarsa. Silakan lakukan pendaftaran kembali."; 
        msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
        return;
      }

      if (otpInput === tempOTP) {
        // Cek apakah akun sudah sempat tersimpan (misal double-click / refresh)
        const { data: cekUlang } = await supabase
          .from('users')
          .select('id, nama')
          .or(`nama.eq."${tempRegData.nama}",email.eq."${tempRegData.email}"`);

        if (cekUlang && cekUlang.length > 0) {
          loader.style.display = "none"; btn.style.display = "block";
          localStorage.setItem("kamawak_user", tempRegData.nama);
          localStorage.setItem("kamawak_role", "Wisatawan");
          Swal.fire('Berhasil', 'Akun Anda berhasil diverifikasi!', 'success').then(() => { window.location.href = "/"; });
          return;
        }

        // OTP Valid, Simpan data permanen ke Supabase
        const { data: newUser, error: errInsert } = await supabase
          .from('users')
          .insert([{
            nama: tempRegData.nama,
            username: tempRegData.username,
            wa: tempRegData.wa,
            email: tempRegData.email,
            password: tempRegData.password, // Sudah ter-hash
            role: 'Wisatawan', // Default role dengan huruf besar agar konsisten
            status_langganan: 'Aktif'
          }]);

        loader.style.display = "none"; btn.style.display = "block";
        if (errInsert) {
           if (errInsert.code === '23505' || errInsert.message.includes('unique')) {
              // Jika sudah tersimpan di database
              localStorage.setItem("kamawak_user", tempRegData.nama);
              localStorage.setItem("kamawak_role", "Wisatawan");
              Swal.fire('Berhasil', 'Akun Anda berhasil diverifikasi!', 'success').then(() => { window.location.href = "/"; });
           } else {
              txtBox.innerText = "Gagal menyimpan pendaftaran: " + errInsert.message; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
           }
        } else {
           // Auto-login setelah register
           localStorage.setItem("kamawak_user", tempRegData.nama);
           localStorage.setItem("kamawak_role", "Wisatawan");
           Swal.fire('Berhasil', 'Akun Anda berhasil dibuat!', 'success').then(() => { window.location.href = "/"; });
        }
      } else {
        loader.style.display = "none"; btn.style.display = "block";
        txtBox.innerText = "Kode OTP tidak valid atau salah. Silakan periksa kembali."; msgBox.className = "msg-box msg-error"; msgBox.style.display = "block";
      }
    };
</script>
</body>
</html>