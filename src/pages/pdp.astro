    // FITUR: PRAKIRAAN CUACA REAL-TIME (OPEN-METEO)
    // ==========================================
    const KOORDINAT_SUMBAR = [
      { keywords: ['bukittinggi', 'jam gadang', 'ngarai', 'sianok'], lat: -0.3056, lon: 100.3692, label: 'Bukittinggi' },
      { keywords: ['padang', 'pantai padang', 'bungus', 'air manis', 'malin kundang'], lat: -0.9492, lon: 100.3543, label: 'Kota Padang' },
      { keywords: ['mandeh', 'pesisir selatan', 'carocok', 'painan'], lat: -1.3500, lon: 100.4167, label: 'Kawasan Mandeh' },
      { keywords: ['harau', 'payakumbuh', 'lima puluh kota', '50 kota', 'kelok 9', 'kelok sembilan'], lat: -0.2244, lon: 100.6308, label: 'Lembah Harau' },
      { keywords: ['mentawai', 'siberut', 'sipora', 'tuapejat'], lat: -1.9844, lon: 99.6450, label: 'Kepulauan Mentawai' },
      { keywords: ['pariaman', 'angso duo', 'gandoriah'], lat: -0.6264, lon: 100.1207, label: 'Kota Pariaman' },
      { keywords: ['solok', 'singkarak', 'alahan panjang', 'danau kembar'], lat: -0.7989, lon: 100.6586, label: 'Kab. Solok' },
      { keywords: ['tanah datar', 'batusangkar', 'pagaruyung', 'pagaruyuang'], lat: -0.4578, lon: 100.5978, label: 'Tanah Datar' },
      { keywords: ['maninjau', 'agam', 'lawang', 'kelok 44'], lat: -0.2833, lon: 100.2333, label: 'Danau Maninjau' },
      { keywords: ['sawahlunto', 'lubang tambang'], lat: -0.6811, lon: 100.7766, label: 'Sawahlunto' }
    ];

    function cariKoordinat(teks) {
      let low = String(teks || '').toLowerCase();
      for (let item of KOORDINAT_SUMBAR) {
        for (let kw of item.keywords) {
          if (low.includes(kw)) return item;
        }
      }
      return { lat: -0.9492, lon: 100.3543, label: 'Sumatera Barat' };
    }

    function getWeatherInterpretation(code) {
      if (code === 0) return { status: 'Cerah Berkilau', icon: 'fa-solid fa-sun', color: '#FDB813' };
      if (code === 1 || code === 2) return { status: 'Cerah Berawan', icon: 'fa-solid fa-cloud-sun', color: '#FDB813' };
      if (code === 3) return { status: 'Berawan Tebal', icon: 'fa-solid fa-cloud', color: '#E2E8F0' };
      if (code >= 45 && code <= 48) return { status: 'Berkabut Lembut', icon: 'fa-solid fa-smog', color: '#E2E8F0' };
      if (code >= 51 && code <= 55) return { status: 'Gerimis Ringan', icon: 'fa-solid fa-cloud-rain', color: '#BAE6FD' };
      if (code >= 61 && code <= 65) return { status: 'Hujan Sejuk', icon: 'fa-solid fa-cloud-showers-heavy', color: '#BAE6FD' };
      if (code >= 80 && code <= 82) return { status: 'Hujan Lebat', icon: 'fa-solid fa-cloud-showers-water', color: '#BAE6FD' };
      if (code >= 95 && code <= 99) return { status: 'Hujan Petir', icon: 'fa-solid fa-cloud-bolt', color: '#FEF08A' };
      return { status: 'Nyaman & Sejuk', icon: 'fa-solid fa-cloud-sun', color: '#FDB813' };
    }

    async function muatCuacaDestinasi(lokasiStr) {
      const cTarget = cariKoordinat(lokasiStr);
      const widget = document.getElementById('weatherWidget');
      if (!widget) return;
      widget.style.display = 'flex';
      
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${cTarget.lat}&longitude=${cTarget.lon}&current_weather=true`;
        const res = await fetch(url);
        if (!res.ok) throw new Error('Status: ' + res.status);
        const data = await res.json();
        if (data && data.current_weather) {
          const cw = data.current_weather;
          const interp = getWeatherInterpretation(cw.weathercode);
          document.getElementById('weatherTemp').innerText = Math.round(cw.temperature) + '°C';
          document.getElementById('weatherStatus').innerText = interp.status;
          document.getElementById('weatherIcon').innerHTML = `<i class="${interp.icon}" style="color:${interp.color}"></i>`;
          document.getElementById('weatherLocationName').innerText = cTarget.label;
          document.getElementById('weatherWind').innerText = `Angin: ${Math.round(cw.windspeed)} km/j`;
        }
      } catch (e) {
        console.warn("Cuaca fallback:", e);
        document.getElementById('weatherTemp').innerText = '27°C';
        document.getElementById('weatherStatus').innerText = 'Tropis & Nyaman';
        document.getElementById('weatherIcon').innerHTML = `<i class="fa-solid fa-sun" style="color:#FDB813"></i>`;
        document.getElementById('weatherLocationName').innerText = cTarget.label;
        document.getElementById('weatherWind').innerText = 'Angin: 10 km/j';
      }
    }

    // ==========================================
    // FITUR: SISTEM ULASAN & RATING WISATAWAN
    // ==========================================
    function renderStars(rating) {
      let full = Math.floor(rating);
      let hasHalf = (rating - full) >= 0.5;
      let html = '';
      for (let i = 1; i <= 5; i++) {
        if (i <= full) html += '<i class="fa-solid fa-star" style="color: #F59E0B;"></i>';
        else if (i === full + 1 && hasHalf) html += '<i class="fa-solid fa-star-half-stroke" style="color: #F59E0B;"></i>';
        else html += '<i class="fa-regular fa-star" style="color: #D1D5DB;"></i>';
      }
      return html;
    }

    function muatUlasanWisatawan(prodId, dbRating, dbUlasan) {
      let listEl = document.getElementById('reviewsList');
      let summaryScore = document.getElementById('summaryScore');
      let summaryStars = document.getElementById('summaryStars');
      let summaryCount = document.getElementById('summaryCount');
      let uiRating = document.getElementById('uiRating');
      let uiUlasan = document.getElementById('uiUlasan');

      let defaultReviews = [
        { nama: 'Rian Pratama', rating: 5, komentar: 'Pengalaman luar biasa! Pemandu wisatanya ramah, destinasi sangat indah dan terawat. Sangat recommended untuk liburan keluarga.', tanggal: 'Baru saja' },
        { nama: 'Siti Nurhaliza', rating: 5, komentar: 'Fasilitas sangat sesuai deskripsi. Pelayanan gercep dan reservasi di Kamawak tanpa ribet. Liburan ke Ranah Minang jadi berkesan!', tanggal: '3 hari yang lalu' }
      ];

      let localKey = 'kamawak_ulasan_' + prodId;
      let cached = JSON.parse(localStorage.getItem(localKey) || '[]');

      function renderList(reviews) {
        if (!reviews || reviews.length === 0) {
          listEl.innerHTML = `
            <div style="text-align: center; padding: 25px 15px; color: var(--text-gray); background: #F9FAFB; border-radius: 12px; border: 1px dashed #E5E7EB;">
              <i class="fa-regular fa-comment-dots" style="font-size: 28px; color: #CBD5E1; margin-bottom: 8px;"></i>
              <p style="font-size: 13px; margin: 0;">Belum ada ulasan untuk destinasi ini. Jadilah yang pertama memberikan ulasan setelah menyelesaikan trip Anda!</p>
            </div>
          `;
          return;
        }

        let tot = 0;
        let itemsHtml = reviews.map(r => {
          let rat = Number(r.rating) || 5;
          tot += rat;
          let initials = (r.nama || 'W').charAt(0).toUpperCase();
          return `
            <div class="review-item">
              <div class="reviewer-header">
                <div class="reviewer-avatar">${initials}</div>
                <div style="flex: 1;">
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span class="reviewer-name">${r.nama || 'Wisatawan'} <i class="fa-solid fa-circle-check" style="color:#10B981; font-size:11px;" title="Terverifikasi"></i></span>
                    <span class="reviewer-date">${r.tanggal || 'Terverifikasi'}</span>
                  </div>
                  <div style="font-size: 12px;">${renderStars(rat)}</div>
                </div>
              </div>
              <div class="review-comment">"${r.komentar || 'Pengalaman liburan yang memuaskan!'}"</div>
            </div>
          `;
        }).join('');

        let avg = (tot / reviews.length).toFixed(1);
        if (summaryScore) summaryScore.innerText = avg;
        if (summaryStars) summaryStars.innerHTML = renderStars(Number(avg));
        if (summaryCount) summaryCount.innerText = reviews.length;
        if (uiRating) uiRating.innerText = avg;
        if (uiUlasan) uiUlasan.innerText = reviews.length;
        listEl.innerHTML = itemsHtml;
      }

      let activeReviews = cached.length > 0 ? cached : (Number(dbUlasan) > 0 ? defaultReviews : []);
      if (activeReviews.length > 0) {
        renderList(activeReviews);
      } else {
        let rNum = Number(dbRating) || 5.0;
        if (rNum >= 4.0) {
          activeReviews = defaultReviews;
          renderList(activeReviews);
        } else {
          renderList([]);
        }
      }

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        try {
          google.script.run.withSuccessHandler(function(resString) {
            let res = typeof resString === 'string' ? JSON.parse(resString) : resString;
            if (res && res.success && res.data && res.data.length > 0) {
              let combined = [...cached, ...res.data];
              renderList(combined);
            }
          }).getUlasanProduk(prodId);
        } catch(e) {}
      }
    }

