            { jam: '08:30 - 09:00 WIB', judul: 'Registrasi & Briefing Keberangkatan', desc: 'Penjemputan di titik kumpul, perkenalan pemandu, serta arahan keselamatan dan kenyamanan trip.' },
            { jam: '09:00 - 12:00 WIB', judul: 'Eksplorasi Destinasi Utama & Spot Foto', desc: 'Menikmati pesona daya tarik utama dengan panduan cerita sejarah dan keunikan budaya lokal.' },
            { jam: '12:00 - 13:30 WIB', judul: 'Istirahat & Makan Siang Khas Minang', desc: 'Waktu istirahat ibadah dan makan siang bersama mencicipi hidangan otentik kaya rempah.' },
            { jam: '13:30 - 15:30 WIB', judul: 'Aktivitas Seru, Budaya, & Spot Estetik', desc: 'Menjelajahi keindahan alam sekitar, berinteraksi dengan warga lokal, dan hunting foto terbaik.' },
            { jam: '16:00 - 17:00 WIB', judul: 'Pusat Suvenir & Penutupan Tour', desc: 'Mampir ke sentra oleh-oleh lokal sebelum mengakhiri perjalanan wisata dengan pengalaman berkesan.' }
          ];
        }
      }

      let html = '';
      listItinerary.forEach((item, index) => {
        html += `
          <div class="itinerary-step">
            <div class="itinerary-dot"><i class="fa-solid fa-location-dot"></i></div>
            <span class="itinerary-time"><i class="fa-regular fa-clock"></i> ${item.jam || ('Aktivitas ' + (index + 1))}</span>
            <div class="itinerary-title">${item.judul || 'Aktivitas Wisata'}</div>
            <div class="itinerary-desc">${item.desc || ''}</div>
          </div>
        `;
      });

      container.innerHTML = html;
      if (section) section.style.display = 'block';
    }
    window.muatItineraryDestinasi = muatItineraryDestinasi;

    // ==========================================
    // FITUR: SISTEM KODE PROMO & VOUCHER ENGINE
    // ==========================================
    const DEFAULT_PROMO_CODES = [
      { kode: 'MINANGSERU', tipe: 'persen', nilai: 10, min: 100000, deskripsi: 'Diskon 10% Spesial Jelajah Minangkabau', aktif: true },
      { kode: 'HEMAT50K', tipe: 'nominal', nilai: 50000, min: 200000, deskripsi: 'Potongan Langsung Rp 50.000', aktif: true },
      { kode: 'PROMOAWAL', tipe: 'persen', nilai: 15, min: 150000, deskripsi: 'Diskon 15% Eksklusif Wisatawan Baru', aktif: true }
    ];

    function isMasterPromoAktif() {
      let val = localStorage.getItem('kamawak_promo_master_aktif');
      if (val === null || val === undefined) return true;
      return val === 'true';
    }

    function getDaftarPromoTersedia() {
      let raw = localStorage.getItem('kamawak_promo_codes');
      if (raw === null || raw === undefined) {
        localStorage.setItem('kamawak_promo_codes', JSON.stringify(DEFAULT_PROMO_CODES));
        return DEFAULT_PROMO_CODES;
      }
      try {
        let list = JSON.parse(raw);
        if (!Array.isArray(list)) return [];
        return list;
      } catch(e) {
        return [];
      }
    }

    function renderKuponCepat() {
      const box = document.getElementById('pdpPromoBox');
      const container = document.getElementById('containerKuponCepat');
      if (!container) return;

      const masterAktif = isMasterPromoAktif();
      if (!masterAktif) {
        if (box) box.style.display = 'none';
        return;
      }
      if (box) box.style.display = 'block';

      const daftar = getDaftarPromoTersedia();
      const aktifList = daftar.filter(p => p.aktif !== false);

      if (aktifList.length === 0) {
        container.style.display = 'none';
        container.innerHTML = '';
        return;
      }

      container.style.display = 'flex';
      let html = '<span style="font-size: 11px; color: var(--text-gray);">Kupon Cepat:</span>';
      aktifList.forEach(p => {
        const valStr = p.tipe === 'persen' ? `${p.nilai}%` : `-${Math.round(p.nilai/1000)}rb`;
        html += `<span class="promo-chip" onclick="isiKuponCepat('${p.kode}')" style="background: #FFF7ED; color: #EA580C; border: 1px dashed #FDBA74; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; cursor: pointer;">${p.kode} (${valStr})</span>`;
      });
      container.innerHTML = html;
    }

    // Inisialisasi sinkronisasi cloud promo untuk PDP
    function initSyncPromoPdp() {
      renderKuponCepat();
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run.withSuccessHandler(function(config) {
          if (!config) return;
          if (config.VOUCHER_PROMO) {
            let strVal = typeof config.VOUCHER_PROMO === 'string' ? config.VOUCHER_PROMO : JSON.stringify(config.VOUCHER_PROMO);
            localStorage.setItem("kamawak_promo_codes", strVal);
          }
          if (config.FITUR_VOUCHER_AKTIF !== undefined) {
            localStorage.setItem("kamawak_promo_master_aktif", String(config.FITUR_VOUCHER_AKTIF));
          }
          renderKuponCepat();
        }).getPengaturan();
      }
    }
    initSyncPromoPdp();

    function terapkanKodePromo() {
      const inputEl = document.getElementById('inputKodePromo');
      const alertEl = document.getElementById('promoAlert');
      const badgeActive = document.getElementById('promoBadgeActive');
      const btnApply = document.getElementById('btnApplyPromo');
      const btnRemove = document.getElementById('btnRemovePromo');

      if (!inputEl) return;
      const kodeInput = inputEl.value.trim().toUpperCase();

      if (!kodeInput) {
        if (alertEl) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#DC2626';
          alertEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Silakan ketik kode promo terlebih dahulu.';
        }
        return;
      }

      if (!isMasterPromoAktif()) {
        if (alertEl) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#DC2626';
          alertEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Fitur kupon promo saat ini sedang dinonaktifkan.';
        }
        return;
      }

      let hargaPerOrang = hargaDasar + (paketAktif === 'vip' ? tambahanVIP : 0) + hargaTambahanPaket;
      let subtotal = hargaPerOrang * jumlahPax;

      const daftarPromo = getDaftarPromoTersedia();
      const promoDitemukan = daftarPromo.find(p => p.kode.toUpperCase() === kodeInput);

      if (!promoDitemukan) {
        if (alertEl) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#DC2626';
          alertEl.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Kode voucher <strong>"${kodeInput}"</strong> tidak valid atau tidak ditemukan.`;
        }
        return;
      }

      if (promoDitemukan.aktif === false) {
        if (alertEl) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#DC2626';
          alertEl.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Kupon <strong>"${kodeInput}"</strong> saat ini sedang dinonaktifkan oleh pengelola.`;
        }
        return;
      }

      if (subtotal < (promoDitemukan.min || 0)) {
        if (alertEl) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#D97706';
          alertEl.innerHTML = `<i class="fa-solid fa-circle-info"></i> Kupon ini memerlukan minimal transaksi ${formatUang(promoDitemukan.min)}. (Subtotal Anda: ${formatUang(subtotal)})`;
        }
        return;
      }

      promoAktif = promoDitemukan;
      inputEl.disabled = true;
      inputEl.value = promoDitemukan.kode;

      if (btnApply) btnApply.style.display = 'none';
      if (btnRemove) btnRemove.style.display = 'inline-block';
      if (badgeActive) badgeActive.style.display = 'inline-block';

      const kodeNamaEl = document.getElementById('uiKodePromoNama');
      if (kodeNamaEl) kodeNamaEl.innerText = promoDitemukan.kode;

      hitungTotal();

      const hematStr = promoDitemukan.tipe === 'persen' ? `${promoDitemukan.nilai}%` : formatUang(promoDitemukan.nilai);
      if (alertEl) {
        alertEl.style.display = 'block';
        alertEl.style.color = '#059669';
        alertEl.innerHTML = `<i class="fa-solid fa-circle-check"></i> Kupon <strong>${promoDitemukan.kode}</strong> berhasil dipasang! Hemat ${hematStr}.`;
      }

      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: `Kupon ${promoDitemukan.kode} Terpasang! Hemat ${hematStr}`,
        showConfirmButton: false,
        timer: 2000
      });
    }

    function hapusKodePromo(silent = false) {
      promoAktif = null;
      nominalDiskonPromo = 0;

      const inputEl = document.getElementById('inputKodePromo');
      const alertEl = document.getElementById('promoAlert');
      const badgeActive = document.getElementById('promoBadgeActive');
      const btnApply = document.getElementById('btnApplyPromo');
      const btnRemove = document.getElementById('btnRemovePromo');

      if (inputEl) {
        inputEl.disabled = false;
        if (!silent) inputEl.value = '';
      }
      if (btnApply) btnApply.style.display = 'inline-block';
      if (btnRemove) btnRemove.style.display = 'none';
      if (badgeActive) badgeActive.style.display = 'none';

      if (alertEl) {
        if (silent) {
          alertEl.style.display = 'block';
          alertEl.style.color = '#D97706';
          alertEl.innerHTML = '<i class="fa-solid fa-circle-info"></i> Kupon promo dilepas karena subtotal tidak lagi mencukupi batas minimum.';
        } else {
          alertEl.style.display = 'none';
        }
      }

      hitungTotal();

      if (!silent) {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'info',
          title: 'Kupon promo dibatalkan',
          showConfirmButton: false,
          timer: 1500
        });
      }
    }

    window.terapkanKodePromo = terapkanKodePromo;
    window.hapusKodePromo = hapusKodePromo;
    window.isiKuponCepat = function(kode) {
      const el = document.getElementById('inputKodePromo');
      if (el) {
        el.value = kode;
        terapkanKodePromo();
      }
    };
  </script>
</body>
</html>