    function jalankanCarouselIklan(totalAds) {
      let minThreshold = window.innerWidth < 640 ? 1 : (window.innerWidth < 900 ? 2 : 3);
      if (totalAds <= minThreshold) return;
      let track = document.getElementById('adCarouselTrack');
      if (!track || !track.children || track.children.length === 0) return;
      let currentShift = 0;
      
      setInterval(() => {
         currentShift++;
         let itemWidth = (track.children[0] ? track.children[0].offsetWidth : 280) + 16;
         let visibleCount = window.innerWidth < 640 ? 1 : (window.innerWidth < 900 ? 2 : 3);
         if (currentShift > totalAds - visibleCount) {
            currentShift = 0;
            track.style.transition = 'none';
            track.style.transform = `translateX(0px)`;
            setTimeout(() => { track.style.transition = 'transform 0.5s ease'; }, 50);
         } else {
            track.style.transform = `translateX(-${currentShift * itemWidth}px)`;
         }
      }, 4000);
    }



    function muatKoleksiTag() {
      try {
        let c = document.getElementById('tagScrollContainer');
        if (!c) return;
        let list = [];
        try {
          let saved = localStorage.getItem("kamawak_kartu_kota");
          if (saved) {
            let parsed = JSON.parse(saved);
            if (Array.isArray(parsed)) {
              list = parsed.filter(item => item && typeof item === 'object');
            }
          }
        } catch(e) {}

        if (!Array.isArray(list) || list.length === 0) {
          list = Array.isArray(DAFTAR_KOTA_DEFAULT) ? [...DAFTAR_KOTA_DEFAULT] : [];
        }

        // Sanitasi elemen: pastikan tiap item adalah object valid dengan minimal nama
        list = list.filter(k => k && typeof k === 'object' && k.status !== 'Nonaktif').map(k => {
          return {
            nama: k.nama || k.label || 'Destinasi',
            label: k.label || k.nama || 'Destinasi',
            subtag: k.subtag || '',
            img: k.img || k.foto || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=400',
            status: k.status || 'Aktif'
          };
        });

        // Jika memori lokal belum memiliki Alahan Panjang, tambahkan otomatis
        let hasAlahan = list.some(k => String(k.nama || '').toLowerCase().includes('alahan panjang'));
        if (!hasAlahan) {
          list.splice(1, 0, { nama: "Alahan Panjang", label: "Alahan Panjang", subtag: "Danau Diatas & Cabin Dingin", img: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=400&auto=format&fit=crop", status: "Aktif" });
        }
        let hasSolok = list.some(k => String(k.nama || '').toLowerCase().includes('solok'));
        if (!hasSolok) {
          list.splice(2, 0, { nama: "Solok", label: "Solok", subtag: "Danau Kembar & Pesona Alam", img: "https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=400&auto=format&fit=crop", status: "Aktif" });
        }

        // Pastikan 'Semua' ada di paling depan
        let semuaIdx = list.findIndex(k => {
          let n = String(k.nama || '').toLowerCase();
          return n === 'semua' || n === 'semua kota' || n === 'semua destinasi';
        });
        if (semuaIdx > 0) {
          let semuaItem = list.splice(semuaIdx, 1)[0];
          list.unshift(semuaItem);
        }

        let safeMaster = Array.isArray(dataMaster) ? dataMaster : [];

        let html = list.map((k, idx) => {
          let count = 0;
          let nClean = String(k.nama || '').toLowerCase();
          let isSemua = nClean === 'semua' || nClean === 'semua kota' || nClean === 'semua destinasi';

          if (safeMaster.length > 0) {
            if (isSemua) {
              count = safeMaster.length;
            } else {
              count = safeMaster.filter(item => {
                if (!item) return false;
                let lok = [
                  item.destinasi || '',
                  item.lokasi || '',
                  item.nama || '',
                  item.tags || ''
                ].join(' ').toLowerCase();
                return lok.includes(nClean);
              }).length;
            }
          }

          let badgeHtml = '';
          if (isSemua) {
            badgeHtml = `<span class="city-badge"><i class="fa-solid fa-layer-group"></i> ${count > 0 ? count : safeMaster.length} Destinasi</span>`;
          } else if (count > 0) {
            badgeHtml = `<span class="city-badge"><i class="fa-solid fa-camera"></i> ${count} Tempat</span>`;
          } else {
            badgeHtml = `<span class="city-badge city-badge-soon"><i class="fa-solid fa-hourglass-start"></i> Segera</span>`;
          }

          return `
            <div class="city-card ${idx === 0 ? 'city-active' : ''}" onclick="filterKota('${k.nama}', this)" title="Lihat wisata di ${k.label || k.nama}">
              <img src="${k.img || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=400'}" alt="${k.label || k.nama}" onerror="this.src='https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=400'">
              ${badgeHtml}
              <div class="city-overlay">
                <span class="city-name">${k.label || k.nama}</span>
              </div>
            </div>
          `;
        }).join('');

        c.innerHTML = html;
      } catch (err) {
        console.error("Gagal memuat kartu kota:", err);
      }
    }

    window.filterKota = function(namaKota, el) {
      document.querySelectorAll('.city-card').forEach(c => {
        c.style.outline = 'none';
        c.classList.remove('city-active');
      });
      if (el) {
        el.style.outline = '3px solid var(--primary)';
        el.style.outlineOffset = '2px';
        el.classList.add('city-active');
      }

      let searchInput = document.getElementById('searchInput');
      let namaLower = (namaKota || '').trim().toLowerCase();
      if (namaLower === 'semua' || namaLower === 'semua kota' || namaLower === 'semua destinasi' || !namaLower) {
        if (searchInput) searchInput.value = '';
      } else {
        if (searchInput) searchInput.value = namaKota.trim();
      }

      if (window.terapkanFilterDanUrutan) {
        window.terapkanFilterDanUrutan();
      }

      let area = document.getElementById('areaKatalog') || document.querySelector('.controls-wrapper');
      if (area) {
        window.scrollTo({ top: area.offsetTop - 120, behavior: 'smooth' });
      }
    };
    window.panggilDataServer = async function() {
      tampilkanSkeleton();
      try {
        let query = supabase.from('wisata').select('*').order('created_at', { ascending: false });
        const { data: wisataData, error: wisataErr } = await query;
        if (wisataErr) {
          console.warn("Supabase query error:", wisataErr);
        }
        
        let rawData = wisataData || [];
        let deletedList = [];
        try { deletedList = JSON.parse(localStorage.getItem('kamawak_deleted_wisata') || '[]'); } catch(e){}
        let filteredWisata = rawData.filter(item => !deletedList.includes(item.id));

        // Gabungkan juga produk lokal baru jika ada yang baru ditambahkan
        try {
          for (let i = 0; i < localStorage.length; i++) {
            let key = localStorage.key(i);
            if (key && key.startsWith('kamawak_override_local_')) {
              let localItem = JSON.parse(localStorage.getItem(key));
              if (localItem && !deletedList.includes(localItem.id) && !filteredWisata.some(d => d.id === localItem.id)) {
                filteredWisata.unshift(localItem);
              }
            }
          }
        } catch(e) {}

        dataMaster = filteredWisata.map(item => {
          try {
            let localMeta = JSON.parse(localStorage.getItem('kamawak_override_' + item.id) || localStorage.getItem('kamawak_meta_' + item.id) || 'null');
            if (localMeta) {
              Object.keys(localMeta).forEach(k => {
                if (localMeta[k] !== undefined && localMeta[k] !== null && localMeta[k] !== '') {
                  item[k] = localMeta[k];
                }
              });
            }
          } catch(e) {}
          return item;
        }).filter(item => item.status !== 'Nonaktif');

        muatKoleksiTag();
        muatFasilitasTrustHome();
        renderSeksiPopuler();

        if (typeof window.terapkanFilterDanUrutan === 'function') {
          window.terapkanFilterDanUrutan();
        }
      } catch(e) {
        console.error("API Error:", e);
        let pGrid = document.getElementById('productGrid');
        if (pGrid) pGrid.innerHTML = '<p style="color:red;text-align:center;">Kesalahan API: ' + (e ? e.message : 'Unknown') + '</p>';
      }
    };
    window.handleEnter = function(e) {
      if (e.key === 'Enter') {
        if (window.terapkanFilterDanUrutan) window.terapkanFilterDanUrutan();
        let a = document.getElementById('areaKatalog');
        if (a) window.scrollTo({ top: a.offsetTop - 110, behavior: 'smooth' });
      }
    }

