  <script>
    import { supabase } from '../lib/supabase.js';

    const BASE_URL = "";
    let dataMaster = []; let layoutMaster = []; 
    let kategoriAktif = 'Semua';

    window.onload = function() {
      if (typeof window.updateNavbarLogo === 'function') window.updateNavbarLogo();
      cekStatusLogin(); // <--- Fungsi Pintar Navigasi Dipanggil Disini
      updateWishlistBadge();
