      function renderSemuaIklan(realAds) {
        let track = document.getElementById('adCarouselTrack');
        let container = document.getElementById('adCarouselContainer');
        if (!track || !container) return;

        let sliderHtml = "";
        let count = 0;

        // Render iklan nyata jika ada
        (realAds || []).forEach((ad) => {
          let link = ad.id_iklan || ad.target_id || "";
          if (typeof google !== 'undefined' && google.script && google.script.run && ad.baris) {
            try { google.script.run.catatMetrikIklan(ad.baris, 'impresi'); } catch(e){}
          }
          sliderHtml += `<div class="ad-card" onclick="klikIklanServer(${ad.baris || 0}, '${link}')" title="${ad.nama}"><img src="${ad.foto}" alt="${ad.nama}"></div>`;
          count++;
        });

        // Isi seluruh slot yang kosong dengan banner "Pasang Iklan di Sini"
        let neededPlaceholders = (count === 0) ? 4 : Math.max(4 - count, 0);
        for (let i = 0; i < neededPlaceholders; i++) {
          let b = placeholderBanners[i % placeholderBanners.length];
          sliderHtml += buildPlaceholderCard(b);
          count++;
        }

        container.style.display = "block";
        track.innerHTML = sliderHtml;
        jalankanCarouselIklan(count);
