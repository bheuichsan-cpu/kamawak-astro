    // ==========================================
    // FUNGSI BARU: CEK SESI LOGIN DI HALAMAN UTAMA
    // ==========================================
    function cekStatusLogin() {
      let user = localStorage.getItem("kamawak_user");
      let role = localStorage.getItem("kamawak_role");
      let nav = document.getElementById("navMenu");
      
      // Jika pengguna terdeteksi sedang login
      if(user && role) {
        let isWisatawan = role.toLowerCase().includes("wisatawan");
        let namaPendek = user.split(" ")[0]; // Ambil nama panggilan saja
        
        let htmlSapaanAtauDasbor = "";
        
        if(!isWisatawan) {
          // Jika ia Mitra/Admin, beri tombol masuk Dasbor
          let target = role.toLowerCase().includes("admin") ? "admin" : "owner";
          let urlDasbor = "/" + target;
          let btnIcon = role.toLowerCase().includes("admin") ? '<i class="fa-solid fa-gauge-high"></i> <span>Dasbor Admin</span>' : '<i class="fa-solid fa-plane"></i> <span>Dasbor Mitra</span>';
          htmlSapaanAtauDasbor = `\x3Cbutton onclick="window.open('${urlDasbor}', '_top')" class="btn-login-nav" style="background: var(--text-dark); color: white; border:none; cursor:pointer; margin-right: 8px;">${btnIcon}\x3C/button>`;
        } else {
          // Jika ia Wisatawan, beri tombol ke Profil
          let urlProfil = "/profil";
          htmlSapaanAtauDasbor = `\x3Cbutton onclick="window.open('${urlProfil}', '_top')" class="btn-login-nav" style="background: var(--primary); color: white; border:none; cursor:pointer; margin-right: 8px;">\x3Ci class="fa-solid fa-user-circle">\x3C/i> <span>Profil & Pesanan</span>\x3C/button>`;
        }
        
        // Ganti isi Navbar menjadi Sapaan/Dasbor + Tombol Keluar Merah
        nav.innerHTML = htmlSapaanAtauDasbor + `\x3Cbutton onclick="logoutDariDepan()" class="btn-login-nav" style="background: #FEE2E2; color: #DC2626; border: none; cursor: pointer; box-shadow: none;">\x3Ci class="fa-solid fa-right-from-bracket">\x3C/i> <span>Keluar</span>\x3C/button>`;
      }
    }

    // Fungsi tombol Keluar dari Halaman Utama
    window.logoutDariDepan = function() {
      localStorage.clear();
      window.location.href = '/'; // Memuat ulang dan menghapus sesi
    }
    // ==========================================
    
    function tampilkanSkeleton() {
      let grid = document.getElementById('productGrid');
      let skeletonHtml = Array(8).fill(`<div class="skeleton-card"><div class="skeleton-img"></div><div class="skeleton-text"></div><div class="skeleton-text short"></div></div>`).join('');
      grid.innerHTML = skeletonHtml;
    }

    function jalankanSliderHero() {
      let b1 = localStorage.getItem("kamawak_hero_1");
      let b2 = localStorage.getItem("kamawak_hero_2");
      let b3 = localStorage.getItem("kamawak_hero_3");
      const slides = document.querySelectorAll('#heroSlider .slide');
      if (b1 && slides[0]) slides[0].src = b1;
      if (b2 && slides[1]) slides[1].src = b2;
      if (b3 && slides[2]) slides[2].src = b3;

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run.withSuccessHandler(function(config) {
          if (!config) return;
          if (config.HERO_BANNER_1 && slides[0]) { slides[0].src = config.HERO_BANNER_1; localStorage.setItem("kamawak_hero_1", config.HERO_BANNER_1); }
          if (config.HERO_BANNER_2 && slides[1]) { slides[1].src = config.HERO_BANNER_2; localStorage.setItem("kamawak_hero_2", config.HERO_BANNER_2); }
          if (config.HERO_BANNER_3 && slides[2]) { slides[2].src = config.HERO_BANNER_3; localStorage.setItem("kamawak_hero_3", config.HERO_BANNER_3); }
          
          if (config.PROFIL_LOGO) {
            localStorage.setItem("kamawak_prof_logo", config.PROFIL_LOGO);
          }
          if (config.PROFIL_NAMA_USAHA) {
            localStorage.setItem("kamawak_prof_nama", config.PROFIL_NAMA_USAHA);
          }
          if (typeof window.updateNavbarLogo === 'function') {
            window.updateNavbarLogo();
          }

          if (config.KARTU_KOTA) {
            let strVal = typeof config.KARTU_KOTA === 'string' ? config.KARTU_KOTA : JSON.stringify(config.KARTU_KOTA);
            localStorage.setItem("kamawak_kartu_kota", strVal);
            muatKoleksiTag();
          }

          if (config.VOUCHER_PROMO) {
            let strVal = typeof config.VOUCHER_PROMO === 'string' ? config.VOUCHER_PROMO : JSON.stringify(config.VOUCHER_PROMO);
            localStorage.setItem("kamawak_promo_codes", strVal);
          }
          if (config.FITUR_VOUCHER_AKTIF !== undefined) {
            localStorage.setItem("kamawak_promo_master_aktif", String(config.FITUR_VOUCHER_AKTIF));
          }
          muatBannerPromoHome();

          if (config.PROFIL_NO_WA) {
            let cs = document.querySelector('.floating-cs');
            if(cs) cs.href = "https://wa.me/" + config.PROFIL_NO_WA + "?text=Halo%20Admin%20Kamawak,%20saya%20butuh%20bantuan.";
          }
        }).getPengaturan();
      }

      muatBannerPromoHome();

      let currentSlide = 0;
      if (slides.length > 1) {
        setInterval(() => {
          slides[currentSlide].classList.remove('active');
          currentSlide = (currentSlide + 1) % slides.length;
          slides[currentSlide].classList.add('active');
        }, 4000);
      }
    }

    window.klikIklanServer = function(baris, linkTujuan) {
      if (typeof google !== 'undefined' && google.script && google.script.run && baris) {
        google.script.run.catatMetrikIklan(baris, 'klik');
      }
      if (linkTujuan && (linkTujuan.startsWith('http') || linkTujuan.startsWith('www'))) {
          if(!linkTujuan.startsWith('http')) linkTujuan = 'https://' + linkTujuan;
          window.open(linkTujuan, '_blank');
      } else if (linkTujuan) {
          document.getElementById('searchInput').value = linkTujuan; 
          panggilDataServer();
          window.scrollTo({ top: document.getElementById('areaKatalog').offsetTop - 20, behavior: 'smooth' });
      }
    };

    function jalankanCarouselIklan(totalAds) {
      if (totalAds <= 3) return;
      let track = document.getElementById('adCarouselTrack');
      if (!track || !track.children || track.children.length === 0) return;
      let currentShift = 0;
      
      setInterval(() => {
         currentShift++;
         let itemWidth = (track.children[0] ? track.children[0].offsetWidth : 280) + 15;
         if (currentShift > totalAds - (window.innerWidth < 768 ? 2 : 3)) {
            currentShift = 0;
            track.style.transition = 'none';
            track.style.transform = `translateX(0px)`;
            setTimeout(() => { track.style.transition = 'transform 0.5s ease'; }, 50);
         } else {
            track.style.transform = `translateX(-${currentShift * itemWidth}px)`;
         }
      }, 3500);
    }

    const DAFTAR_KOTA_DEFAULT = [
      { nama: "Semua", label: "Semua Kota", subtag: "Seluruh Destinasi Sumbar", img: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Bukittinggi", label: "Bukittinggi", subtag: "Jam Gadang, Ngarai Sianok, Kuliner", img: "https://images.unsplash.com/photo-1596401057633-54a8fe8ef647?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Padang", label: "Kota Padang", subtag: "Pantai Padang, Kuliner Rendang, Kota Tua", img: "https://images.unsplash.com/photo-1596401057633-54a8fe8ef647?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Mandeh", label: "Pesisir Mandeh", subtag: "Kawasan Wisata Bahari & Pesisir", img: "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Harau", label: "Lembah Harau", subtag: "Tebing Granit & Homestay", img: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Mentawai", label: "Kep. Mentawai", subtag: "Surfing, Budaya Sikerei, Kepulauan", img: "https://images.unsplash.com/photo-1502680390469-be75c86b636f?q=80&w=400&auto=format&fit=crop", status: "Aktif" },
      { nama: "Pariaman", label: "Pariaman", subtag: "Pantai Gandoriah, Budaya Tabuik", img: "https://images.unsplash.com/photo-1533105079780-92b9be482077?q=80&w=400&auto=format&fit=crop", status: "Aktif" }
    ];

    function muatKoleksiTag() {
      let c = document.getElementById('tagScrollContainer');
      if (!c) return;
      let list = [];
      try {
        let saved = localStorage.getItem("kamawak_kartu_kota");
        if (saved) list = JSON.parse(saved);
      } catch(e) {}

      // Sanitasi cache browser jika masih menyimpan link foto pulau/lembah lama
      let updatedStorage = false;
      if (Array.isArray(list) && list.length > 0) {
        list = list.map(item => {
          if (item && item.img && (item.img.includes('1518509562904') || item.img.includes('1507525428034') || item.img.includes('1506744038136') || item.img.includes('1544551763'))) {
            item.img = 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=400&auto=format&fit=crop';
            updatedStorage = true;
          }
          return item;
        });
        if (updatedStorage) {
          localStorage.setItem("kamawak_kartu_kota", JSON.stringify(list));
        }
      }

      if (!list || list.length === 0) list = DAFTAR_KOTA_DEFAULT;
      list = list.filter(k => k.status !== 'Nonaktif');

      let html = list.map((k, idx) => {
        let count = 0;
        if (dataMaster && dataMaster.length > 0) {
          if (k.nama === 'Semua') {
            count = dataMaster.length;
          } else {
            let cityNameLower = (k.nama || '').toLowerCase();
            count = dataMaster.filter(item => {
              let lok = ((item.destinasi || '') + ' ' + (item.lokasi || '') + ' ' + (item.nama || '')).toLowerCase();
              return lok.includes(cityNameLower);
            }).length;
          }
        }
        let badgeHtml = count > 0 ? `<span class="city-badge">${count} tempat</span>` : '';
        return `
          <div class="city-card ${idx === 0 ? 'city-active' : ''}" onclick="filterKota('${k.nama}', this)" title="Lihat wisata di ${k.label || k.nama}">
            <img src="${k.img || k.foto || 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=400'}" alt="${k.label || k.nama}">
            ${badgeHtml}
            <div class="city-overlay">
              <span class="city-name">${k.label || k.nama}</span>
            </div>
          </div>
        `;
      }).join('');
      c.innerHTML = html;
    }

    window.filterKota = function(namaKota, el) {
      document.querySelectorAll('.city-card').forEach(c => {
        c.style.outline = 'none';
        c.classList.remove('city-active');
      });
      if (el) {
        el.style.outline = '3px solid var(--primary)';
        el.style.outlineOffset = '2px';
        el.classList.add('city-active');
      }

      let searchInput = document.getElementById('searchInput');
      if (namaKota === 'Semua' || !namaKota) {
        if (searchInput) searchInput.value = '';
      } else {
        if (searchInput) searchInput.value = namaKota;
      }

      if (window.terapkanFilterDanUrutan) {
        window.terapkanFilterDanUrutan();
      }

      let area = document.getElementById('areaKatalog') || document.querySelector('.controls-wrapper');
      if (area) {
        window.scrollTo({ top: area.offsetTop - 120, behavior: 'smooth' });
      }
    };
    window.panggilDataServer = function() {
      tampilkanSkeleton();
      muatIklanBanner();
    }
    window.handleEnter = function(e) {
      if (e.key === 'Enter') window.panggilDataServer();
    }

    function muatIklanBanner() {
      jalankanSliderHero(); // Jalankan hero banner statis

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(function(resString) {
            try {
              let res = typeof resString === 'string' ? JSON.parse(resString) : resString;
              if (res && res.success && res.data && res.data.length > 0) {
                let track = document.getElementById('adCarouselTrack');
                let container = document.getElementById('adCarouselContainer');
                let realAds = res.data.filter(ad => ad.nama !== 'Promo Default').slice(0, 6);
                let adsToShow = realAds.length > 0 ? realAds : res.data;
                let sliderHtml = "";
                adsToShow.forEach((ad) => {
                  let link = ad.id_iklan || ad.target_id || "";
                  if (typeof google !== 'undefined' && google.script && google.script.run && ad.baris) {
                    google.script.run.catatMetrikIklan(ad.baris, 'impresi');
                  }
                  sliderHtml += `<div class="ad-card" onclick="klikIklanServer(${ad.baris || 0}, '${link}')"><img src="${ad.foto}" alt="${ad.nama}"></div>`;
                });
                if (sliderHtml !== "" && track && container) {
                    container.style.display = "block";
                    track.innerHTML = sliderHtml;
                    jalankanCarouselIklan(adsToShow.length);
                }
              }
            } catch(e) {}
          }).getAdsData();
      } else {
        let local = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
        let aktifAds = local.filter(x => String(x.status).toLowerCase() === 'aktif');
        if (aktifAds.length > 0) {
          let track = document.getElementById('adCarouselTrack');
          let container = document.getElementById('adCarouselContainer');
          let sliderHtml = "";
          aktifAds.forEach(ad => {
            let link = ad.target_id || "";
            sliderHtml += `<div class="ad-card" onclick="klikIklanServer(${ad.baris || 0}, '${link}')"><img src="${ad.foto}" alt="${ad.nama}"></div>`;
          });
          if (sliderHtml !== "" && track && container) {
            container.style.display = "block";
            track.innerHTML = sliderHtml;
            jalankanCarouselIklan(aktifAds.length);
          }
        }
      }

      (async () => {
        try {
          // Fetch wisata data
          let keywordEl = document.getElementById('searchInput');
          let keyword = keywordEl ? keywordEl.value.toLowerCase().trim() : '';
          
          let query = supabase.from('wisata').select('*'); // Removed eq status to prevent crash if column missing
          // if (keyword && keyword !== '') {
          //    query = query.or(`nama.ilike.%${keyword}%,destinasi.ilike.%${keyword}%,lokasi.ilike.%${keyword}%,penanda.ilike.%${keyword}%`);
          // }
          const { data: wisataData, error: wisataErr } = await query;
          // Ignore error to let skeleton disappear smoothly if table doesn't exist
          
          // MOCK layout for now or fetch from a layouts table if it exists
          let layoutMaster = []; 
          
          dataMaster = wisataData || [];
          muatKoleksiTag();
          if (layoutMaster.length > 0) {
             document.getElementById('sectionPopuler').style.display = "none";
          } else {
             document.getElementById('sectionPopuler').style.display = "block";
             renderSeksiPopuler();
          }
          if (typeof window.terapkanFilterDanUrutan === 'function') {
            window.terapkanFilterDanUrutan();
          }
        } catch(e) {
          console.error("API Error:", e);
          document.getElementById('productGrid').innerHTML = '<p style="color:red;text-align:center;">Kesalahan API: ' + e.message + '</p>';
        }
      })();
 
    }

    function renderSeksiPopuler() {
      let container = document.getElementById('popularGrid'); let section = document.getElementById('sectionPopuler');
      let dataPopuler = [...dataMaster].sort((a, b) => Number(b.rating || 0) - Number(a.rating || 0)).slice(0, 5);
      if(dataPopuler.length > 0) { section.style.display = "block"; container.innerHTML = generateCardsHTML(dataPopuler, true); } else { section.style.display = "none"; }
    }

    function renderDynamicSections(layoutConfig) {
      let container = document.getElementById('dynamicSectionsContainer');
      if (!container) return;
      container.innerHTML = "";
      
      let keyword = document.getElementById('searchInput').value.toLowerCase().trim();
      let tipeHarga = document.getElementById('priceSelect').value;

      layoutConfig.forEach((section, index) => {
        if (section.status !== 'Aktif') return;
        
        // 1. Filter awal berdasarkan rule dari admin (Tipe & Nilai)
        let filteredData = [];
        let tipe = section.tipe;
        let nilai = section.nilai;
        if (tipe === 'Kategori') {
           filteredData = dataMaster.filter(item => String(item.kategori || '').toLowerCase() === String(nilai || '').toLowerCase());
        } else if (tipe === 'Lokasi') {
           filteredData = dataMaster.filter(item => String(item.lokasi || '').toLowerCase().includes(String(nilai || '').toLowerCase()));
        } else if (tipe === 'Tag') {
           filteredData = dataMaster.filter(item => String(item.penanda || item.tags || '').toLowerCase().includes(String(nilai || '').toLowerCase()));
        } else if (tipe === 'Otomatis' && String(nilai || '').toLowerCase() === 'populer') {
           filteredData = [...dataMaster];
        } else if (tipe === 'Iklan') {
           return;
        }

        // 2. Filter lanjutan menyesuaikan dengan Pintasan/Keyword yang sedang dipilih pengguna
        filteredData = filteredData.filter(item => {
           let hrg = Number(item.harga || item.hargaJual || 0);
           let mHarga = (tipeHarga === 'under500') ? (hrg > 0 && hrg < 500000) : (tipeHarga === '500to1m') ? (hrg >= 500000 && hrg <= 1000000) : (tipeHarga === 'above1m') ? (hrg > 1000000) : true;
           
           let strKat = item.kategori ? String(item.kategori).toLowerCase() : "";
           let mKat = true;
           if(kategoriAktif !== 'Semua') {
              if(kategoriAktif === 'Atraksi') { mKat = strKat.includes('atraksi') || strKat.includes('tiket'); }
              else { mKat = strKat.includes(kategoriAktif.toLowerCase()); }
           }
           
           let teksUtama = (item.nama + " " + (item.destinasi || item.lokasi || "") + " " + (item.penanda || "")).toLowerCase();
           let mKeyword = (keyword === "") ? true : teksUtama.includes(keyword);

           return mKat && mHarga && mKeyword;
        });
        
        // 3. Urutkan berdasarkan rating
        filteredData.sort((a, b) => Number(b.rating || 0) - Number(a.rating || 0));
        
        if (filteredData.length > 0) {
           let sectionId = "dyn-section-" + index;
           let html = `
             \x3Cdiv class="container" style="margin-top: 20px;">
               \x3Ch2 class="section-title">${section.judul || "Koleksi Khusus"}\x3C/h2>
               \x3Cdiv class="popular-scroll" id="${sectionId}">
                 ${generateCardsHTML(filteredData.slice(0, 8), true)}
               \x3C/div>
             \x3C/div>
           `;
           container.innerHTML += html;
        }
      });
    }

    window.terapkanFilterDanUrutan = function() {
      if(typeof renderDynamicSections === 'function') {
        renderDynamicSections(layoutMaster);
      }
      let grid = document.getElementById('productGrid');
      if (grid) {
        let keyword = document.getElementById('searchInput') ? document.getElementById('searchInput').value.toLowerCase().trim() : '';
        let tipeHarga = document.getElementById('priceSelect') ? document.getElementById('priceSelect').value : 'semua';
        let tipeUrut = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'relevan';
        let wishlist = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');

        let smartBudget = document.getElementById('smartBudgetSelect');
        if (smartBudget && document.getElementById('priceSelect')) {
          smartBudget.value = document.getElementById('priceSelect').value;
        }
        let smartCat = document.getElementById('smartCategorySelect');
        if (smartCat && smartCat.value !== kategoriAktif) {
          smartCat.value = kategoriAktif;
        }

        let filtered = dataMaster.filter(item => {
           let hrg = Number(item.harga || item.hargaJual || 0);
           let mHarga = (tipeHarga === 'under500') ? (hrg > 0 && hrg < 500000) : (tipeHarga === '500to1m') ? (hrg >= 500000 && hrg <= 1000000) : (tipeHarga === 'above1m') ? (hrg > 1000000) : true;

           let strKat = item.kategori ? String(item.kategori).toLowerCase() : "";
           let mKat = true;
           if (kategoriAktif === 'Favorit') {
             mKat = wishlist.includes(String(item.id));
           } else if (kategoriAktif !== 'Semua') {
             mKat = (kategoriAktif === 'Atraksi') ? (strKat.includes('atraksi') || strKat.includes('tiket')) : strKat.includes(kategoriAktif.toLowerCase());
           }

           let teksUtama = (item.nama + " " + (item.destinasi || item.lokasi || "") + " " + (item.penanda || "")).toLowerCase();
           let mKeyword = (keyword === "") ? true : teksUtama.includes(keyword);
           return mKat && mHarga && mKeyword;
        });

        // Pengurutan
        if (tipeUrut === 'termurah') {
          filtered.sort((a, b) => Number(a.harga || a.hargaJual || 0) - Number(b.harga || b.hargaJual || 0));
        } else if (tipeUrut === 'termahal') {
          filtered.sort((a, b) => Number(b.harga || b.hargaJual || 0) - Number(a.harga || a.hargaJual || 0));
        } else if (tipeUrut === 'rating') {
          filtered.sort((a, b) => Number(b.rating || 0) - Number(a.rating || 0));
        }

        if (filtered.length > 0) {
          grid.innerHTML = generateCardsHTML(filtered, false);
        } else {
          if (kategoriAktif === 'Favorit') {
            grid.innerHTML = `
              <div style="text-align:center; width:100%; color:var(--text-gray); grid-column:1/-1; padding:45px 20px;">
                <i class="fa-regular fa-heart" style="font-size: 38px; color:#F87171; margin-bottom: 12px; display:block;"></i>
                <h3 style="font-family:'Poppins'; font-size:17px; color:var(--text-dark); margin-bottom:6px;">Belum Ada Destinasi Favorit</h3>
                <p style="font-size:13px; max-width:400px; margin:0 auto; color:var(--text-gray);">Klik ikon hati ❤️ pada paket wisata pilihan Anda untuk menyimpannya ke daftar wishlist ini.</p>
              </div>
            `;
          } else {
            grid.innerHTML = '<div style="text-align:center; width:100%; color:var(--text-gray); grid-column:1/-1; padding:35px 20px;">Destinasi atau paket tidak ditemukan.</div>';
          }
        }
      }
    }

    function generateCardsHTML(data, isPopular) {
      if(!data || data.length === 0) return '';
      let wishlist = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');
      return data.map(item => {
        let hargaNum = Number(item.harga || item.hargaJual || 0);
        let harga = hargaNum.toLocaleString('id-ID');
        let fotoRaw = (item.foto || '').trim();
        let foto = 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=500';
        if (fotoRaw) {
          if (fotoRaw.includes('|||')) {
            foto = fotoRaw.split('|||')[0].trim();
          } else if (fotoRaw.startsWith('[') && fotoRaw.endsWith(']')) {
            try { foto = JSON.parse(fotoRaw)[0] || foto; } catch(e) {}
          } else if (fotoRaw.startsWith('data:image/') && fotoRaw.includes(',') && fotoRaw.split(',')[1].length > 20) {
            foto = fotoRaw.split(/,\s*(?=https?:\/\/|data:image\/)/i)[0].trim();
          } else if (fotoRaw.startsWith('http://') || fotoRaw.startsWith('https://')) {
            foto = fotoRaw.split(/,\s*(?=https?:\/\/|data:image\/)/i)[0].trim();
          } else if (fotoRaw.length > 100 && /^[A-Za-z0-9+/=]+$/.test(fotoRaw.substring(0, 50))) {
            foto = 'data:image/jpeg;base64,' + fotoRaw;
          }
        }
        let isFav = wishlist.includes(String(item.id));
        let heartIcon = isFav ? 'fa-solid' : 'fa-regular';
        let favActiveClass = isFav ? 'active' : '';
        let lokasi = item.destinasi || item.lokasi || 'Sumatera Barat';
        let rating = Number(item.rating || 5.0).toFixed(1);

        // Diskon & Harga Coret
        let coretNum = Number(item.harga_coret || 0);
        let diskonBadgeHtml = '';
        let coretPriceHtml = '';
        if (coretNum > hargaNum && hargaNum > 0) {
          let persenHemat = Math.round(((coretNum - hargaNum) / coretNum) * 100);
          if (persenHemat > 0) {
            diskonBadgeHtml = `<span class="card-discount-badge"><i class="fa-solid fa-tag"></i> Hemat ${persenHemat}%</span>`;
            coretPriceHtml = `<span class="card-price-coret">Rp ${coretNum.toLocaleString('id-ID')}</span>`;
          }
        }

        // Quick Amenity Pills
        let katLower = String(item.kategori || '').toLowerCase();
        let amenities = [];
        if (katLower.includes('penginapan') || katLower.includes('hotel') || katLower.includes('homestay')) {
          amenities = ['<i class="fa-solid fa-wifi"></i> WiFi', '<i class="fa-solid fa-snowflake"></i> AC', '<i class="fa-solid fa-utensils"></i> Sarapan'];
        } else if (katLower.includes('tur') || katLower.includes('paket')) {
          amenities = ['<i class="fa-solid fa-user-check"></i> Guide', '<i class="fa-solid fa-van-shuttle"></i> Transport', '<i class="fa-solid fa-ticket"></i> Tiket'];
        } else if (katLower.includes('atraksi') || katLower.includes('tiket')) {
          amenities = ['<i class="fa-solid fa-ticket"></i> Tiket Masuk', '<i class="fa-solid fa-bolt"></i> Bebas Antre'];
        } else if (katLower.includes('rental') || katLower.includes('mobil') || katLower.includes('motor')) {
          amenities = ['<i class="fa-solid fa-car"></i> Unit Bersih', '<i class="fa-solid fa-id-card"></i> Sopir/Lepas Kunci'];
        } else if (katLower.includes('kuliner')) {
          amenities = ['<i class="fa-solid fa-certificate"></i> 100% Halal', '<i class="fa-solid fa-chair"></i> Dine-in'];
        } else {
          amenities = ['<i class="fa-solid fa-circle-check"></i> Terverifikasi', '<i class="fa-solid fa-star"></i> Pilihan Favorit'];
        }
        let amenitiesHtml = `<div class="card-amenities">${amenities.map(a => `<span class="amenity-tag">${a}</span>`).join('')}</div>`;

        return `
          <a href="/pdp?id=${item.id || ''}" class="card card-clickable ${isPopular ? 'popular-card' : ''}">
            <div class="card-img-wrapper">
              <img src="${foto}" class="card-img" alt="${item.nama || ''}" onerror="this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=500'">
              ${diskonBadgeHtml}
              <button class="btn-wishlist-card ${favActiveClass}" onclick="toggleWishlistCard(event, '${item.id}')" title="${isFav ? 'Hapus dari Favorit' : 'Simpan ke Favorit'}">
                <i class="${heartIcon} fa-heart"></i>
              </button>
              <div class="card-dots">
                <span class="dot active"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            </div>
            <div class="card-content">
              <div class="card-location"><i class="fa-solid fa-location-dot"></i> ${lokasi}</div>
              <h3 class="card-title">${item.nama || 'Tanpa Nama'} <i class="fa-solid fa-circle-check text-verified" title="Mitra Terverifikasi Kamawak"></i></h3>
              ${amenitiesHtml}
              <div class="card-price-row">
                <div>
                  <span class="card-price-label">Mulai dari</span>
                  ${coretPriceHtml}
                  <span class="card-price">Rp ${harga}</span>
                </div>
                <div class="card-rating"><i class="fa-solid fa-star" style="color:#F59E0B;"></i> ${rating}</div>
              </div>
            </div>
          </a>
        `;
      }).join('');
    }

    window.toggleWishlistCard = function(event, id) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      let strId = String(id);
      let list = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');
      let idx = list.indexOf(strId);
      let btn = event ? event.currentTarget : null;

      if (idx > -1) {
        list.splice(idx, 1);
        if (btn) {
          btn.classList.remove('active');
          let icon = btn.querySelector('i');
          if (icon) icon.className = 'fa-regular fa-heart';
        }
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'info',
          title: 'Dihapus dari Favorit',
          showConfirmButton: false,
          timer: 1200
        });
      } else {
        list.push(strId);
        if (btn) {
          btn.classList.add('active');
          let icon = btn.querySelector('i');
          if (icon) icon.className = 'fa-solid fa-heart';
        }
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Disimpan ke Favorit ❤️',
          showConfirmButton: false,
          timer: 1200
        });
      }
      localStorage.setItem('kamawak_wishlist', JSON.stringify(list));
      updateWishlistBadge();

      if (kategoriAktif === 'Favorit') {
        window.terapkanFilterDanUrutan();
      }
    };

    function updateWishlistBadge() {
      let list = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');
      let badge = document.getElementById('wishlistCountBadge');
      if (badge) badge.innerText = list.length;
    }

    window.filterKategori = function(element, kategori) { 
      document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active')); 
      if (element) element.classList.add('active'); 
      kategoriAktif = kategori; 
      let catSelect = document.getElementById('smartCategorySelect');
      if (catSelect) catSelect.value = kategori;
      window.terapkanFilterDanUrutan(); 
      let area = document.getElementById('areaKatalog');
      if (area) window.scrollTo({ top: area.offsetTop - 130, behavior: 'smooth' }); 
    };

    window.syncCategorySelect = function(val) {
      kategoriAktif = val;
      document.querySelectorAll('.category-tabs-top .tab-btn').forEach(btn => {
        let text = btn.innerText.trim();
        if (val === 'Semua' && text === 'Semua') btn.classList.add('active');
        else if (val === 'Favorit' && text.includes('Favorit')) btn.classList.add('active');
        else if (val !== 'Semua' && val !== 'Favorit' && text.toLowerCase().includes(val.toLowerCase())) btn.classList.add('active');
        else btn.classList.remove('active');
      });
      window.terapkanFilterDanUrutan();
      let area = document.getElementById('areaKatalog');
      if (area) window.scrollTo({ top: area.offsetTop - 130, behavior: 'smooth' });
    };

    window.syncBudgetSelect = function(val) {
      let priceSelect = document.getElementById('priceSelect');
      if (priceSelect) priceSelect.value = val;
      window.terapkanFilterDanUrutan();
      let area = document.getElementById('areaKatalog');
      if (area) window.scrollTo({ top: area.offsetTop - 130, behavior: 'smooth' });
    };
    
    window.trackAndGo = function(event, namaUsaha, jenisTombol, linkTarget) { 
      event.preventDefault(); event.stopPropagation(); 
      if(linkTarget && linkTarget !== "") { window.open(linkTarget, '_blank'); } 
      else { Swal.fire('Oops', 'Tautan belum tersedia.', 'info'); return; } 
    }

    window.navAksiCari = function(event) {
      if (event) event.preventDefault();
      let searchInput = document.getElementById('searchInput');
      let areaKatalog = document.getElementById('areaKatalog');
      if (areaKatalog) {
        window.scrollTo({ top: areaKatalog.offsetTop - 80, behavior: 'smooth' });
      }
      if (searchInput) {
        setTimeout(() => { searchInput.focus(); }, 350);
      }
    };

    function muatBannerPromoHome() {
      const banner = document.getElementById('promoBannerStrip');
      const track = document.getElementById('promoMarqueeTrack');
      if (!banner || !track) return;

      const masterAktif = localStorage.getItem('kamawak_promo_master_aktif');
      // PENTING: Hanya tampil jika status master promo benar-benar AKTIF ('true').
      // Jangan pernah berasumsi default aktif agar tidak muncul sekilas (flash) saat promo dinonaktifkan.
      if (masterAktif !== 'true') {
        banner.style.display = 'none';
        track.innerHTML = '';
        return;
      }

      let raw = localStorage.getItem('kamawak_promo_codes');
      let promos = [];
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) promos = parsed;
        } catch(e) {}
      }

      // Filter hanya voucher kupon yang aktif
      const activePromos = promos.filter(p => p.aktif !== false && p.aktif !== 'false');
      if (activePromos.length === 0) {
        banner.style.display = 'none';
        track.innerHTML = '';
        return;
      }

      // Format running text ticker (Marquee)
      let itemsHtml = `
        <span class="marquee-item">
          <i class="fa-solid fa-fire" style="color: #FDE047;"></i>
          <strong>PROMO SPESIAL LIBURAN RANAH MINANG</strong>
        </span>
        <span class="marquee-separator">✦</span>
      `;

      activePromos.forEach(p => {
        const valStr = p.tipe === 'persen' ? `${p.nilai}%` : `Rp ${Number(p.nilai).toLocaleString('id-ID')}`;
        const minStr = p.min && Number(p.min) > 0 ? ` (Min. Rp ${Number(p.min).toLocaleString('id-ID')})` : '';
        const descStr = p.deskripsi ? ` • ${p.deskripsi}` : '';
        itemsHtml += `
          <span class="marquee-item">
            <i class="fa-solid fa-tags" style="color: #FDE047;"></i>
            <span>Gunakan kode</span>
            <span class="marquee-code-pill" onclick="salinKuponHome('${p.kode}', event)" title="Klik untuk salin kode">${p.kode}</span>
            <span>Hemat ${valStr}${minStr}${descStr}</span>
          </span>
          <span class="marquee-separator">✦</span>
        `;
      });

      itemsHtml += `
        <span class="marquee-item">
          <i class="fa-regular fa-hand-pointer" style="color: #FDE047;"></i>
          <span>Klik kode kupon untuk menyalin otomatis</span>
        </span>
        <span class="marquee-separator">✦</span>
      `;

      // Gandakan konten 2x untuk perulangan mulus tanpa jeda (seamless infinite marquee)
      track.innerHTML = itemsHtml + itemsHtml;
      banner.style.display = 'block';
    }

    window.salinKuponHome = function(kode, event) {
      if (event) {
        event.stopPropagation();
      }
      const salinSukses = () => {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: `Kupon "${kode}" Berhasil Disalin!`,
            text: 'Gunakan saat pemesanan untuk menikmati diskon.',
            showConfirmButton: false,
            timer: 2500,
            timerProgressBar: true
          });
        }
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(kode).then(salinSukses).catch(() => {
          fallbackSalin(kode);
        });
      } else {
        fallbackSalin(kode);
      }

      function fallbackSalin(text) {
        try {
          const temp = document.createElement('input');
          temp.value = text;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
          salinSukses();
        } catch(e) {}
      }
    };
</script>

<BottomNav current="home" />

</body>
</html>