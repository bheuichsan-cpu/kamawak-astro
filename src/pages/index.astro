    .trust-item h4 { font-family: 'Poppins', sans-serif; font-size: 18px; margin-bottom: 10px; color: var(--text-dark); }
    .trust-item p { font-size: 14px; color: var(--text-gray); line-height: 1.6; }

    .partner-cta { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); padding: 60px 5%; text-align: center; color: white; margin-top: 30px; }
    .partner-content { max-width: 700px; margin: 0 auto; }
    .partner-content h2 { font-family: 'Poppins'; font-size: 32px; margin-bottom: 15px; color: white; }
    .partner-content p { font-size: 16px; color: #9CA3AF; margin-bottom: 25px; line-height: 1.6; }
    .btn-partner { background: var(--primary); color: white; padding: 14px 35px; border-radius: 50px; font-size: 16px; font-weight: 600; text-decoration: none; display: inline-block; transition: 0.3s; border: none; cursor: pointer; }
    .btn-partner:hover { background: #E04D14; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(255,94,31,0.3); }

    .floating-cs { position: fixed; bottom: 25px; right: 25px; background: #10B981; color: white; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4); z-index: 999; cursor: pointer; text-decoration: none; transition: 0.3s; animation: bounce 2s infinite; }
    .floating-cs:hover { background: #059669; transform: scale(1.1); }
    @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-10px); } 60% { transform: translateY(-5px); } }

    .footer { background: #0F172A; color: #94A3B8; padding: 60px 5% 30px; margin-top: auto; }
    .footer-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; border-bottom: 1px solid #1E293B; padding-bottom: 40px; margin-bottom: 20px; }
    .footer-logo { font-family: 'Poppins'; font-size: 24px; color: var(--white); font-weight: 700; margin-bottom: 15px; display: block; text-decoration: none; }
    .footer-bottom { text-align: center; font-size: 13px; }
    .ad-carousel { width: 100%; overflow: hidden; border-radius: 16px; position: relative; padding: 4px 0; }
    .ad-carousel-track { display: flex; transition: transform 0.5s ease; gap: 16px; }
    .ad-card { 
      flex: 0 0 calc(33.333% - 11px); 
      min-width: calc(33.333% - 11px); 
      border-radius: 16px; 
      overflow: hidden; 
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08); 
      cursor: pointer; 
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }
    .ad-card:hover { 
      transform: translateY(-4px) scale(1.01); 
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.16); 
    }
    .ad-card img { width: 100%; height: 135px; object-fit: cover; display: block; border-radius: 16px; }
    @media (max-width: 900px) { 
      .ad-card { flex: 0 0 calc(50% - 8px); min-width: calc(50% - 8px); } 
    }
    @media (max-width: 640px) { 
      .ad-card { flex: 0 0 calc(78% - 10px); min-width: calc(78% - 10px); } 
      .ad-card img { height: 125px; }
    }

    /* Desain Banner Pasang Iklan Disini (Slot Eksklusif & Modern) */
    .ad-card-placeholder {
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .ad-card-placeholder:hover .ad-decor-watermark {
      transform: rotate(0deg) scale(1.15);
      opacity: 0.28;
    }
    .ad-card-placeholder:hover .ad-slot-cta {
      transform: scale(1.06);
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
    .ad-placeholder-inner {
      width: 100%;
      height: 135px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: white;
      position: relative;
      overflow: hidden;
      box-sizing: border-box;
      border-radius: 16px;
    }
    /* Animasi Kilau Cahaya (Shimmer Light Effect) */
    .ad-placeholder-inner::after {
      content: '';
      position: absolute;
      top: -60%;
      left: -70%;
      width: 45%;
      height: 220%;
      background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.22) 50%, rgba(255,255,255,0) 100%);
      transform: rotate(25deg);
      pointer-events: none;
      animation: adShimmer 5s infinite ease-in-out;
    }
    @keyframes adShimmer {
      0%, 75% { left: -70%; opacity: 0; }
      80% { opacity: 1; }
      100% { left: 150%; opacity: 0; }
    }
    .ad-decor-watermark {
      position: absolute;
      right: -6px;
      bottom: -10px;
      font-size: 76px;
      opacity: 0.16;
      color: #FFFFFF;
      transform: rotate(-12deg);
      pointer-events: none;
      transition: all 0.3s ease;
      line-height: 1;
    }
    .ad-placeholder-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      position: relative;
      z-index: 2;
    }
    .ad-slot-badge {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 3px 8px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #FFFFFF;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .ad-pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #FFFFFF;
      box-shadow: 0 0 6px #FFFFFF;
      display: inline-block;
      animation: adPulse 1.6s infinite;
    }
    @keyframes adPulse {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 10px #FFFFFF; }
      100% { transform: scale(0.9); opacity: 0.7; }
    }
    .ad-slot-cta {
      font-size: 11px;
      font-weight: 700;
      color: #0F172A;
      background: #FFFFFF;
      padding: 4px 11px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 3px 8px rgba(0,0,0,0.2);
      transition: all 0.2s ease;
    }
    .ad-slot-cta i {
      color: #25D366;
      font-size: 13px;
    }
    .ad-placeholder-body {
      position: relative;
      z-index: 2;
      margin-top: auto;
    }
    .ad-placeholder-title {
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 13.5px;
      line-height: 1.25;
      color: #FFFFFF;
      margin-bottom: 2px;
      text-shadow: 0 1px 3px rgba(0,0,0,0.25);
    }
    .ad-placeholder-sub {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.3;
      font-weight: 500;
      text-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }
    @media (max-width: 768px) {
      .ad-placeholder-inner { height: 125px; padding: 12px 14px; }
      .ad-placeholder-title { font-size: 12px; }
      .ad-placeholder-sub { font-size: 10px; }
      .ad-decor-watermark { font-size: 60px; right: -4px; bottom: -6px; }
    }

