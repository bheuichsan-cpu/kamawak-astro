  <script>
    // SANITASI AWAL — hapus foto pulau & lembah dari SEMUA localStorage sebelum halaman render
    (function() {
      var BAD_IDS = ['1518509562904', '1507525428034', '1506744038136', '1544551763'];
      var GOOD = 'photo-1542314831-068cd1dbfeeb';
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i);
          if (!key) continue;
          var val = localStorage.getItem(key);
          if (!val) continue;
          var changed = false;
          for (var j = 0; j < BAD_IDS.length; j++) {
            if (val.indexOf(BAD_IDS[j]) !== -1) {
              val = val.split(BAD_IDS[j]).join(GOOD);
              changed = true;
            }
          }
          if (changed) localStorage.setItem(key, val);
        }
      } catch(e) {}
    })();
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style is:inline>
    :root {
      --primary: #FF5E1F;
      --primary-dark: #EA580C;
      --bg-color: #FFFFFF;
      --text-dark: #0F172A;
      --text-gray: #64748B;
      --white: #FFFFFF;
      --shadow: 0 4px 20px rgba(0,0,0,0.06);
      --radius: 18px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { overflow-x: hidden; }
    body { font-family: 'Inter', sans-serif; background-color: var(--bg-color); color: var(--text-dark); display: flex; flex-direction: column; min-height: 100vh; position: relative; }    
    
    /* TOP NAVBAR (CLEAN MINIMALIST AIRBNB/MOCKUP STYLE) */
    .navbar {
      background: var(--white);
      padding: 16px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #F1F5F9;
      position: sticky;
      top: 0;
      z-index: 100;
      gap: 20px;
    }
    .logo {
      font-family: 'Poppins', sans-serif;
      font-size: 24px;
      font-weight: 800;
      color: #0F172A;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    .logo i { color: var(--primary); }
    .nav-center-categories {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .nav-center-categories::-webkit-scrollbar {
      display: none;
    }
    .nav-cat-pill {
      background: transparent;
      border: none;
      font-family: 'Inter', sans-serif;
      font-size: 13.5px;
      font-weight: 600;
      color: #475569;
      padding: 7px 13px;
      border-radius: 30px;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-cat-pill:hover {
      background: #FFF7ED;
      color: #FF5E1F;
    }
    .nav-cat-pill.active {
      background: #FF5E1F;
      color: #FFFFFF;
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(255, 94, 31, 0.25);
    }
    .nav-cat-pill.active i {
      color: #FFFFFF !important;
    }
    .btn-login-nav {
      background: linear-gradient(135deg, #FF6A28 0%, #EA580C 100%) !important;
      color: #FFFFFF !important;
      padding: 10px 24px !important;
      border-radius: 30px !important;
      text-decoration: none;
      font-family: 'Poppins', sans-serif;
      font-size: 14px !important;
      font-weight: 700 !important;
      display: inline-flex !important;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35) !important;
      transition: all 0.2s ease;
      border: none;
      flex-shrink: 0;
    }
    .btn-login-nav:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(234, 88, 12, 0.45) !important;
    }

    /* HERO BANNER PANORAMA */
    .hero-slider {
      position: relative;
      height: 430px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      background: #0F172A;
    }
    .slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1.5s ease-in-out;
      z-index: 1;
    }
    .slide.active { opacity: 1; }
    .slide.clickable { cursor: pointer; } 
    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(15,23,42,0.2) 0%, rgba(15,23,42,0.65) 100%);
      z-index: 2;
      pointer-events: none;
    }
    .hero-content {
      position: relative;
      z-index: 3;
      color: var(--white);
      padding: 0 5%;
      width: 100%;
      max-width: 860px;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 25px;
    }
    .hero-content h1 {
      font-family: 'Poppins', sans-serif;
      font-size: 48px;
      margin-bottom: 12px;
      line-height: 1.15;
      text-shadow: 0 4px 20px rgba(0,0,0,0.55);
      font-weight: 800;
      letter-spacing: -0.5px;
    }
    .hero-content p {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.92);
      max-width: 650px;
      line-height: 1.5;
      text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    }

    /* FLOATING SMART SEARCH WIDGET (HALF-OVERLAPPING HERO AND BODY) */
    .smart-search-floating-wrapper {
      position: relative;
      z-index: 20;
      margin-top: -34px;
      display: flex;
      justify-content: center;
      padding: 0 15px;
      margin-bottom: 35px;
    }
    .smart-search-widget {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 60px;
      padding: 8px 12px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.8);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-sizing: border-box;
      max-width: 860px;
    }
    .search-pill-box {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 40px;
      padding: 9px 18px;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .search-pill-box.pill-destinasi {
      min-width: 190px;
      flex: 1.4;
    }
    .search-pill-box:focus-within {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(255, 94, 31, 0.15);
    }
    .search-pill-box i {
      color: #64748B;
      font-size: 13px;
      flex-shrink: 0;
    }
    .search-input-pill {
      border: none;
      outline: none;
      background: transparent;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #1E293B;
      width: 100%;
    }
    .search-input-pill::placeholder { color: #94A3B8; }
    .search-select-pill {
      border: none;
      outline: none;
      background: transparent;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #1E293B;
      cursor: pointer;
    }
    .smart-search-btn {
      background: linear-gradient(135deg, #FF6A28 0%, #EA580C 100%);
      color: #FFFFFF;
      border: none;
      font-family: 'Poppins', sans-serif;
      font-size: 15px;
      font-weight: 700;
      border-radius: 40px;
      padding: 11px 36px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(234, 88, 12, 0.35);
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .smart-search-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(234, 88, 12, 0.45);
    }

    /* BENTO CITY CARDS */
    .section-title {
      font-family: 'Poppins', sans-serif;
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #0F172A;
    }
    .city-scroll {
      display: flex;
      overflow-x: auto;
      gap: 16px;
      padding-bottom: 12px;
      margin-bottom: 30px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .city-scroll::-webkit-scrollbar { display: none; }
    .city-card {
      min-width: 145px;
      max-width: 145px;
      height: 200px;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      scroll-snap-align: start;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      flex-shrink: 0;
      border: 2px solid transparent;
    }
    .city-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.15);
    }
    .city-card.city-active {
      border-color: var(--primary) !important;
      box-shadow: 0 6px 20px rgba(255, 94, 31, 0.35);
    }
    .city-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .city-card:hover img { transform: scale(1.08); }
    .city-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(4px);
      color: #0F172A;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      display: flex;
      align-items: center;
      gap: 4px;
      z-index: 5;
    }
    .city-badge-soon {
      background: rgba(15, 23, 42, 0.65) !important;
      color: #F8FAFC !important;
      font-weight: 500 !important;
    }
    .city-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      background: linear-gradient(to top, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0.1) 70%, rgba(0,0,0,0) 100%);
      display: flex;
      align-items: flex-end;
      padding: 14px 12px;
    }
    .city-name {
      color: #FFFFFF;
      font-family: 'Poppins', sans-serif;
      font-size: 15px;
      font-weight: 700;
      text-shadow: 0 2px 6px rgba(0,0,0,0.6);
    }

    /* RECOMMENDED POPULAR SECTION */
    .popular-scroll {
      display: flex;
      overflow-x: auto;
      gap: 20px;
      padding-bottom: 20px;
      margin-bottom: 10px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .popular-scroll::-webkit-scrollbar { height: 6px; }
    .popular-scroll::-webkit-scrollbar-track { background: #F8FAFC; border-radius: 10px; }
    .popular-scroll::-webkit-scrollbar-thumb { background: #E2E8F0; border-radius: 10px; }
    .popular-card { min-width: 290px; max-width: 290px; scroll-snap-align: start; flex-shrink: 0; }

    /* CONTROLS WRAPPER */
    .controls-wrapper {
      max-width: 1200px;
      margin: 20px auto 10px;
      padding: 0 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }
    .filter-group { display: flex; gap: 10px; flex-wrap: wrap; }
    .sort-select {
      padding: 8px 16px;
      border-radius: 30px;
      border: 1px solid #E2E8F0;
      outline: none;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      background: var(--white);
      color: var(--text-dark);
      transition: border-color 0.2s;
    }
    .sort-select:hover { border-color: #CBD5E1; }

    /* GRID & CARDS (EXACT MATCH TO APPROVED MOCKUP) */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 5%; flex: 1; width: 100%; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      margin-bottom: 50px;
    }
    .card {
      background: var(--white);
      border-radius: 20px;
      border: 1px solid #F1F5F9;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      padding: 12px;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
      position: relative;
    }
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.1);
      border-color: #E2E8F0;
    }
    .card-clickable {
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .card-img-wrapper {
      position: relative;
      overflow: hidden;
      background: #F1F5F9;
      border-radius: 14px;
      height: 165px;
    }
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .card:hover .card-img { transform: scale(1.05); }

    .card-dots {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 5px;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(4px);
      padding: 3px 7px;
      border-radius: 12px;
      pointer-events: none;
    }
    .card-dots .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.6);
      transition: all 0.2s;
    }
    .card-dots .dot.active {
      background: #FFFFFF;
      width: 14px;
      border-radius: 4px;
    }

    .btn-wishlist-card {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(4px);
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94A3B8;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      z-index: 10;
    }
    .btn-wishlist-card:hover { transform: scale(1.15); color: #FF5E1F; background: white; }
    .btn-wishlist-card.active { color: #FFFFFF; background: #FF5E1F; box-shadow: 0 4px 12px rgba(255, 94, 31, 0.35); }
    .btn-wishlist-card.active i { color: #FFFFFF !important; }

    .card-discount-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: linear-gradient(135deg, #FF6A28 0%, #EA580C 100%);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(255, 94, 31, 0.4);
      z-index: 5;
    }

    .card-content {
      padding: 10px 4px 4px 4px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .card-head-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
    }
    .card-location-row {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: #64748B;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 1px;
      margin-bottom: 2px;
    }
    .card-location-row i {
      color: var(--primary);
      font-size: 11px;
      flex-shrink: 0;
    }
    .card-cat-tag {
      font-size: 11px;
      background: #F1F5F9;
      color: #475569;
      padding: 1px 6px;
      border-radius: 4px;
      font-weight: 600;
      flex-shrink: 0;
    }
