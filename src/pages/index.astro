    window.klikIklanServer = function(baris, linkTujuan) {
      if (typeof google !== 'undefined' && google.script && google.script.run && baris) {
        google.script.run.catatMetrikIklan(baris, 'klik');
      }
      if (linkTujuan && (linkTujuan.startsWith('http') || linkTujuan.startsWith('www'))) {
          if(!linkTujuan.startsWith('http')) linkTujuan = 'https://' + linkTujuan;
          window.open(linkTujuan, '_blank');
      } else if (linkTujuan) {
          document.getElementById('searchInput').value = linkTujuan; 
          panggilDataServer();
          window.scrollTo({ top: document.getElementById('areaKatalog').offsetTop - 20, behavior: 'smooth' });
      }
    };

    function jalankanCarouselIklan(totalAds) {
      if (totalAds <= 3) return;
      let track = document.getElementById('adCarouselTrack');
      if (!track || !track.children || track.children.length === 0) return;
      let currentShift = 0;
      
      setInterval(() => {
         currentShift++;
         let itemWidth = (track.children[0] ? track.children[0].offsetWidth : 280) + 15;
         if (currentShift > totalAds - (window.innerWidth < 768 ? 2 : 3)) {
            currentShift = 0;
            track.style.transition = 'none';
            track.style.transform = `translateX(0px)`;
            setTimeout(() => { track.style.transition = 'transform 0.5s ease'; }, 50);
         } else {
            track.style.transform = `translateX(-${currentShift * itemWidth}px)`;
         }
      }, 3500);
    }

