    window.bukaKontakPasangIklan = function(slotNama) {
      let adminWa = localStorage.getItem('kamawak_prof_wa') || '6281234567890';
      adminWa = adminWa.replace(/[^0-9]/g, '');
      if (adminWa.startsWith('0')) adminWa = '62' + adminWa.substring(1);
      let pesan = encodeURIComponent(`Halo Admin Kamawak, saya tertarik untuk memasang banner iklan usaha saya di website Kamawak (${slotNama || 'Slot Beranda'}). Mohon informasi tarif dan persyaratannya.`);
      window.open(`https://wa.me/${adminWa}?text=${pesan}`, '_blank');
