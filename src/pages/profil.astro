  <script>
    import { supabase } from '../lib/supabase.js';
    const BASE_URL = "";

    let semuaPesananCache = [];
    let filterAktifSekarang = 'semua';
    let dataPenggunaAktif = null;

    function formatUang(angka) { return "Rp " + Number(angka || 0).toLocaleString('id-ID'); }

    async function hashPassword(str) {
      const utf8 = new TextEncoder().encode(str);
      const hashBuffer = await crypto.subtle.digest('SHA-256', utf8);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    // ==========================================
    // SISTEM TAB: AKUN SAYA VS TIKET SAYA
    // ==========================================
    window.pindahTab = function(namaTab) {
      const pillAkun = document.getElementById('pillAkun');
      const pillTiket = document.getElementById('pillTiket');
      const seksiAkun = document.getElementById('seksiAkun');
      const seksiTiket = document.getElementById('seksiTiket');

      if (namaTab === 'tiket') {
        if (pillTiket) pillTiket.classList.add('active');
        if (pillAkun) pillAkun.classList.remove('active');
        if (seksiTiket) seksiTiket.style.display = 'block';
        if (seksiAkun) seksiAkun.style.display = 'none';
        try { window.history.replaceState(null, '', '/profil?tab=tiket'); } catch(e){}
        sinkronkanBottomNavHighlight('orders');
      } else {
        if (pillAkun) pillAkun.classList.add('active');
        if (pillTiket) pillTiket.classList.remove('active');
        if (seksiAkun) seksiAkun.style.display = 'block';
        if (seksiTiket) seksiTiket.style.display = 'none';
        try { window.history.replaceState(null, '', '/profil?tab=akun'); } catch(e){}
        sinkronkanBottomNavHighlight('profile');
      }
    };

    function sinkronkanBottomNavHighlight(mode) {
      let btnTiket = document.getElementById('btnNavTiket');
      let btnAkun = document.getElementById('btnNavAkun');
      if (mode === 'orders') {
        if (btnTiket) btnTiket.classList.add('active');
        if (btnAkun) btnAkun.classList.remove('active');
      } else {
        if (btnAkun) btnAkun.classList.add('active');
        if (btnTiket) btnTiket.classList.remove('active');
      }
    }

    window.scrollKeVoucher = function() {
      const el = document.getElementById('cardVoucherProfil');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    // ==========================================
    // INITIALIZATION & USER DATA
    // ==========================================
    window.onload = async function() {
      if (typeof window.updateNavbarLogo === 'function') window.updateNavbarLogo();

      let activeUser = localStorage.getItem("kamawak_user");
      let activeRole = localStorage.getItem("kamawak_role") || "Wisatawan";

      if (!activeUser) {
        window.location.href = "/login";
        return;
      }

      document.getElementById("mainBody").style.display = "block";
      document.getElementById("uiNama").innerText = activeUser;
      document.getElementById("uiAvatar").innerText = activeUser.charAt(0).toUpperCase();

      // Sinkronkan badge wishlist
      try {
        let favs = JSON.parse(localStorage.getItem('kamawak_wishlist') || '[]');
        let statFav = document.getElementById('statWishlistAktif');
        if (statFav) statFav.innerText = favs.length;
      } catch(e) {}

      // Muat Data Pengguna dari Supabase
      muatDataLengkapPengguna(activeUser);

      // Muat Histori Pesanan & Kupon
      loadHistoriPesanan(activeUser);
      muatVoucherProfil();

      // Cek parameter URL untuk menentukan tab aktif
      let params = new URLSearchParams(window.location.search);
      let tabAwal = params.get('tab') || 'akun';
      pindahTab(tabAwal);
    };

    async function muatDataLengkapPengguna(namaUser) {
      try {
        let activeId = localStorage.getItem('kamawak_id');
        let query = supabase.from('users').select('*');
        if (activeId) {
          query = query.eq('id', activeId);
        } else {
          query = query.eq('nama', namaUser);
        }
        const { data, error } = await query.single();
        if (data && !error) {
          dataPenggunaAktif = data;
          if (data.wa && data.wa.trim() !== '') {
            document.getElementById('uiWaDisplay').innerText = data.wa;
          }
          if (data.email && data.email.trim() !== '') {
            document.getElementById('uiEmailDisplay').innerText = data.email;
          }
        }
      } catch(e) {
        console.warn("Info profil ekstra:", e.message);
      }
    }

    // ==========================================
    // HISTORI PESANAN & TIKET
    // ==========================================
    async function loadHistoriPesanan(user) {
      try {
        const { data, error } = await supabase
          .from('transaksi')
          .select('*')
          .eq('user', user)
          .order('created_at', { ascending: false });

        if (error) throw error;

        semuaPesananCache = data || [];

        // Hitung statistik
        let countAktif = 0;
        let countSelesai = 0;
        semuaPesananCache.forEach(item => {
          let st = (item.status || '').toLowerCase();
          if (st.includes('digunakan')) countSelesai++;
          else if (st.includes('sukses') || st.includes('berhasil') || st.includes('lunas')) countAktif++;
        });

        document.getElementById('countSemua').innerText = semuaPesananCache.length;
        document.getElementById('countAktif').innerText = countAktif;
        document.getElementById('countSelesai').innerText = countSelesai;
        document.getElementById('statTiketAktif').innerText = countAktif;

        let badgePill = document.getElementById('badgeTiketCount');
        if (badgePill) {
          if (countAktif > 0) {
            badgePill.innerText = countAktif;
            badgePill.style.display = 'inline-block';
          } else {
            badgePill.style.display = 'none';
          }
        }

        renderDaftarPesanan(semuaPesananCache);
      } catch (err) {
        document.getElementById("orderList").innerHTML = `<div class="empty-state">Gagal memuat pesanan: ${err.message}</div>`;
      }
    }

    window.filterHistori = function(kategori, btnEl) {
      filterAktifSekarang = kategori;
      document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');

      let filtered = [];
      if (kategori === 'aktif') {
        filtered = semuaPesananCache.filter(x => {
          let st = (x.status || '').toLowerCase();
          return st.includes('sukses') || st.includes('berhasil') || st.includes('lunas');
        });
      } else if (kategori === 'selesai') {
        filtered = semuaPesananCache.filter(x => {
          let st = (x.status || '').toLowerCase();
          return st.includes('digunakan');
        });
      } else {
        filtered = semuaPesananCache;
      }
      renderDaftarPesanan(filtered);
    };

    function renderDaftarPesanan(list) {
      let container = document.getElementById("orderList");
      if (!list || list.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fa-solid fa-receipt"></i>
            <p><strong>Belum ada tiket pada kategori ini.</strong><br>Ayo rencanakan liburan seru Anda di Ranah Minang sekarang!</p>
            <a href="/#areaKatalog" class="btn-jelajah"><i class="fa-solid fa-compass"></i> Jelajahi Wisata</a>
          </div>
        `;
        return;
      }

      let html = "";
      list.forEach(item => {
        let statusText = (item.status || "menunggu").toLowerCase();
        let badgeHtml = '';
        let isTiketAktif = false;
        if(statusText.includes("digunakan")) {
          badgeHtml = `<span class="order-status" style="background:#E0E7FF; color:#3730A3; border:1px solid #C7D2FE;"><i class="fa-solid fa-circle-check"></i> Sudah Digunakan</span>`;
          isTiketAktif = true;
        } else if(statusText.includes("sukses") || statusText.includes("berhasil") || statusText.includes("lunas")) {
          badgeHtml = `<span class="order-status status-lunas"><i class="fa-solid fa-ticket"></i> Siap Digunakan</span>`;
          isTiketAktif = true;
        } else if(statusText.includes("batal") || statusText.includes("gagal")) {
          badgeHtml = `<span class="order-status status-batal">Dibatalkan</span>`;
        } else {
          badgeHtml = `<span class="order-status status-menunggu">Menunggu Pembayaran</span>`;
        }
        
        let tglPesan = item.created_at ? new Date(item.created_at).toLocaleDateString('id-ID') : '-';
        let tglWisata = item.tanggal || '-';
        let encodedItem = encodeURIComponent(JSON.stringify(item));
        let reviewedOrders = JSON.parse(localStorage.getItem('kamawak_reviewed_orders') || '[]');
        let isReviewed = reviewedOrders.includes(String(item.id));
        let tombolUlasan = '';
        if (isTiketAktif) {
          if (isReviewed) {
            tombolUlasan = `<span style="font-size: 11px; color: #059669; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; padding: 6px 10px; background: #ECFDF5; border-radius: 6px;"><i class="fa-solid fa-circle-check"></i> Ulasan Terkirim</span>`;
          } else {
            tombolUlasan = `<button class="btn-beri-ulasan" onclick="bukaModalUlasan('${encodedItem}')"><i class="fa-solid fa-star"></i> Beri Ulasan</button>`;
          }
        }
        let tombolTiket = isTiketAktif 
          ? `<button class="btn-tiket" onclick="bukaETiket('${encodedItem}')"><i class="fa-solid fa-qrcode"></i> Lihat E-Tiket</button>`
          : '';

        html += `
          <div class="order-item">
            <div class="order-header">
              <span><i class="fa-regular fa-clock"></i> Pesan: ${tglPesan}</span>
              ${badgeHtml}
            </div>
            <div class="order-body">
              <div>
                <div class="order-title">${item.namaProduk || '-'}</div>
                <div class="order-detail">
                  <i class="fa-solid fa-calendar-day" style="color:var(--primary);"></i> Tgl Keberangkatan: <strong>${tglWisata}</strong> <br>
                  <i class="fa-solid fa-users" style="color:#64748B;"></i> ${item.pax || 0} Pax | Paket: ${item.paket || '-'}
                </div>
              </div>
              <div class="order-price">${formatUang(item.totalBayar)}</div>
            </div>
            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px dashed #E2E8F0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <span style="font-size: 12px; color: var(--text-gray); font-family: monospace;"><i class="fa-solid fa-barcode"></i> ${item.id}</span>
              <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                ${tombolUlasan}
                ${tombolTiket}
              </div>
            </div>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    // ==========================================
    // MODAL EDIT PROFIL
    // ==========================================
    window.bukaModalEditProfil = function() {
      let activeUser = localStorage.getItem("kamawak_user") || "";
      document.getElementById('editNama').value = activeUser;
      if (dataPenggunaAktif) {
        document.getElementById('editWa').value = dataPenggunaAktif.wa || "";
        document.getElementById('editEmail').value = dataPenggunaAktif.email || "";
      }
      document.getElementById('modalEditProfil').style.display = 'flex';
    };

    window.tutupModalEditProfil = function() {
      document.getElementById('modalEditProfil').style.display = 'none';
    };

    window.simpanDataProfil = async function() {
      let namaBaru = document.getElementById('editNama').value.trim();
      let waBaru = document.getElementById('editWa').value.trim();
      let emailBaru = document.getElementById('editEmail').value.trim();

      if (!namaBaru) {
        Swal.fire('Perhatian', 'Nama lengkap tidak boleh kosong.', 'warning');
        return;
      }

      let btn = document.getElementById('btnSimpanProfil');
      let teksAsli = btn ? btn.innerText : '';
      if (btn) { btn.innerText = 'Menyimpan...'; btn.disabled = true; }

      try {
        let activeId = localStorage.getItem('kamawak_id');
        let oldUser = localStorage.getItem('kamawak_user');

        let payload = { nama: namaBaru, wa: waBaru, email: emailBaru };
        let query = supabase.from('users').update(payload);
        if (activeId) {
          query = query.eq('id', activeId);
        } else {
          query = query.eq('nama', oldUser);
        }

        const { error } = await query;
        if (error) throw error;

        // Perbarui localStorage & UI
        localStorage.setItem('kamawak_user', namaBaru);
        document.getElementById('uiNama').innerText = namaBaru;
        document.getElementById('uiAvatar').innerText = namaBaru.charAt(0).toUpperCase();
        if (waBaru) document.getElementById('uiWaDisplay').innerText = waBaru;
        if (emailBaru) document.getElementById('uiEmailDisplay').innerText = emailBaru;

        tutupModalEditProfil();
        Swal.fire('Berhasil!', 'Data profil Anda berhasil diperbarui.', 'success');
      } catch(err) {
        console.error("Gagal update profil:", err);
        Swal.fire('Gagal', 'Terjadi kendala saat menyimpan profil: ' + err.message, 'error');
      } finally {
        if (btn) { btn.innerText = teksAsli; btn.disabled = false; }
      }
    };

    // ==========================================
    // MODAL GANTI SANDI
    // ==========================================
    window.bukaModalGantiSandi = function() {
      document.getElementById('passBaru').value = '';
      document.getElementById('passKonfirmasi').value = '';
      document.getElementById('modalGantiSandi').style.display = 'flex';
    };

    window.tutupModalGantiSandi = function() {
      document.getElementById('modalGantiSandi').style.display = 'none';
    };

    window.simpanKataSandi = async function() {
      let p1 = document.getElementById('passBaru').value;
      let p2 = document.getElementById('passKonfirmasi').value;

      if (!p1 || p1.length < 6) {
        Swal.fire('Perhatian', 'Kata sandi baru minimal terdiri dari 6 karakter.', 'warning');
        return;
      }
      if (p1 !== p2) {
        Swal.fire('Perhatian', 'Konfirmasi kata sandi tidak cocok. Mohon periksa kembali.', 'warning');
        return;
      }

      let btn = document.getElementById('btnSimpanSandi');
      let teksAsli = btn ? btn.innerText : '';
      if (btn) { btn.innerText = 'Menyimpan Sandi...'; btn.disabled = true; }

      try {
        let hashed = await hashPassword(p1);
        let activeId = localStorage.getItem('kamawak_id');
        let oldUser = localStorage.getItem('kamawak_user');

        let query = supabase.from('users').update({ password: hashed });
        if (activeId) {
          query = query.eq('id', activeId);
        } else {
          query = query.eq('nama', oldUser);
        }

        const { error } = await query;
        if (error) throw error;

        tutupModalGantiSandi();
        Swal.fire('Sandi Berhasil Diubah! 🔒', 'Kata sandi akun Anda telah diperbarui dengan aman.', 'success');
      } catch(err) {
        console.error("Gagal update sandi:", err);
        Swal.fire('Gagal', 'Kendala ubah sandi: ' + err.message, 'error');
      } finally {
        if (btn) { btn.innerText = teksAsli; btn.disabled = false; }
      }
    };

    // ==========================================
    // LOGOUT & CS WHATSAPP
    // ==========================================
    window.konfirmasiKeluarAkun = function() {
      Swal.fire({
        title: 'Keluar dari Akun?',
        text: 'Anda perlu masuk kembali untuk mengakses tiket & pesanan wisata.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#DC2626',
        cancelButtonColor: '#64748B',
        confirmButtonText: '<i class="fa-solid fa-right-from-bracket"></i> Ya, Keluar',
        cancelButtonText: 'Batal'
      }).then((result) => {
        if (result.isConfirmed) {
          localStorage.removeItem('kamawak_user');
          localStorage.removeItem('kamawak_role');
          localStorage.removeItem('kamawak_id');
          window.location.href = '/login';
        }
      });
    };

    window.hubungiCSWhatsApp = function() {
      let adminWa = localStorage.getItem('kamawak_prof_wa') || '6281234567890';
      adminWa = adminWa.replace(/[^0-9]/g, '');
      if (adminWa.startsWith('0')) adminWa = '62' + adminWa.substring(1);
      let pesan = encodeURIComponent('Halo Customer Support Kamawak.id, saya wisatawan ingin bertanya seputar layanan dan pesanan tiket.');
      window.open(`https://wa.me/${adminWa}?text=${pesan}`, '_blank');
    };

    window.bukaModalSyarat = function() {
      Swal.fire({
        title: 'Ketentuan Layanan & Privasi',
        html: `
          <div style="text-align:left; font-size:13px; line-height:1.6; color:#475569; max-height:300px; overflow-y:auto;">
            <p><strong>1. Reservasi & Tiket:</strong> E-Tiket yang diterbitkan resmi oleh Kamawak.id berlaku untuk tanggal keberangkatan yang dipilih saat reservasi.</p>
            <p style="margin-top:8px;"><strong>2. Check-in & Validasi:</strong> Tunjukkan kode QR pada E-Tiket kepada pemandu wisata atau mitra penyedia layanan di lokasi kedatangan.</p>
            <p style="margin-top:8px;"><strong>3. Privasi Data:</strong> Data kontak Anda (Nama, WhatsApp, Email) dilindungi dan hanya digunakan untuk keperluan koordinasi wisata.</p>
          </div>
        `,
        confirmButtonText: 'Saya Mengerti',
        confirmButtonColor: '#FF5E1F'
      });
    };

    // ==========================================
    // BOARDING PASS & REVIEW FUNCTIONS
    // ==========================================
    window.bukaETiket = function(itemEncoded) {
      try {
        let item = JSON.parse(decodeURIComponent(itemEncoded));
        document.getElementById('tikNamaProduk').innerText = item.namaProduk || 'Tiket Wisata';
        document.getElementById('tikKode').innerText = item.id || 'TRX-000000';
        document.getElementById('tikUser').innerText = item.user || '-';
        document.getElementById('tikTgl').innerText = item.tanggal || '-';
        document.getElementById('tikPax').innerText = (item.pax || 1) + ' Pax';
        document.getElementById('tikPaket').innerText = item.paket || 'Reguler';
        document.getElementById('tikTotal').innerText = formatUang(item.totalBayar);

        let destName = item.namaProduk || 'Sumatera Barat';
        let routeDest = document.getElementById('tikRouteDest');
        if (routeDest) routeDest.innerText = destName;

        let statusText = (item.status || 'Berhasil').toLowerCase();
        let badgeEl = document.getElementById('tikStatusBadge');
        let textEl = document.getElementById('tikStatusText');
        if (statusText.includes('digunakan')) {
          if (badgeEl) {
            badgeEl.innerText = 'USED';
            badgeEl.style.color = '#818CF8';
            badgeEl.style.borderColor = '#6366F1';
          }
          if (textEl) textEl.innerText = 'Sudah Digunakan';
        } else {
          if (badgeEl) {
            badgeEl.innerText = 'CONFIRMED';
            badgeEl.style.color = '#34D399';
            badgeEl.style.borderColor = '#10B981';
          }
          if (textEl) textEl.innerText = 'Lunas & Siap Digunakan';
        }

        let qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=" + encodeURIComponent(item.id);
        document.getElementById('tikQRImg').src = qrUrl;

        document.getElementById('modalETiket').style.display = 'flex';
      } catch(e) {
        console.error("Gagal membuka tiket:", e);
      }
    };

    window.tutupETiket = function() {
      document.getElementById('modalETiket').style.display = 'none';
    };

    window.unduhGambarTiket = async function() {
      const card = document.getElementById('eTiketCard');
      const btn = document.getElementById('btnDownloadTiket');
      const kode = document.getElementById('tikKode').innerText || 'TIKET';
      if (!card) return;

      const teksAsli = btn ? btn.innerHTML : '';
      if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses PNG...';
        btn.disabled = true;
      }

      try {
        if (typeof html2canvas === 'undefined') {
          throw new Error('Modul html2canvas belum siap.');
        }
        const canvas = await html2canvas(card, {
          scale: 2,
          useCORS: true,
          allowTaint: true,
          backgroundColor: '#ffffff'
        });
        const link = document.createElement('a');
        link.download = `ETiket_Kamawak_${kode}.png`;
        link.href = canvas.toDataURL('image/png');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Gambar E-Tiket berhasil disimpan!',
          showConfirmButton: false,
          timer: 2000
        });
      } catch (err) {
        console.error("Gagal mengunduh gambar tiket:", err);
        Swal.fire('Informasi', 'Silakan gunakan tombol Cetak Tiket untuk menyimpan sebagai PDF jika unduhan gambar dibatasi perangkat.', 'info');
      } finally {
        if (btn) {
          btn.innerHTML = teksAsli;
          btn.disabled = false;
        }
      }
    };

    let orderAktifReview = null;
    let ratingDipilih = 5;

    window.bukaModalUlasan = function(itemEncoded) {
      try {
        orderAktifReview = JSON.parse(decodeURIComponent(itemEncoded));
        document.getElementById('revProdukNama').innerText = orderAktifReview.namaProduk || 'Paket Wisata';
        document.getElementById('revKomentar').value = '';
        pilihBintang(5);
        document.getElementById('modalUlasan').style.display = 'flex';
      } catch(e) {
        console.error("Gagal membuka modal ulasan:", e);
      }
    };

    window.tutupModalUlasan = function() {
      document.getElementById('modalUlasan').style.display = 'none';
      orderAktifReview = null;
    };

    window.pilihBintang = function(nilai) {
      ratingDipilih = nilai;
      const stars = document.querySelectorAll('#starPicker i');
      stars.forEach((s, idx) => {
        if (idx < nilai) s.classList.add('selected');
        else s.classList.remove('selected');
      });

      const labelEl = document.getElementById('starLabel');
      if (nilai === 5) labelEl.innerText = '5.0 - Sangat Memuaskan! ⭐';
      else if (nilai === 4) labelEl.innerText = '4.0 - Bagus & Rekomendasi 👍';
      else if (nilai === 3) labelEl.innerText = '3.0 - Cukup Memuaskan 😊';
      else if (nilai === 2) labelEl.innerText = '2.0 - Kurang Sesuai Harapan 😐';
      else labelEl.innerText = '1.0 - Sangat Mengecewakan 😞';
    };

    window.kirimkanUlasan = function() {
      if (!orderAktifReview) return;
      const komentar = document.getElementById('revKomentar').value.trim();
      if (!komentar) {
        Swal.fire('Perhatian', 'Mohon tulis sedikit ulasan atau kesan liburan Anda.', 'warning');
        return;
      }

      const btn = document.getElementById('btnKirimUlasan');
      const teksAsli = btn ? btn.innerText : '';
      if (btn) {
        btn.innerText = 'Mengirimkan Ulasan...';
        btn.disabled = true;
      }

      const payload = {
        idProduk: orderAktifReview.idProduk || orderAktifReview.id,
        namaUser: localStorage.getItem('kamawak_user') || 'Wisatawan',
        rating: ratingDipilih,
        komentar: komentar,
        tanggal: new Date().toISOString()
      };

      const pKey = 'kamawak_ulasan_' + payload.idProduk;
      let cached = JSON.parse(localStorage.getItem(pKey) || '[]');
      cached.unshift({
        nama: payload.namaUser,
        rating: payload.rating,
        komentar: payload.komentar,
        tanggal: 'Baru saja'
      });
      localStorage.setItem(pKey, JSON.stringify(cached));

      let reviewedOrders = JSON.parse(localStorage.getItem('kamawak_reviewed_orders') || '[]');
      if (!reviewedOrders.includes(String(orderAktifReview.id))) {
        reviewedOrders.push(String(orderAktifReview.id));
        localStorage.setItem('kamawak_reviewed_orders', JSON.stringify(reviewedOrders));
      }

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        try {
          google.script.run.tambahUlasan(payload);
        } catch(e) {}
      }

      tutupModalUlasan();
      Swal.fire('Terima Kasih! ⭐', 'Ulasan Anda telah berhasil disimpan dan diverifikasi.', 'success').then(() => {
        let user = localStorage.getItem('kamawak_user');
        if (user) loadHistoriPesanan(user);
      });
    };

    window.kembaliKeHome = function() {
      window.open(BASE_URL + "/", "_top");
    };

    function muatVoucherProfil() {
      const container = document.getElementById('listVoucherProfil');
      const card = document.getElementById('cardVoucherProfil');
      if (!container) return;

      const masterAktif = localStorage.getItem('kamawak_promo_master_aktif');
      if (masterAktif === 'false') {
        if (card) card.style.display = 'none';
        return;
      }
      if (card) card.style.display = 'block';

      let raw = localStorage.getItem('kamawak_promo_codes');
      let list = [];
      if (raw !== null && raw !== undefined) {
        try { list = JSON.parse(raw); } catch(e) {}
      } else {
        list = [
          { kode: 'MINANGSERU', tipe: 'persen', nilai: 10, min: 100000, deskripsi: 'Diskon 10% Spesial Jelajah Minangkabau', aktif: true },
          { kode: 'HEMAT50K', tipe: 'nominal', nilai: 50000, min: 200000, deskripsi: 'Potongan Langsung Rp 50.000', aktif: true },
          { kode: 'PROMOAWAL', tipe: 'persen', nilai: 15, min: 150000, deskripsi: 'Diskon 15% Eksklusif Wisatawan Baru', aktif: true }
        ];
      }

      const activeList = Array.isArray(list) ? list.filter(p => p.aktif !== false) : [];
      let statKupon = document.getElementById('statKuponAktif');
      if (statKupon) statKupon.innerText = activeList.length;

      if (activeList.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: var(--text-gray); font-size: 13px; padding: 20px; background: #F9FAFB; border-radius: 8px;"><i class="fa-solid fa-tag"></i> Saat ini belum ada kupon promo aktif. Pantau terus penawaran menarik berikutnya!</div>';
        return;
      }

      let html = '';
      activeList.forEach(p => {
        const diskonBadge = p.tipe === 'persen' ? `${p.nilai}% OFF` : `Hemat Rp ${Number(p.nilai).toLocaleString('id-ID')}`;
        html += `
          <div style="background: white; border: 1px dashed #FDBA74; border-radius: 10px; padding: 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
            <div>
              <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                <code style="font-size: 13px; font-weight: 800; color: var(--primary); letter-spacing: 0.5px;">${p.kode}</code>
                <span style="background: #ECFDF5; color: #059669; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">${diskonBadge}</span>
              </div>
              <div style="font-size: 11px; color: var(--text-gray);">${p.deskripsi || 'Promo spesial liburan'}</div>
            </div>
            <button onclick="salinKuponProfil('${p.kode}')" style="background: #FFF7ED; color: var(--primary); border: 1px solid #FFEDD5; border-radius: 6px; padding: 6px 10px; cursor: pointer; font-size: 12px; font-weight: 700; white-space: nowrap;" title="Salin kode">
              <i class="fa-regular fa-copy"></i> Salin
            </button>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    window.salinKuponProfil = function(kode) {
      navigator.clipboard.writeText(kode).then(() => {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: `Kode "${kode}" Disalin!`,
          showConfirmButton: false,
          timer: 1500
        });
      });
    };
  </script>

  <BottomNav current="profile" />
