<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atur Ulang Kata Sandi - Kamawak.id</title>
  <meta name="description" content="Atur ulang kata sandi akun Kamawak.id Anda.">
  <link rel="canonical" href="https://kamawak.id/atur-sandi">

  <!-- Google Search Favicons & Browser Modern -->
  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=3">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=3">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3">
  <link rel="shortcut icon" href="/favicon.ico?v=3">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://kamawak.id/atur-sandi">
  <meta property="og:title" content="Masuk & Daftar Akun - Kamawak.id">
  <meta property="og:description" content="Masuk ke akun Kamawak Anda untuk menikmati promo liburan dan kemudahan reservasi di Sumatera Barat.">
  <meta property="og:image" content="https://kamawak.id/kamawak-og-image.jpg">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style is:inline>
    :root { --primary: #FF5E1F; --bg-color: #F5F7FA; --text-dark: #1C2430; --text-gray: #6B7280; --white: #FFFFFF; --shadow: 0 10px 30px rgba(0,0,0,0.1); --radius: 16px; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: url('https://images.unsplash.com/photo-1574958269340-fa927503f3cb?w=1200') center/cover; color: var(--text-dark); display: flex; align-items: center; justify-content: center; min-height: 100vh; position: relative; padding: 20px; }
    .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(rgba(28, 36, 48, 0.7), rgba(255, 94, 31, 0.6)); z-index: 1; }
    
    .auth-card { background: var(--white); padding: 40px; border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; max-width: 450px; text-align: center; position: relative; z-index: 2; border-top: 6px solid var(--primary); max-height: 90vh; overflow-y: auto; }
    .auth-card::-webkit-scrollbar { width: 6px; }
    .auth-card::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 10px; }

    .logo { font-family: 'Poppins', sans-serif; font-size: 32px; font-weight: 700; color: var(--primary); margin-bottom: 8px; display: block; text-decoration: none; }
    .auth-card p { color: var(--text-gray); margin-bottom: 25px; font-size: 14px; line-height: 1.5; }
    
    .form-group { text-align: left; margin-bottom: 15px; position: relative; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text-dark); }
    .input-wrapper { position: relative; display: flex; align-items: center; }
    .input-wrapper i.icon-left { position: absolute; left: 15px; color: var(--text-gray); font-size: 15px; }
    
    .form-control { width: 100%; padding: 12px 15px 12px 42px; border: 1px solid #E5E7EB; border-radius: 10px; font-size: 14px; outline: none; transition: 0.3s; background: #F9FAFB; color: var(--text-dark); }
    .form-control:focus { border-color: var(--primary); background: var(--white); box-shadow: 0 0 0 4px rgba(255, 94, 31, 0.1); }
    
    .otp-input { text-align: center; font-size: 24px; letter-spacing: 10px; font-weight: 700; padding: 15px; }
    
    .eye-btn { position: absolute; right: 15px; color: var(--text-gray); cursor: pointer; padding: 5px; font-size: 16px; transition: 0.2s; }
    .eye-btn:hover { color: var(--primary); }

    .btn-submit { background: var(--primary); color: var(--white); border: none; padding: 14px; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 15px; width: 100%; transition: 0.3s; margin-top: 10px; box-shadow: 0 4px 15px rgba(255, 94, 31, 0.3); }
    .btn-submit:hover { background: #E04D14; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 94, 31, 0.4); }
    
    .loading-text { color: var(--primary); font-weight: 600; display: none; margin-top: 20px; font-size: 14px; }
    .msg-box { padding: 12px; border-radius: 8px; font-weight: 600; display: none; margin-top: 20px; font-size: 13px; }
    .msg-error { background: #FEE2E2; color: #DC2626; border: 1px solid #FCA5A5; }
    .msg-success { background: #D1FAE5; color: #059669; border: 1px solid #6EE7B7; }
    
    .footer-link { margin-top: 25px; font-size: 13px; color: var(--text-gray); }
    .footer-link a { color: var(--primary); text-decoration: none; font-weight: 600; cursor: pointer; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    
    /* ANIMASI TAMBAHAN */
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .auth-card { animation: fadeIn 0.4s ease-out; }

    /* RESPONSIVE DESIGN (MOBILE) */
    @media (max-width: 768px) {
        .split-layout { grid-template-columns: 1fr; }
        .brand-panel { display: none; }
        .login-panel { padding: 30px 20px; align-items: flex-start; }
        .login-box { max-width: 100%; padding: 0; }
        .form-row { grid-template-columns: 1fr; gap: 10px; }
    }
  </style>
</head>
<body>
  <div class="overlay"></div>

  <!-- KARTU 1: MINTA TAUTAN ATUR ULANG -->
  <div class="auth-card" id="cardMinta">
    <a href="/" class="logo">Kamawak.</a>
    <p>Atur Ulang Kata Sandi<br>Masukkan email akun Anda. Kami kirim tautan untuk membuat sandi baru.</p>

    <div class="form-group">
      <label>Alamat Email</label>
      <div class="input-wrapper">
        <i class="fa-solid fa-envelope icon-left"></i>
        <input type="email" id="resetEmail" class="form-control" placeholder="email@anda.com" onkeypress="if(event.key === 'Enter') kirimTautan()">
      </div>
    </div>

    <button class="btn-submit" id="btnKirimTautan" onclick="kirimTautan()">Kirim Tautan</button>
    <div id="loadingMinta" class="loading-text"><i class="fa-solid fa-spinner fa-spin"></i> Mengirim tautan...</div>
    <div id="msgMinta" class="msg-box"><i class="fa-solid fa-circle-info"></i> <span id="txtMinta"></span></div>

    <div class="footer-link">Ingat sandi Anda? <a href="/login">Masuk di sini</a></div>
  </div>

  <!-- KARTU 2: BUAT SANDI BARU (muncul setelah membuka tautan dari email) -->
  <div class="auth-card" id="cardBaru" style="display:none;">
    <a href="/" class="logo">Kamawak.</a>
    <p>Buat Kata Sandi Baru<br>Minimal 6 karakter.</p>

    <div class="form-group">
      <label>Kata Sandi Baru</label>
      <div class="input-wrapper">
        <i class="fa-solid fa-lock icon-left"></i>
        <input type="password" id="sandiBaru" class="form-control" placeholder="Sandi baru">
        <i class="fa-solid fa-eye-slash eye-btn" id="eyeBaru" onclick="togglePass('sandiBaru', 'eyeBaru')"></i>
      </div>
    </div>
    <div class="form-group">
      <label>Ulangi Kata Sandi</label>
      <div class="input-wrapper">
        <i class="fa-solid fa-check-double icon-left"></i>
        <input type="password" id="sandiKonfirmasi" class="form-control" placeholder="Ulangi sandi" onkeypress="if(event.key === 'Enter') simpanSandiBaru()">
        <i class="fa-solid fa-eye-slash eye-btn" id="eyeKonfirmasi" onclick="togglePass('sandiKonfirmasi', 'eyeKonfirmasi')"></i>
      </div>
    </div>

    <button class="btn-submit" id="btnSimpanBaru" onclick="simpanSandiBaru()">Simpan Sandi Baru</button>
    <div id="loadingBaru" class="loading-text"><i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...</div>
    <div id="msgBaru" class="msg-box"><i class="fa-solid fa-circle-info"></i> <span id="txtBaru"></span></div>
  </div>

  <script>
    import { supabase, keluarAkun } from '../lib/supabase.js';

    function tampil(idMsg, idTxt, teks, ok) {
      let box = document.getElementById(idMsg);
      document.getElementById(idTxt).innerText = teks;
      box.className = "msg-box " + (ok ? "msg-success" : "msg-error");
      box.style.display = "block";
    }

    window.togglePass = function(inputId, iconId) {
      let ipt = document.getElementById(inputId); let icn = document.getElementById(iconId);
      if(ipt.type === "password") { ipt.type = "text"; icn.className = "fa-solid fa-eye eye-btn"; }
      else { ipt.type = "password"; icn.className = "fa-solid fa-eye-slash eye-btn"; }
    };

    function tampilkanKartuBaru() {
      document.getElementById('cardMinta').style.display = 'none';
      document.getElementById('cardBaru').style.display = 'block';
    }

    // Tautan dari email membawa token pemulihan: Auth memicu PASSWORD_RECOVERY dan membuat sesi sementara.
    supabase.auth.onAuthStateChange((event) => {
      if (event === 'PASSWORD_RECOVERY') tampilkanKartuBaru();
    });
    if (/type=recovery/.test(window.location.hash)) tampilkanKartuBaru();

    window.kirimTautan = async function() {
      let email = document.getElementById('resetEmail').value.trim();
      let btn = document.getElementById('btnKirimTautan');
      let loader = document.getElementById('loadingMinta');
      if (!email || email.indexOf('@') === -1) { tampil('msgMinta', 'txtMinta', 'Masukkan alamat email yang valid.', false); return; }
      btn.style.display = 'none'; loader.style.display = 'block';
      document.getElementById('msgMinta').style.display = 'none';
      try {
        const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: window.location.origin + '/atur-sandi' });
        loader.style.display = 'none'; btn.style.display = 'block';
        if (error) {
          tampil('msgMinta', 'txtMinta', 'Gagal mengirim tautan: ' + (error.message || 'coba lagi beberapa saat.'), false);
          return;
        }
        // Pesan sama untuk email terdaftar atau tidak (tidak membocorkan akun).
        tampil('msgMinta', 'txtMinta', 'Jika email terdaftar, tautan atur ulang sandi sudah dikirim. Cek kotak masuk atau folder Spam.', true);
      } catch (e) {
        loader.style.display = 'none'; btn.style.display = 'block';
        tampil('msgMinta', 'txtMinta', 'Terjadi gangguan jaringan. Coba lagi.', false);
      }
    };

    window.simpanSandiBaru = async function() {
      let p1 = document.getElementById('sandiBaru').value;
      let p2 = document.getElementById('sandiKonfirmasi').value;
      let btn = document.getElementById('btnSimpanBaru');
      let loader = document.getElementById('loadingBaru');
      if (!p1 || p1.length < 6) { tampil('msgBaru', 'txtBaru', 'Kata sandi baru minimal 6 karakter.', false); return; }
      if (p1 !== p2) { tampil('msgBaru', 'txtBaru', 'Konfirmasi kata sandi tidak cocok.', false); return; }
      btn.style.display = 'none'; loader.style.display = 'block';
      document.getElementById('msgBaru').style.display = 'none';
      try {
        const { error } = await supabase.auth.updateUser({ password: p1 });
        loader.style.display = 'none'; btn.style.display = 'block';
        if (error) { tampil('msgBaru', 'txtBaru', 'Gagal menyimpan: ' + (error.message || 'tautan mungkin kedaluwarsa, minta tautan baru.'), false); return; }
        tampil('msgBaru', 'txtBaru', 'Sandi berhasil diubah. Silakan masuk dengan sandi baru.', true);
        // Akhiri sesi pemulihan agar pengguna masuk ulang secara normal.
        await keluarAkun();
        setTimeout(() => { window.location.href = '/login'; }, 1800);
      } catch (e) {
        loader.style.display = 'none'; btn.style.display = 'block';
        tampil('msgBaru', 'txtBaru', 'Terjadi gangguan jaringan. Coba lagi.', false);
      }
    };
</script>
</body>
</html>
