    function filterMitra(kriteria) {
      // Update Button Styles
      ['Semua', 'Pending', 'Kadaluarsa'].forEach(k => {
        let btn = document.getElementById('btnFilter' + k);
        if (btn) {
           btn.style.background = (k === kriteria) ? 'var(--primary)' : '#F3F4F6';
           btn.style.color = (k === kriteria) ? 'white' : 'var(--text-dark)';
        }
      });
      
      let tbody = document.getElementById('tableMitraBody');
      tbody.innerHTML = "";
      
      let filteredData = window.allMitraData || [];
      if (kriteria === 'Pending') {
         filteredData = filteredData.filter(item => String(item.status).toLowerCase().includes('pending'));
      } else if (kriteria === 'Kadaluarsa') {
         filteredData = filteredData.filter(item => String(item.status).toLowerCase().includes('kadaluarsa') || String(item.status).toLowerCase().includes('nonaktif'));
      }
      
      if (filteredData.length > 0) {
         filteredData.forEach(function(item) {
            let badgeClass = String(item.status).toLowerCase().includes('aktif') ? 'badge-aktif' : 'badge-nonaktif';
            if(String(item.status).toLowerCase().includes('pending')) badgeClass = 'badge-warning'; // Asumsi badge-warning tidak ada di css tapi fallback ke default atau kita kasih inline
            let badgeStyle = String(item.status).toLowerCase().includes('pending') ? 'background:#FEF3C7; color:#D97706; padding:4px 8px; border-radius:4px; font-weight:600; font-size:12px;' : '';
            
            let spanHtml = badgeStyle ? '<span style="' + badgeStyle + '">' + item.status + '</span>' : '<span class="' + badgeClass + '">' + item.status + '</span>';
            
            let waNumber = item.wa ? String(item.wa).replace(/\D/g,'') : '';
            if (waNumber.startsWith('0')) waNumber = '62' + waNumber.substring(1);
            let waBtnHtml = '';
            if (waNumber) {
                let pesan = 'Halo Owner *' + item.nama + '*\\n\\nKami dari Admin ingin mengirimkan laporan Leads (klik) ke bisnis Anda selama ini:\\n✅ *Total Klik: ' + (item.leads || 0) + '*\\n(WA: ' + (item.leads_wa || 0) + ', IG: ' + (item.leads_ig || 0) + ', TikTok: ' + (item.leads_tiktok || 0) + ', FB: ' + (item.leads_fb || 0) + ')\\n\\nMengingat status langganan Anda saat ini: *' + item.status + '*, apakah Anda ingin melanjutkan langganan untuk menjaga visibilitas bisnis Anda?';
                let waUrl = 'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(pesan);
                waBtnHtml = '<div style="margin-top:8px;"><a href="' + waUrl + '" target="_blank" onclick="event.stopPropagation();" style="display:inline-block; background:#25D366; color:white; padding:4px 8px; border-radius:4px; font-size:11px; text-decoration:none;"><i class="fa-brands fa-whatsapp"></i> Chat WA</a></div>';
            }
            
            spanHtml += waBtnHtml;
            
            let tr = document.createElement('tr');
            tr.innerHTML = 
              '<td style="font-weight: 600; color: var(--text-dark);">' + item.id + '</td>' +
              '<td>' + item.nama + '</td>' +
              '<td>' + item.kategori + '</td>' +
              '<td>' +
                '<div style="font-size:12px; line-height:1.5;">' +
                  '<span style="display:inline-block; width:45px;"><i class="fa-brands fa-whatsapp" style="color:#25D366;"></i> WA</span>: <b>' + (item.leads_wa || 0) + '</b><br>' +
                  '<span style="display:inline-block; width:45px;"><i class="fa-brands fa-instagram" style="color:#E1306C;"></i> IG</span>: <b>' + (item.leads_ig || 0) + '</b><br>' +
                  '<span style="display:inline-block; width:45px;"><i class="fa-brands fa-tiktok" style="color:#000;"></i> TT</span>: <b>' + (item.leads_tiktok || 0) + '</b><br>' +
                  '<span style="display:inline-block; width:45px;"><i class="fa-brands fa-facebook" style="color:#1877F2;"></i> FB</span>: <b>' + (item.leads_fb || 0) + '</b>' +
                '</div>' +
                '<div style="margin-top:4px; font-weight:bold; font-size:13px; color:#FF5E1F;">' +
                  '<i class="fa-solid fa-fire"></i> Total: ' + (item.leads || 0) +
                '</div>' +
              '</td>' +
              '<td>' + spanHtml + '</td>';
            tr.style.cursor = "pointer";
            tr.onclick = function() {
              document.getElementById('cmsID').value = item.id || '';
              document.getElementById('cmsNama').value = item.nama || '';
              
              // Set Kategori if exists in dropdown
              let selKat = document.getElementById('cmsKategori');
              let katVal = item.kategori || 'Penginapan';
              let opts = Array.from(selKat.options).map(o => o.value);
              if(!opts.includes(katVal)) {
                  let opt = document.createElement('option');
                  opt.value = katVal; opt.text = katVal;
                  selKat.appendChild(opt);
              }
              selKat.value = katVal;
              
              document.getElementById('cmsDestinasi').value = item.lokasi || '';
              document.getElementById('cmsHarga').value = item.harga || '';
              document.getElementById('cmsDeskripsi').value = item.deskripsi || '';
              document.getElementById('cmsFasilitas').value = item.fasilitas || '';
              document.getElementById('cmsWA').value = item.wa || '';
              document.getElementById('cmsDurasi').value = item.durasi || '';
              
              let statusEl = document.getElementById('cmsStatusLangganan');
              if (statusEl) {
                 statusEl.value = item.status === 'Pending' ? 'Pending' : (item.status === 'Aktif' ? 'Aktif' : 'Nonaktif');
              }
              
              switchTab('tabCMS');
              window.scrollTo({ top: 0, behavior: 'smooth' });
            };
            tbody.appendChild(tr);
         });
      } else {
         tbody.innerHTML = '<tr><td colspan="4" style="text-align: center;">Tidak ada data mitra untuk kategori ini.</td></tr>';
      }
    }

    
