    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: '#EC4899',
    cancelButtonColor: '#6B7280',
    confirmButtonText: 'Ya, Reset',
    cancelButtonText: 'Batal'
  }).then((res) => {
    if (res.isConfirmed) {
      let list = [...KARTU_KOTA_DEFAULT];
      simpanDaftarPintasanServer(list, "Berhasil direset ke 7 kota standar Sumbar!");
      window.batalEditTag();
