  <script is:inline>
    const BASE_URL = "";

    window.onload = function() {
      // Sinkronisasi Sesi dari URL
      let urlUser = new URLSearchParams(window.location.search).get("u") || localStorage.getItem("kamawak_user") || "";
      let urlRole = new URLSearchParams(window.location.search).get("r") || localStorage.getItem("kamawak_role") || "";
      if(urlUser && urlRole && urlUser !== "") {
         localStorage.setItem("kamawak_user", urlUser);
         localStorage.setItem("kamawak_role", urlRole);
         
      }

      let role = localStorage.getItem("kamawak_role");
      if (!role || role.toLowerCase() !== "admin") {
        window.location.href = "/login";
        return;
      }
      
      
      document.getElementById("adminName").innerText = "Halo, " + localStorage.getItem("kamawak_user");
      
      muatStatistikGlobal();
      muatDaftarMitra();
    };

    
    function ubahOpsiKas() {
       let jenis = document.getElementById('kasJenis').value;
       let kat = document.getElementById('kasKategori');
       if(jenis === 'Pemasukan') {
          kat.innerHTML = '<option value="Langganan Mitra">Langganan Mitra</option><option value="Komisi OTA">Komisi OTA / Platform</option><option value="Pemasukan Lainnya">Pemasukan Lainnya</option>';
       } else {
          kat.innerHTML = '<option value="Biaya Operasional">Biaya Operasional (Server/Domain)</option><option value="Biaya Pemasaran">Biaya Pemasaran (Iklan)</option><option value="Gaji & Fee">Gaji & Fee Karyawan</option><option value="Pengeluaran Lainnya">Pengeluaran Lainnya</option>';
       }
    }

    function muatBukuKas() {
      document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat buku kas...</td></tr>';
      google.script.run
        .withFailureHandler(function(e){ document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Server Error: '+e+'</td></tr>'; }).withSuccessHandler(function(resString) {
           try {
             let res = JSON.parse(resString);
             if(!res.success) { 
               document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">'+res.error+'</td></tr>'; 
               return; 
             }
             
             // Update Cards
             document.getElementById('valKasMasuk').innerText = formatUang(res.totalPemasukan);
             document.getElementById('valKasKeluar').innerText = formatUang(res.totalPengeluaran);
             document.getElementById('valKasSaldo').innerText = formatUang(res.saldo);
             
             // Update Laporan Laba Rugi
             document.getElementById('lrLangganan').innerText = formatUang(res.rekap.pendapatan.langganan);
             document.getElementById('lrOTA').innerText = formatUang(res.rekap.pendapatan.ota);
             document.getElementById('lrLainP').innerText = formatUang(res.rekap.pendapatan.lainnya);
             document.getElementById('lrTotalP').innerText = formatUang(res.totalPemasukan);
             
             document.getElementById('lrOpr').innerText = formatUang(res.rekap.beban.operasional);
             document.getElementById('lrMar').innerText = formatUang(res.rekap.beban.marketing);
             document.getElementById('lrGaji').innerText = formatUang(res.rekap.beban.gaji);
             document.getElementById('lrLainB').innerText = formatUang(res.rekap.beban.lainnya);
             document.getElementById('lrTotalB').innerText = formatUang(res.totalPengeluaran);
             
             document.getElementById('lrNet').innerText = formatUang(res.saldo);

             // Update Table
             let htmlStr = "";
             if(res.data.length === 0) {
                 htmlStr = '<tr><td colspan="6" style="text-align:center;">Belum ada catatan kas.</td></tr>';
             } else {
                 res.data.forEach(item => {
                    let color = item.jenis === "Pemasukan" ? "#10B981" : "#EF4444";
                    let sign = item.jenis === "Pemasukan" ? "+" : "-";
                    htmlStr += '<tr>' +
                      '<td style="font-size:13px; color:var(--text-gray);">' + item.tgl + '</td>' +
                      '<td><span style="background:' + color + '20; color:' + color + '; padding:4px 8px; border-radius:4px; font-size:12px; font-weight:600;">' + item.jenis + '</span></td>' +
                      '<td style="font-size:13px;">' + item.kategori + '</td>' +
                      '<td style="font-size:13px; font-weight:500; color:var(--text-dark);">' + item.keterangan + '</td>' +
                      '<td style="font-weight:bold; color:' + color + ';">' + sign + ' ' + formatUang(item.nominal) + '</td>' +
                      '<td><button onclick="hapusKas(\'' + item.id + '\')" style="background:none; border:none; color:#EF4444; cursor:pointer;"><i class="fa-solid fa-trash"></i></button></td>' +
                    '</tr>';
                 });
             }
             document.getElementById('tableKasBody').innerHTML = htmlStr;
           } catch(e) {
             document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Error parsing data.</td></tr>';
           }
        })
        .getBukuKasAdmin();
    }

    function simpanBukuKas() {
       let payload = {
          jenis: document.getElementById('kasJenis').value,
          kategori: document.getElementById('kasKategori').value,
          keterangan: document.getElementById('kasKet').value,
          nominal: document.getElementById('kasNominal').value
       };
       if(!payload.keterangan || !payload.nominal) { Swal.fire('Error', 'Lengkapi form!', 'error'); return; }
       
       document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...</td></tr>';
       google.script.run
         .withSuccessHandler(function(resString){
             let res = JSON.parse(resString);
             if(res.success) {
                 Swal.fire('Tersimpan', 'Kas berhasil dicatat!', 'success');
                 document.getElementById('kasKet').value = ""; document.getElementById('kasNominal').value = "";
                 muatBukuKas();
             } else {
                 Swal.fire('Gagal', res.error, 'error');
             }
         })
         .tambahBukuKasAdmin(payload);
    }

    function hapusKas(idKas) {
       Swal.fire({
          title: 'Hapus Transaksi?', text: "Data tidak bisa dikembalikan!", icon: 'warning',
          showCancelButton: true, confirmButtonColor: '#EF4444', confirmButtonText: 'Ya, hapus!'
       }).then((result) => {
          if(result.isConfirmed) {
              document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Menghapus...</td></tr>';
              google.script.run
                .withSuccessHandler(function(resStr){ muatBukuKas(); })
                .hapusBukuKasAdmin(idKas);
          }
       });
    }

    function switchTab(tabId) {
      ['Dashboard', 'CMS', 'Transaksi', 'Keuangan', 'Users', 'Ads', 'Tags', 'Pengaturan', 'Composer'].forEach(t => {
        let el = document.getElementById('tab' + t); if(el) el.style.display = 'none';
        let btn = document.getElementById('btnTab' + t); if(btn) { btn.style.background = '#F3F4F6'; btn.style.color = 'var(--text-dark)'; }
      });
      
      document.getElementById(tabId).style.display = 'block';
      document.getElementById('btn' + tabId.charAt(0).toUpperCase() + tabId.slice(1)).style.background = 'var(--primary)';
      document.getElementById('btn' + tabId.charAt(0).toUpperCase() + tabId.slice(1)).style.color = 'white';
      if(tabId === 'tabTransaksi') { muatTransaksi(); muatPayoutRequests(); }
      if(tabId === 'tabKeuangan') muatBukuKas();
      if(tabId === 'tabUsers') muatDaftarPengguna();
      if(tabId === 'tabAds') muatDaftarIklan();
      if(tabId === 'tabTags') muatDaftarTag();
      if(tabId === 'tabComposer') { muatLayout(); muatDaftarTag(); }
      if(tabId === 'tabPengaturan') muatPengaturan();
    }

