window.toggleFacilityTag = function(namaFasilitas, btn) {
  let textarea = document.getElementById('cmsFasilitas');
  if (!textarea) return;
  let list = textarea.value.split(',').map(s => s.trim()).filter(Boolean);
  let idx = list.findIndex(s => s.toLowerCase() === namaFasilitas.toLowerCase());
  if (idx > -1) {
    list.splice(idx, 1);
    if (btn) btn.classList.remove('active');
  } else {
    list.push(namaFasilitas);
    if (btn) btn.classList.add('active');
  }
  textarea.value = list.join(', ');
  if (window.updateFacilityTagHighlights) window.updateFacilityTagHighlights();
  if (window.updateCardPreviewLanding) window.updateCardPreviewLanding();
};

window.updateFacilityTagHighlights = function() {
  let textarea = document.getElementById('cmsFasilitas');
  if (!textarea) return;
  let list = textarea.value.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
  document.querySelectorAll('.btn-facility-tag').forEach(btn => {
    let txt = btn.innerText.trim().toLowerCase();
    let isMatched = list.some(item => txt.includes(item) || item.includes(txt));
    if (isMatched) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });
};

window.updateCardPreviewLanding = function() {
  let nama = document.getElementById('cmsNama') ? document.getElementById('cmsNama').value.trim() : '';
  let harga = document.getElementById('cmsHarga') ? document.getElementById('cmsHarga').value.trim() : '';
