window.simpanMitraBaru = async function() {
  let namaUsaha = document.getElementById('mitraNamaUsahaInput').value.trim();
  let kategori = document.getElementById('mitraKategoriInput').value;
  let status = document.getElementById('mitraStatusInput').value;
  let owner = document.getElementById('mitraOwnerInput').value.trim();
  let wa = document.getElementById('mitraWaInput').value.trim();
  let lokasi = document.getElementById('mitraLokasiInput').value.trim();

  if (!namaUsaha || !kategori || !owner || !wa) {
    Swal.fire('Perhatian', 'Nama Usaha, Kategori, Pemilik, dan WhatsApp wajib diisi!', 'warning');
    return;
  }

  let btn = document.getElementById('btnSimpanMitraBaru');
  btn.innerText = "Menyimpan...";
  btn.disabled = true;

  try {
    let payload = {
      nama: namaUsaha,
      kategori: kategori,
      lokasi: lokasi || 'Sumatera Barat',
      harga: 0,
      owner: owner,
      status: status,
      wa: wa
    };

    const { data, error } = await supabase.from('wisata').insert([payload]).select();
    let savedId = (data && data[0]) ? data[0].id : ('local_mitra_' + Date.now());

    if (error) {
      if (error.code === '42501' || String(error.message).includes('row-level security')) {
        console.warn("RLS blocked insert, saving to local override:", error);
      } else {
        throw error;
      }
    }

    // Selalu simpan juga ke cache lokal override
    payload.id = savedId;
    localStorage.setItem('kamawak_override_' + savedId, JSON.stringify(payload));

    tutupModalTambahMitra();
    Swal.fire({
      icon: 'success',
      title: 'Mitra Berhasil Ditambahkan!',
      text: `Unit usaha "${namaUsaha}" telah didaftarkan sebagai mitra Kamawak.`,
      timer: 2000,
      showConfirmButton: false
    });

    muatDaftarMitra();
    muatStatistikGlobal();
  } catch(e) {
    Swal.fire('Gagal Menambah Mitra', e.message, 'error');
  } finally {
    btn.innerText = "Simpan Mitra";
    btn.disabled = false;
  }
};

window.muatDaftarMitra = async function() {
  let tbody = document.getElementById('tableMitraBody');
  if (tbody) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat daftar seluruh mitra...</td></tr>';
  }

  try {
    const { data: wisataData, error: errWisata } = await supabase.from('wisata').select('*').order('created_at', { ascending: false });
    const { data: usersData, error: errUsers } = await supabase.from('users').select('*');
    const { data: leadsData } = await supabase.from('leads').select('*');

    let deletedList = [];
    try { deletedList = JSON.parse(localStorage.getItem('kamawak_deleted_wisata') || '[]'); } catch(e){}

    let combined = [];

    // 1. Ambil unit usaha dari tabel wisata
    (wisataData || []).forEach(w => {
      if (deletedList.includes(w.id)) return;

      // Cek local override
      let override = null;
      try { override = JSON.parse(localStorage.getItem('kamawak_override_' + w.id) || 'null'); } catch(e){}
      let item = { ...w, ...(override || {}) };

      let linkedUser = (usersData || []).find(u => {
        let uNama = (u.nama || '').toLowerCase();
        let uEmail = (u.email || '').toLowerCase();
        let wOwner = (item.owner || '').toLowerCase();
        return (wOwner && (wOwner === uNama || wOwner === uEmail || wOwner === u.id));
      });

      let leadsCount = (leadsData || []).filter(l => {
        return l.id_wisata === item.id || 
               (l.nama_usaha && l.nama_usaha.toLowerCase() === (item.nama || '').toLowerCase()) ||
               (item.owner && l.owner && l.owner.toLowerCase() === item.owner.toLowerCase());
      }).length;

      let st = item.status || 'Aktif';
      if (st.toLowerCase() === 'nonaktif' || st.toLowerCase() === 'non-aktif') st = 'Nonaktif';

      let shortId = 'MTR-' + item.id.substring(0, 6).toUpperCase();

      combined.push({
        id: item.id,
        kode: shortId,
        nama_usaha: item.nama || 'Tanpa Nama',
        owner_name: item.owner && item.owner !== 'Admin' ? item.owner : (linkedUser ? linkedUser.nama : 'Admin / Mitra'),
        kategori: item.kategori || 'Penginapan',
        lokasi: item.lokasi || '-',
        wa: item.wa || (linkedUser ? linkedUser.wa : '') || '-',
        email: linkedUser ? linkedUser.email : '-',
        leads: leadsCount,
        status: st,
        source: 'wisata'
      });
    });

    // 2. Ambil juga pengguna dengan role Owner/Mitra atau status_langganan aktif yang belum ada di wisata
    (usersData || []).forEach(u => {
      let r = (u.role || '').toLowerCase();
      let hasStatus = u.status_langganan && u.status_langganan !== '';
      if ((r === 'owner' || r === 'mitra' || hasStatus) && r !== 'admin') {
        let alreadyInList = combined.some(c => c.owner_name.toLowerCase() === (u.nama || '').toLowerCase() || c.id === u.id);
        if (!alreadyInList) {
          let uLeads = (leadsData || []).filter(l => (l.owner && l.owner.toLowerCase() === (u.nama || '').toLowerCase()) || l.owner === u.id).length;
          let uStatus = u.status_langganan || 'Pending';
          combined.push({
            id: u.id,
            kode: 'USR-' + u.id.substring(0, 6).toUpperCase(),
            nama_usaha: u.nama + ' (Akun Mitra)',
            owner_name: u.nama,
            kategori: 'Mitra Terdaftar',
            lokasi: '-',
            wa: u.wa || '-',
            email: u.email || '-',
            leads: uLeads,
            status: uStatus,
            source: 'user'
          });
        }
      }
    });

    // 3. Tambahkan juga local mitra jika pernah disimpan saat offline/RLS
    try {
      for (let i = 0; i < localStorage.length; i++) {
        let key = localStorage.key(i);
        if (key && key.startsWith('kamawak_override_local_mitra_')) {
          let loc = JSON.parse(localStorage.getItem(key));
          if (loc && !deletedList.includes(loc.id) && !combined.some(c => c.id === loc.id)) {
            combined.unshift({
              id: loc.id,
              kode: 'MTR-' + loc.id.substring(loc.id.length - 6).toUpperCase(),
              nama_usaha: loc.nama,
              owner_name: loc.owner,
              kategori: loc.kategori || 'Penginapan',
              lokasi: loc.lokasi || '-',
              wa: loc.wa || '-',
              email: '-',
              leads: 0,
              status: loc.status || 'Aktif',
              source: 'local'
            });
          }
        }
      }
    } catch(e) {}

    window.dataMitraGlobal = combined;

    // Perbarui badge counter
    let totalAll = combined.length;
    let totalAktif = combined.filter(m => (m.status || '').toLowerCase() === 'aktif').length;
    let totalPending = combined.filter(m => (m.status || '').toLowerCase() === 'pending').length;
    let totalNonaktif = combined.filter(m => {
      let s = (m.status || '').toLowerCase();
      return s === 'nonaktif' || s === 'kadaluarsa' || s === 'non-aktif';
    }).length;

    let elSemua = document.getElementById('cntMitraSemua'); if (elSemua) elSemua.innerText = totalAll;
    let elAktif = document.getElementById('cntMitraAktif'); if (elAktif) elAktif.innerText = totalAktif;
    let elPending = document.getElementById('cntMitraPending'); if (elPending) elPending.innerText = totalPending;
    let elNonaktif = document.getElementById('cntMitraNonaktif'); if (elNonaktif) elNonaktif.innerText = totalNonaktif;

    let valM = document.getElementById('valMitra');
    if (valM) valM.innerText = totalAktif || totalAll;

    window.filterMitra(window.mitraFilterAktif || 'Semua');

  } catch(e) {
    console.error("Error muat daftar mitra:", e);
    if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="color:red; text-align:center; padding:20px;">Gagal memuat mitra: ${e.message}</td></tr>`;
  }
};

window.filterMitra = function(status) {
  window.mitraFilterAktif = status;
  let tbody = document.getElementById('tableMitraBody');
  if (!tbody) return;

  // Update styles tab filter
  ['btnFilterSemua', 'btnFilterAktif', 'btnFilterPending', 'btnFilterKadaluarsa'].forEach(bid => {
    let b = document.getElementById(bid);
    if (!b) return;
    b.style.background = '#F3F4F6';
    b.style.color = 'var(--text-dark)';
  });
  let activeBtn = document.getElementById(status === 'Semua' ? 'btnFilterSemua' : (status === 'Aktif' ? 'btnFilterAktif' : (status === 'Pending' ? 'btnFilterPending' : 'btnFilterKadaluarsa')));
  if (activeBtn) {
    activeBtn.style.background = 'var(--primary)';
    activeBtn.style.color = '#FFFFFF';
  }

  let filtered = window.dataMitraGlobal || [];
  if (status === 'Aktif') {
    filtered = filtered.filter(m => (m.status || '').toLowerCase() === 'aktif');
  } else if (status === 'Pending') {
    filtered = filtered.filter(m => (m.status || '').toLowerCase() === 'pending');
  } else if (status === 'Kadaluarsa') {
    filtered = filtered.filter(m => {
      let s = (m.status || '').toLowerCase();
      return s === 'kadaluarsa' || s === 'nonaktif' || s === 'non-aktif';
    });
  }

  let cariInput = document.getElementById('cariMitraInput');
  if (cariInput && cariInput.value.trim()) {
    let kw = cariInput.value.trim().toLowerCase();
    filtered = filtered.filter(m => {
      return (m.nama_usaha && m.nama_usaha.toLowerCase().includes(kw)) ||
             (m.owner_name && m.owner_name.toLowerCase().includes(kw)) ||
             (m.kategori && m.kategori.toLowerCase().includes(kw)) ||
             (m.wa && m.wa.toLowerCase().includes(kw)) ||
             (m.kode && m.kode.toLowerCase().includes(kw));
    });
  }

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 25px; color: var(--text-gray);">Tidak ada data mitra dengan filter ini.</td></tr>';
    return;
  }

  let html = "";
  filtered.forEach(m => {
    let st = (m.status || 'Aktif').toLowerCase();
    let badgeHtml = '';
    if (st === 'aktif') {
      badgeHtml = '<span style="background:#ECFDF5; color:#059669; padding:4px 10px; border-radius:20px; font-weight:700; font-size:11.5px; display:inline-flex; align-items:center; gap:5px;"><i class="fa-solid fa-circle-check"></i> Aktif</span>';
    } else if (st === 'pending') {
      badgeHtml = '<span style="background:#FFFBEB; color:#D97706; padding:4px 10px; border-radius:20px; font-weight:700; font-size:11.5px; display:inline-flex; align-items:center; gap:5px;"><i class="fa-solid fa-clock"></i> Menunggu</span>';
    } else {
      badgeHtml = '<span style="background:#FEF2F2; color:#DC2626; padding:4px 10px; border-radius:20px; font-weight:700; font-size:11.5px; display:inline-flex; align-items:center; gap:5px;"><i class="fa-solid fa-circle-xmark"></i> Nonaktif</span>';
    }

    let cleanWa = (m.wa || '').replace(/[^0-9]/g, '');
    if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.substring(1);
    let waHtml = cleanWa ? `
      <a href="https://wa.me/${cleanWa}?text=Halo%20${encodeURIComponent(m.nama_usaha)},%20kami%20dari%20Admin%20Kamawak" target="_blank" onclick="event.stopPropagation();" style="display:inline-flex; align-items:center; gap:5px; background:#ECFDF5; color:#059669; padding:4px 9px; border-radius:6px; font-size:12px; font-weight:600; text-decoration:none; border:1px solid #A7F3D0;">
        <i class="fa-brands fa-whatsapp"></i> ${m.wa}
      </a>
    ` : '<span style="color:#9CA3AF; font-size:12px;">-</span>';

    let nextToggleStatus = st === 'aktif' ? 'Nonaktif' : 'Aktif';
    let toggleIcon = st === 'aktif' ? '<i class="fa-solid fa-ban"></i>' : '<i class="fa-solid fa-check"></i>';
    let toggleBg = st === 'aktif' ? '#EF4444' : '#10B981';
    let toggleTitle = st === 'aktif' ? 'Nonaktifkan Mitra' : 'Aktifkan Mitra';

    html += `
      <tr onclick="pilihMitraDariTabel('${m.id}', '${m.status}')" style="cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#FFF7ED'" onmouseout="this.style.background='white'">
        <td style="font-family: monospace; font-size: 12px; font-weight: 700; color: #475569;">
          <span style="background:#F1F5F9; padding:3px 7px; border-radius:4px; border:1px solid #CBD5E1;">${m.kode}</span>
        </td>
        <td>
          <div style="font-weight: 700; font-size: 13.5px; color: var(--text-dark);">${m.nama_usaha}</div>
          <div style="font-size: 11.5px; color: var(--text-gray); margin-top: 2px;">
            <i class="fa-solid fa-user"></i> ${m.owner_name}
          </div>
        </td>
        <td>
          <span style="background:#FFF7ED; color:var(--primary); padding:3px 8px; border-radius:6px; font-size:11.5px; font-weight:600;">${m.kategori}</span>
          <div style="font-size: 11.5px; color: var(--text-gray); margin-top: 2px;">${m.lokasi}</div>
        </td>
        <td>${waHtml}</td>
        <td>
          <span style="font-weight: 700; font-size: 13px; color: var(--primary);">${m.leads} Klik</span>
        </td>
        <td>${badgeHtml}</td>
        <td style="text-align: center; white-space: nowrap;">
          <button onclick="event.stopPropagation(); pilihMitraDariTabel('${m.id}', '${m.status}')" style="background:#3B82F6; color:white; border:none; padding:5px 8px; border-radius:6px; font-size:11.5px; cursor:pointer; margin-right:4px;" title="Pilih & Edit Status">
            <i class="fa-solid fa-pencil"></i>
          </button>
          <button onclick="event.stopPropagation(); prosesUpdateStatus('${m.id}', '${nextToggleStatus}')" style="background:${toggleBg}; color:white; border:none; padding:5px 8px; border-radius:6px; font-size:11.5px; cursor:pointer; margin-right:4px;" title="${toggleTitle}">
            ${toggleIcon}
          </button>
          ${m.source === 'wisata' ? `
            <a href="/pdp?id=${m.id}" target="_blank" onclick="event.stopPropagation();" style="background:#10B981; color:white; border:none; padding:5px 8px; border-radius:6px; font-size:11.5px; text-decoration:none; display:inline-block;" title="Lihat di Halaman PDP">
              <i class="fa-solid fa-eye"></i>
            </a>
          ` : ''}
        </td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
};

