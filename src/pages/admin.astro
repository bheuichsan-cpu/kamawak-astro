window.pilihMitraDariTabel = function(id, status) {
  let inputID = document.getElementById('inputIDMitra');
  let selStatus = document.getElementById('selectStatus');
  let info = document.getElementById('statusInfo');

  if (inputID) inputID.value = id;
  if (selStatus) selStatus.value = (status === 'Nonaktif' || status === 'Kadaluarsa') ? status : (status || 'Aktif');

  let target = (window.dataMitraGlobal || []).find(m => m.id === id);
  let namaUsaha = target ? target.nama_usaha : id;

  if (info) {
    info.innerHTML = `<span style="color:var(--primary);"><i class="fa-solid fa-circle-info"></i> Mitra <b>${namaUsaha}</b> dipilih. Silakan pilih status baru di atas lalu klik <b>Perbarui Status</b>.</span>`;
  }

  let card = document.getElementById('inputIDMitra');
  if (card) {
    let top = card.getBoundingClientRect().top + window.pageYOffset - 120;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
};

window.prosesUpdateStatus = async function(idOverride, statusOverride) {
  let id = idOverride || (document.getElementById('inputIDMitra') ? document.getElementById('inputIDMitra').value.trim() : '');
  let status = statusOverride || (document.getElementById('selectStatus') ? document.getElementById('selectStatus').value : 'Aktif');
  let info = document.getElementById('statusInfo');

  if (!id) {
    Swal.fire('Perhatian', 'Pilih atau ketik ID Mitra terlebih dahulu dari tabel.', 'warning');
    return;
  }

  if (info) { info.innerText = "Memperbarui status..."; info.style.color = "#3B82F6"; }

  try {
    let target = (window.dataMitraGlobal || []).find(m => m.id === id || m.kode === id);
    let targetId = target ? target.id : id;
    let targetNama = target ? target.nama_usaha : id;

    // 1. Coba update di tabel wisata
    const { data: wData, error: wErr } = await supabase.from('wisata').update({ status: status }).eq('id', targetId).select();
    
    // Simpan juga ke override lokal agar langsung terlihat di beranda & PDP
    try {
      let currentOv = JSON.parse(localStorage.getItem('kamawak_override_' + targetId) || '{}');
      currentOv.status = status;
      localStorage.setItem('kamawak_override_' + targetId, JSON.stringify(currentOv));
    } catch(e) {}

    // 2. Coba juga update di tabel users jika akunnya terdaftar
    try {
      await supabase.from('users').update({ status_langganan: status }).or(`id.eq.${targetId},email.eq.${targetId},nama.eq.${targetId}`);
    } catch(eU) {}

    if (info) {
      info.innerHTML = `<span style="color:#10B981;"><i class="fa-solid fa-circle-check"></i> Status <b>${targetNama}</b> berhasil diubah menjadi <b>${status}</b>!</span>`;
    }

    Swal.fire({
      icon: 'success',
      title: 'Status Diperbarui!',
      text: `Status kemitraan "${targetNama}" berhasil diubah menjadi ${status}.`,
      timer: 1800,
      showConfirmButton: false
    });

    muatDaftarMitra();
    muatStatistikGlobal();

  } catch(e) {
    if (info) { info.innerText = "Gagal: " + e.message; info.style.color = "#EF4444"; }
    Swal.fire('Gagal', e.message, 'error');
  }
};

async function muatTransaksi() {
  let tbody = document.getElementById('tableTrxBody');
  try {
    const { data, error } = await supabase.from('transaksi').select('*').order('created_at', { ascending: false });
    if (error) throw error;
    if (!data || data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada transaksi.</td></tr>';
        return;
    }
    
    let html = "";
    data.forEach(t => {
        html += `<tr>
           <td>${t.created_at || t.tanggal}</td>
           <td>${t.id}</td>
           <td>${t.namaProduk || '-'}</td>
           <td>${t.owner || '-'}</td>
           <td>Rp ${Number(t.totalBayar||0).toLocaleString('id-ID')}</td>
        </tr>`;
    });
    tbody.innerHTML = html;
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="5" style="color:red;text-align:center;">Error memuat trx: ${e.message || JSON.stringify(e)}</td></tr>`; console.error('Trx err:', e);
  }
}

async function muatDaftarPengguna() {
  let tbody = document.getElementById('tableUsersBody');
  try {
     const { data, error } = await supabase.from('users').select('*');
     if (error) throw error;
     
     if(!data || data.length === 0) { tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;">Belum ada pengguna (Tabel kosong)</td></tr>'; return; }
     let html = "";
     data.forEach(u => {
        let bg = u.role === 'Admin' ? 'background:#8B5CF6;color:white' : (u.role === 'Owner' ? 'background:#F59E0B;color:white' : 'background:#E5E7EB;color:black');
        html += `<tr onclick="document.getElementById('inputEmailUser').value='${u.email}'" style="cursor:pointer;">
           <td>${u.nama}</td>
           <td>${u.email}</td>
           <td><span style="padding:4px 10px;border-radius:15px;font-size:12px;${bg}">${u.role}</span></td>
        </tr>`;
     });
     tbody.innerHTML = html;
  } catch(e) {
     tbody.innerHTML = `<tr><td colspan="3" style="color:red;">Error memuat user: ${e.message || JSON.stringify(e)}</td></tr>`; console.error('Users err:', e);
  }
}

window.prosesUpdateRole = async function() {
  let email = document.getElementById('inputEmailUser').value;
  let role = document.getElementById('selectRole').value;
  let info = document.getElementById('roleInfo');
  
  if(!email) return;
  info.innerText = "Memperbarui...";
  
  const { error } = await supabase.from('users').update({ role: role }).eq('email', email);
  if (!error) {
     info.innerText = "Berhasil update role!";
     info.style.color = "green";
     muatDaftarPengguna();
  } else {
     info.innerText = "Gagal!";
  }
};

