window.previewProfLogo = function(url) {
  let img = document.getElementById('imgProfLogo');
  let txt = document.getElementById('txtProfLogo');
  let btn = document.getElementById('btnHapusProfLogo');
  let badge = document.getElementById('profLogoBadge');
  if (url && url.trim() !== '') {
    img.src = url.trim();
    img.style.display = 'block';
    txt.style.display = 'none';
    if(btn) btn.style.display = 'flex';
    if(badge) {
      if(url.indexOf('googleusercontent.com') !== -1 || url.indexOf('drive.google.com') !== -1) {
        badge.innerText = "Google Drive";
        badge.style.background = "#D1FAE5";
        badge.style.color = "#065F46";
      } else if(url.indexOf('data:image') === 0) {
        badge.innerText = "Lokal";
        badge.style.background = "#FEF3C7";
        badge.style.color = "#92400E";
      } else {
        badge.innerText = "URL Web";
        badge.style.background = "#E0E7FF";
        badge.style.color = "#3730A3";
      }
    }
    img.onerror = function() {
      img.style.display = 'none';
      txt.style.display = 'block';
      txt.innerText = 'Gagal memuat URL';
      if(btn) btn.style.display = 'none';
      if(badge) { badge.innerText = "Error"; badge.style.background = "#FEE2E2"; badge.style.color = "#B91C1C"; }
    };
  } else {
    img.style.display = 'none';
    txt.style.display = 'block';
    txt.innerHTML = '<i class="fa-solid fa-umbrella-beach"></i> Default';
    if(btn) btn.style.display = 'none';
    if(badge) { badge.innerText = "Logo Default"; badge.style.background = "#F1F5F9"; badge.style.color = "#64748B"; }
  }
};

window.uploadProfLogoFile = function(input) {
  let msg = document.getElementById('profLogoMsg');
  let badge = document.getElementById('profLogoBadge');
  if (!input || !input.files || input.files.length === 0) return;

  let file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    if(msg) { msg.style.color = "#EF4444"; msg.innerText = "Maksimal ukuran file 5MB!"; }
    return;
  }

  if(badge) { badge.innerText = "Mengunggah..."; badge.style.background = "#FEF3C7"; badge.style.color = "#D97706"; }
  if(msg) { msg.style.color = "#FF5E1F"; msg.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengunggah logo ke Google Drive...'; }

  let reader = new FileReader();
  reader.onload = function(e) {
    let base64Full = e.target.result;
    let base64Data = base64Full.split(',')[1];

    previewProfLogo(base64Full);

    let dataObj = {
      fotoBase64: base64Data,
      fotoType: file.type || "image/png",
      fotoName: "logo_" + Date.now() + "_" + (file.name || "logo.png")
    };

    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.success && res.url) {
            let driveUrl = res.url;
            document.getElementById('profLogoUrl').value = driveUrl;
            previewProfLogo(driveUrl);
            localStorage.setItem("kamawak_prof_logo", driveUrl);
            updateNavbarLogo();
            if(msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check-circle"></i> Logo berhasil tersimpan di Google Drive!'; }
          } else {
            let fallbackUrl = base64Full;
            document.getElementById('profLogoUrl').value = fallbackUrl;
            localStorage.setItem("kamawak_prof_logo", fallbackUrl);
            updateNavbarLogo();
            if(msg) { msg.style.color = "#F59E0B"; msg.innerText = "Logo tersimpan lokal di browser."; }
          }
        })
        .withFailureHandler(function(err) {
          let fallbackUrl = base64Full;
          document.getElementById('profLogoUrl').value = fallbackUrl;
          localStorage.setItem("kamawak_prof_logo", fallbackUrl);
          updateNavbarLogo();
          if(msg) { msg.style.color = "#F59E0B"; msg.innerText = "Logo tersimpan lokal di browser."; }
        })
        .uploadFotoDrive(dataObj);
    } else {
      let fallbackUrl = base64Full;
      document.getElementById('profLogoUrl').value = fallbackUrl;
      localStorage.setItem("kamawak_prof_logo", fallbackUrl);
      updateNavbarLogo();
      if(msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check"></i> Logo dimuat secara lokal.'; }
    }
  };
  reader.readAsDataURL(file);
};

