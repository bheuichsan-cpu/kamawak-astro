};

function simpanDaftarPintasanServer(list, suksesMsg) {
  localStorage.setItem("kamawak_kartu_kota", JSON.stringify(list));
  renderTabelPintasanKota(list);

  if (typeof google !== 'undefined' && google.script && google.script.run) {
    let payload = [
      { key: "KARTU_KOTA", value: JSON.stringify(list), desc: "Daftar Kartu Kota (Jelajahi Kota) di Beranda" }
    ];
