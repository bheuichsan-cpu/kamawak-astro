window.previewTagUrl = function(url) {
  let img = document.getElementById('imgTagPreview');
  let txt = document.getElementById('txtTagPreview');
  if (url && url.trim() !== '') {
    img.src = url.trim();
    img.style.display = 'block';
    txt.style.display = 'none';
  } else {
    img.style.display = 'none';
    txt.style.display = 'block';
  }
};

window.uploadTagFotoFile = function(input) {
  let file = input.files && input.files[0];
  if (!file) return;
  let msg = document.getElementById('tagFotoFileMsg');
  if (msg) { msg.style.color = "#3B82F6"; msg.innerText = "Mengunggah ke Google Drive..."; }

  let reader = new FileReader();
  reader.onload = function(e) {
    let base64Full = e.target.result;
    let base64Pure = base64Full.split(',')[1];
    window.previewTagUrl(base64Full);

    if (typeof google !== 'undefined' && google.script && google.script.run) {
      let dataObj = {
        fotoBase64: base64Pure,
        fotoType: file.type || "image/jpeg",
        fotoName: "kota_" + file.name.replace(/[^a-zA-Z0-9._-]/g, '_')
      };
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.success && res.url) {
            document.getElementById('tagFotoUrl').value = res.url;
            window.previewTagUrl(res.url);
            if (msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check"></i> Foto berhasil diunggah ke Google Drive.'; }
          } else {
            document.getElementById('tagFotoUrl').value = base64Full;
            if (msg) { msg.style.color = "#F59E0B"; msg.innerText = "Tersimpan lokal di browser."; }
          }
        })
        .withFailureHandler(function() {
          document.getElementById('tagFotoUrl').value = base64Full;
          if (msg) { msg.style.color = "#F59E0B"; msg.innerText = "Tersimpan lokal di browser."; }
        })
        .uploadFotoDrive(dataObj);
    } else {
      document.getElementById('tagFotoUrl').value = base64Full;
      if (msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check"></i> Foto dimuat lokal.'; }
    }
  };
  reader.readAsDataURL(file);
};

window.muatDaftarPintasanKota = function() {
  let list = [];
  try {
    let saved = localStorage.getItem("kamawak_kartu_kota");
    if (saved) list = JSON.parse(saved);
  } catch(e) {}

  if (!list || list.length === 0) {
    list = [...KARTU_KOTA_DEFAULT];
    localStorage.setItem("kamawak_kartu_kota", JSON.stringify(list));
  }

  renderTabelPintasanKota(list);

  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run.withSuccessHandler(function(config) {
      if (config && config.KARTU_KOTA) {
        try {
          let serverList = typeof config.KARTU_KOTA === 'string' ? JSON.parse(config.KARTU_KOTA) : config.KARTU_KOTA;
          if (serverList && serverList.length > 0) {
            localStorage.setItem("kamawak_kartu_kota", JSON.stringify(serverList));
            renderTabelPintasanKota(serverList);
          }
        } catch(e) {}
      }
    }).getPengaturan();
  }
};

function renderTabelPintasanKota(list) {
  let tbody = document.getElementById('tableTagsBody');
  if (!tbody) return;
  if (!list || list.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-gray); padding: 25px;">Belum ada kartu kota. Tambahkan melalui form di atas.</td></tr>';
    return;
  }

  let html = list.map((item, idx) => {
    let isAktif = item.status !== 'Nonaktif';
    let badge = isAktif 
      ? `<span onclick="toggleStatusPintasanTag(${idx})" style="background:#D1FAE5; color:#065F46; padding:4px 10px; border-radius:12px; font-size:11px; font-weight:700; cursor:pointer; user-select:none;" title="Klik untuk nonaktifkan"><i class="fa-solid fa-check"></i> Aktif</span>`
      : `<span onclick="toggleStatusPintasanTag(${idx})" style="background:#FEE2E2; color:#991B1B; padding:4px 10px; border-radius:12px; font-size:11px; font-weight:700; cursor:pointer; user-select:none;" title="Klik untuk aktifkan"><i class="fa-solid fa-pause"></i> Nonaktif</span>`;
    
    let imgFoto = item.img || item.foto || 'https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?q=80&w=400';
    let subtagStr = item.subtag || '-';

    return `
      <tr>
        <td style="text-align: center; padding: 8px;">
          <img src="${imgFoto}" alt="${item.label || item.nama}" style="width: 44px; height: 44px; object-fit: cover; border-radius: 8px; border: 1px solid #E5E7EB;" onerror="this.src='https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?q=80&w=400';">
        </td>
        <td style="font-weight: 600; color: var(--text-dark);">${item.nama}</td>
        <td>${item.label || item.nama}</td>
        <td><span style="font-size:12px; color:#4B5563;">${subtagStr}</span></td>
        <td>${badge}</td>
        <td style="text-align: center; white-space: nowrap;">
          <button onclick="editPintasanTag(${idx})" style="background:#EFF6FF; color:#2563EB; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600; margin-right:6px;" title="Ubah Nama/Foto">
            <i class="fa-solid fa-pen"></i> Edit
          </button>
          <button onclick="hapusPintasanTag(${idx})" style="background:#FEE2E2; color:#DC2626; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600;" title="Hapus Kartu">
            <i class="fa-solid fa-trash"></i>
          </button>
        </td>
      </tr>
    `;
  }).join('');
  tbody.innerHTML = html;
}

window.simpanPintasanTag = function() {
  let nama = document.getElementById('tagName').value.trim();
  let label = document.getElementById('tagLabel').value.trim();
  let subtag = document.getElementById('tagSub') ? document.getElementById('tagSub').value.trim() : "";
  let url = document.getElementById('tagFotoUrl').value.trim();
  let editIdx = parseInt(document.getElementById('tagEditIndex').value, 10);

  if (!nama) {
    Swal.fire('Perhatian', 'Nama kota / kata kunci filter wajib diisi.', 'warning');
    return;
  }
  if (!label) label = nama;
  if (!url) {
    url = "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?q=80&w=400&auto=format&fit=crop";
  }

  let list = [];
  try {
    let saved = localStorage.getItem("kamawak_kartu_kota");
    if (saved) list = JSON.parse(saved);
  } catch(e) {}
  if (!list || list.length === 0) list = [...KARTU_KOTA_DEFAULT];

  if (editIdx >= 0 && editIdx < list.length) {
    list[editIdx].nama = nama;
    list[editIdx].label = label;
    list[editIdx].subtag = subtag;
    list[editIdx].img = url;
  } else {
    list.push({ nama: nama, label: label, subtag: subtag, img: url, status: "Aktif" });
  }

  simpanDaftarPintasanServer(list, editIdx >= 0 ? "Kartu kota berhasil diperbarui!" : "Kartu kota baru berhasil ditambahkan!");
  window.batalEditTag();
};

window.editPintasanTag = function(idx) {
  let list = [];
  try { list = JSON.parse(localStorage.getItem("kamawak_kartu_kota") || "[]"); } catch(e) {}
  if (!list[idx]) return;
  let item = list[idx];

  document.getElementById('tagEditIndex').value = idx;
  document.getElementById('tagName').value = item.nama;
  document.getElementById('tagLabel').value = item.label || item.nama;
  if (document.getElementById('tagSub')) document.getElementById('tagSub').value = item.subtag || '';
  document.getElementById('tagFotoUrl').value = item.img || item.foto || '';
  window.previewTagUrl(item.img || item.foto || '');

  document.getElementById('judulFormTag').innerHTML = `<i class="fa-solid fa-pen-to-square"></i> Edit Kartu: ${item.label || item.nama}`;
  document.getElementById('badgeModeTag').innerText = "Mode: Edit Kartu";
  document.getElementById('badgeModeTag').style.background = "#DBEAFE";
  document.getElementById('badgeModeTag').style.color = "#1D4ED8";
  document.getElementById('btnTextTag').innerText = "Simpan Perubahan";
  document.getElementById('btnBatalEditTag').style.display = "inline-block";

  let el = document.getElementById('judulFormTag');
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
};

window.batalEditTag = function() {
  document.getElementById('tagEditIndex').value = "-1";
  document.getElementById('tagName').value = "";
  document.getElementById('tagLabel').value = "";
  if (document.getElementById('tagSub')) document.getElementById('tagSub').value = "";
  document.getElementById('tagFotoUrl').value = "";
  let fileIpt = document.getElementById('tagFotoFile');
  if (fileIpt) fileIpt.value = "";
  let msg = document.getElementById('tagFotoFileMsg');
  if (msg) { msg.style.color = "#6B7280"; msg.innerText = "Disimpan otomatis ke Google Drive."; }
  window.previewTagUrl("");

  document.getElementById('judulFormTag').innerHTML = `<i class="fa-solid fa-pen-to-square"></i> Tambah / Edit Kartu Kota`;
  document.getElementById('badgeModeTag').innerText = "Mode: Tambah Baru";
  document.getElementById('badgeModeTag').style.background = "#FCE7F3";
  document.getElementById('badgeModeTag').style.color = "#BE185D";
  document.getElementById('btnTextTag').innerText = "Simpan & Tayangkan Kartu";
  document.getElementById('btnBatalEditTag').style.display = "none";
};

window.hapusPintasanTag = function(idx) {
  let list = [];
  try { list = JSON.parse(localStorage.getItem("kamawak_kartu_kota") || "[]"); } catch(e) {}
  if (!list[idx]) return;

  Swal.fire({
    title: 'Hapus Kartu Kota?',
    text: `Kartu "${list[idx].label || list[idx].nama}" akan dihapus dari halaman utama.`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#EF4444',
    cancelButtonColor: '#6B7280',
    confirmButtonText: 'Ya, Hapus',
    cancelButtonText: 'Batal'
  }).then((res) => {
    if (res.isConfirmed) {
      list.splice(idx, 1);
      simpanDaftarPintasanServer(list, "Kartu kota berhasil dihapus!");
      window.batalEditTag();
    }
  });
};

window.toggleStatusPintasanTag = function(idx) {
  let list = [];
  try { list = JSON.parse(localStorage.getItem("kamawak_kartu_kota") || "[]"); } catch(e) {}
  if (!list[idx]) return;

  list[idx].status = (list[idx].status === 'Nonaktif') ? 'Aktif' : 'Nonaktif';
  simpanDaftarPintasanServer(list, `Status kartu "${list[idx].label || list[idx].nama}" diubah menjadi ${list[idx].status}.`);
};

window.resetTagKotaDefault = function() {
  Swal.fire({
    title: 'Reset ke 7 Kota Standar?',
    text: 'Seluruh kartu kota akan dikembalikan ke daftar bawaan Sumatera Barat.',
    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: '#EC4899',
    cancelButtonColor: '#6B7280',
    confirmButtonText: 'Ya, Reset',
    cancelButtonText: 'Batal'
  }).then((res) => {
    if (res.isConfirmed) {
      let list = [...KARTU_KOTA_DEFAULT];
