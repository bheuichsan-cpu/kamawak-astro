    if (document.getElementById('cmsDurasi')) document.getElementById('cmsDurasi').value = targetData.durasi || '';
    if (document.getElementById('cmsMaps')) document.getElementById('cmsMaps').value = targetData.maps || '';
    if (document.getElementById('cmsWA')) document.getElementById('cmsWA').value = targetData.wa || '';
    if (document.getElementById('cmsIG')) document.getElementById('cmsIG').value = targetData.ig || '';
    if (document.getElementById('cmsTikTok')) document.getElementById('cmsTikTok').value = targetData.tiktok || '';
    if (document.getElementById('cmsFB')) document.getElementById('cmsFB').value = targetData.fb || '';
    let dVal = targetData.deskripsi || '';
    if (document.getElementById('cmsDeskripsi')) document.getElementById('cmsDeskripsi').value = dVal.replace(/\\n/g, '\n');
    let fVal = targetData.fasilitas || '';
    if (document.getElementById('cmsFasilitas')) document.getElementById('cmsFasilitas').value = fVal.replace(/\\n/g, '\n');
    if (typeof window.updateFacilityTagHighlights === 'function') window.updateFacilityTagHighlights();
    if (typeof window.updateCardPreviewLanding === 'function') window.updateCardPreviewLanding();
    if (document.getElementById('cmsVarian')) document.getElementById('cmsVarian').value = targetData.varian || '';
    if (document.getElementById('cmsTags')) document.getElementById('cmsTags').value = targetData.tags || targetData.penanda || '';
