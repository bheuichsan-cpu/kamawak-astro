}

async function muatDaftarPengguna() {
  let tbody = document.getElementById('tableUsersBody');
  try {
     const { data, error } = await supabase.from('users').select('*');
     if (error) throw error;
     
     if(!data || data.length === 0) { tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;">Belum ada pengguna (Tabel kosong)</td></tr>'; return; }
     let html = "";
     data.forEach(u => {
        let bg = u.role === 'Admin' ? 'background:#8B5CF6;color:white' : (u.role === 'Owner' ? 'background:#F59E0B;color:white' : 'background:#E5E7EB;color:black');
