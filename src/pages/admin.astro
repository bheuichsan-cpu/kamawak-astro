async function muatStatistikGlobal() {
  try {
    const { data: mitraData, error: errMitra } = await supabase.from('users').select('*').eq('role', 'Owner');
    const { data: leadsData, error: errLeads } = await supabase.from('leads').select('*');
    const { data: trxData, error: errTrx } = await supabase.from('transaksi').select('*').eq('status', 'Berhasil');

    if (errMitra) console.error("Error Mitra:", errMitra);
    if (errLeads) console.error("Error Leads:", errLeads);
    if (errTrx) console.error("Error Trx:", errTrx);

    document.getElementById('valMitra').innerText = mitraData ? mitraData.length : 0;
    document.getElementById('valLeads').innerText = leadsData ? leadsData.length : 0;
    
    let totalPendapatan = 0;
    if (trxData) {
        trxData.forEach(trx => { totalPendapatan += Number(trx.totalBayar || trx.nominal || 0); });
    }
    document.getElementById('valPendapatan').innerText = "Rp " + totalPendapatan.toLocaleString('id-ID');
  } catch (e) {
    console.error("Global stats error:", e);
    document.getElementById('valMitra').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valLeads').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valPendapatan').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
  }
}

window.dataMitraGlobal = [];
async function muatDaftarMitra() {
  try {
    const { data, error } = await supabase.from('users').select('*').eq('role', 'Owner');
    if (error) throw error;
    window.dataMitraGlobal = data || [];
    window.filterMitra('Semua');
  } catch (e) {
    document.getElementById('tableMitraBody').innerHTML = '<tr><td colspan="5" style="color:red;text-align:center;">Gagal memuat mitra</td></tr>';
  }
}

window.filterMitra = function(status) {
    let tbody = document.getElementById('tableMitraBody');
    let filtered = window.dataMitraGlobal;
    if (status !== 'Semua') {
        filtered = window.dataMitraGlobal.filter(m => m.status_langganan === status);
    }
    
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada mitra.</td></tr>';
        return;
    }
    
    let html = "";
    filtered.forEach(m => {
        let badge = m.status_langganan === 'Aktif' ? 'badge-aktif' : 'badge-nonaktif';
        html += `<tr>
           <td>${m.id || m.email}</td>
           <td>${m.nama}</td>
           <td>-</td>
           <td>-</td>
           <td><span class="${badge}">${m.status_langganan || 'Pending'}</span></td>
        </tr>`;
    });
    tbody.innerHTML = html;
};

window.prosesUpdateStatus = async function() {
  let id = document.getElementById('inputIDMitra').value;
  let status = document.getElementById('selectStatus').value;
  let info = document.getElementById('statusInfo');
  if(!id) return;
  info.innerText = "Memperbarui...";
  
  const { error } = await supabase.from('users').update({ status_langganan: status }).or(`id.eq.${id},email.eq.${id}`);
  if (!error) {
     info.innerText = "Berhasil!";
     info.style.color = "green";
     muatDaftarMitra();
  } else {
     info.innerText = "Gagal!";
     info.style.color = "red";
  }
};

async function muatTransaksi() {
  let tbody = document.getElementById('tableTrxBody');
  try {
    const { data, error } = await supabase.from('transaksi').select('*').order('created_at', { ascending: false });
    if (error) throw error;
    if (!data || data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada transaksi.</td></tr>';
        return;
    }
    
    let html = "";
    data.forEach(t => {
        html += `<tr>
           <td>${t.created_at || t.tanggal}</td>
           <td>${t.id}</td>
           <td>${t.namaProduk || '-'}</td>
           <td>${t.owner || '-'}</td>
           <td>Rp ${Number(t.totalBayar||0).toLocaleString('id-ID')}</td>
        </tr>`;
    });
    tbody.innerHTML = html;
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="5" style="color:red;text-align:center;">Error memuat trx: ${e.message || JSON.stringify(e)}</td></tr>`; console.error('Trx err:', e);
