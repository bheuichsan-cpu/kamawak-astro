    function simpanCMS() {
      let files = document.getElementById('cmsFotoUpload').files;
      if (files.length === 0) {
        lanjutSimpanCMS([]); return;
      }
      
      document.getElementById('cmsInfo').innerText = "Membaca " + files.length + " foto...";
      document.getElementById('cmsInfo').style.color = "var(--text-gray)";
      
      let fileDataArray = [];
      let filesRead = 0;
      
      for(let i=0; i<files.length; i++){
        let file = files[i];
        let reader = new FileReader();
        reader.onload = function(e) {
           let dataUrl = e.target.result;
           let base64Data = dataUrl.split(',')[1];
           fileDataArray.push({
              name: file.name,
              mimeType: file.type,
              data: base64Data
           });
           filesRead++;
           if(filesRead === files.length) {
              document.getElementById('cmsInfo').innerText = "Mengunggah foto ke Google Drive & Menyimpan data...";
              lanjutSimpanCMS(fileDataArray);
           }
        };
        reader.readAsDataURL(file);
      }
    }

    function lanjutSimpanCMS(filesData) {
      let data = {
        id: document.getElementById('cmsID').value,
        idOwner: document.getElementById('cmsIDOwner').value,
        nama: document.getElementById('cmsNama').value,
        kategori: document.getElementById('cmsKategori').value,
        statusLangganan: document.getElementById('cmsStatusLangganan') ? document.getElementById('cmsStatusLangganan').value : "Aktif",
        destinasi: document.getElementById('cmsDestinasi').value,
        harga: document.getElementById('cmsHarga').value,
        files: filesData,
        hargaCoret: document.getElementById('cmsHargaCoret').value,
        durasi: document.getElementById('cmsDurasi').value,
        maps: document.getElementById('cmsMaps').value,
        wa: document.getElementById('cmsWA').value,
        ig: document.getElementById('cmsIG').value,
        tiktok: document.getElementById('cmsTikTok').value,
        fb: document.getElementById('cmsFB').value,
        deskripsi: document.getElementById('cmsDeskripsi').value,
        fasilitas: document.getElementById('cmsFasilitas').value,
        varian: document.getElementById('cmsVarian').value,
        tags: document.getElementById('cmsTags').value
      };
      if(!data.id || !data.nama || !data.harga) {
          document.getElementById('cmsInfo').innerText = "ID, Nama, dan Harga wajib diisi!";
          document.getElementById('cmsInfo').style.color = "red"; return;
      }
      google.script.run
        .withFailureHandler(function(err){ document.getElementById('cmsInfo').innerText = "Gagal: " + err; document.getElementById('cmsInfo').style.color = "red"; })
        .withSuccessHandler(function(res) {
          if(res.success) {
             document.getElementById('cmsInfo').innerText = res.message;
             document.getElementById('cmsInfo').style.color = "#10B981";
             ['cmsID','cmsIDOwner','cmsNama','cmsHarga','cmsFotoUpload','cmsHargaCoret','cmsDurasi','cmsMaps','cmsWA','cmsIG','cmsTikTok','cmsFB','cmsDeskripsi','cmsFasilitas','cmsVarian','cmsTags','cmsStatusLangganan'].forEach(id => {
                let el = document.getElementById(id);
                if(el) {
                    if (id === 'cmsStatusLangganan') el.value = 'Aktif';
                    else el.value = "";
                }
             });
             muatDaftarMitra(); muatStatistikGlobal();
          } else {
             document.getElementById('cmsInfo').innerText = "Gagal: " + res.error;
             document.getElementById('cmsInfo').style.color = "red";
          }
        })
        .simpanCMSBackend(data);
    }

