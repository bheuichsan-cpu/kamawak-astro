  let fasilitas = document.getElementById('cmsFasilitas') ? document.getElementById('cmsFasilitas').value.trim() : '';

  let elNama = document.getElementById('cardPrevNama');
  let elHarga = document.getElementById('cardPrevHarga');
  let elImg = document.getElementById('cardPrevImg');
  let elFas = document.getElementById('cardPrevAmenities');

  if (elNama) elNama.innerText = nama || 'Nama Produk / Villa';
  if (elHarga) {
    let num = Number(harga.replace(/[^0-9]/g, '')) || 0;
    elHarga.innerText = num > 0 ? 'IDR ' + num.toLocaleString('id-ID') : 'IDR 0';
  }
  if (elImg && foto) {
    let f1 = foto.split('|||')[0].trim();
    if (f1.startsWith('http') || f1.startsWith('data:image')) elImg.src = f1;
