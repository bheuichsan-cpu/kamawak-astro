window.switchTab = function(tabId) {
  document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
  
  document.getElementById('tabDashboard').style.display = 'none';
  document.getElementById('tabCMS').style.display = 'none';
  if (document.getElementById('tabPromo')) document.getElementById('tabPromo').style.display = 'none';
  document.getElementById('tabTransaksi').style.display = 'none';
  document.getElementById('tabKeuangan').style.display = 'none';
  document.getElementById('tabUsers').style.display = 'none';
  document.getElementById('tabAds').style.display = 'none';
  document.getElementById('tabComposer').style.display = 'none';
  document.getElementById('tabPengaturan').style.display = 'none';
  
  document.querySelectorAll('[id^="btnTab"]').forEach(b => { b.style.background = '#F3F4F6'; b.style.color = 'var(--text-dark)'; });
  
  document.getElementById(tabId).style.display = 'block';
  document.getElementById('btn' + tabId.charAt(0).toUpperCase() + tabId.slice(1)).style.background = 'var(--primary)';
  document.getElementById('btn' + tabId.charAt(0).toUpperCase() + tabId.slice(1)).style.color = 'white';

  if (tabId === 'tabCMS' && typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();
  if (tabId === 'tabPromo' && typeof muatDaftarPromo === 'function') muatDaftarPromo();
  if (tabId === 'tabAds' && typeof muatDaftarIklan === 'function') muatDaftarIklan();
  if ((tabId === 'tabPengaturan' || tabId === 'tabComposer') && typeof muatPengaturan === 'function') muatPengaturan();
  if (tabId === 'tabComposer' && typeof muatDaftarPintasanKota === 'function') muatDaftarPintasanKota();
  if (tabId === 'tabKeuangan' && typeof muatKas === 'function') muatKas();
  if (tabId === 'tabDashboard' && typeof muatDataMitra === 'function') muatDataMitra();
};

window.logout = function() {
  localStorage.clear();
  window.location.href = '/';
};

window.onload = function() {
  let urlUser = new URLSearchParams(window.location.search).get("u") || localStorage.getItem("kamawak_user") || "";
  let urlRole = new URLSearchParams(window.location.search).get("r") || localStorage.getItem("kamawak_role") || "";
  if(urlUser && urlRole && urlUser !== "") {
     localStorage.setItem("kamawak_user", urlUser);
     localStorage.setItem("kamawak_role", urlRole);
  }

  let role = localStorage.getItem("kamawak_role");
  if (!role || role.toLowerCase() !== "admin") {
    window.location.href = "/login";
    return;
  }
  
  document.getElementById("adminName").innerText = "Halo, " + localStorage.getItem("kamawak_user");
  
  muatStatistikGlobal();
  muatDaftarMitra();
  muatTransaksi();
  muatDaftarPengguna();
  muatKas();
  muatPengaturan();
  if (typeof muatDaftarPintasanKota === 'function') muatDaftarPintasanKota();
  if (typeof muatDaftarPromo === 'function') muatDaftarPromo();
};

async function muatStatistikGlobal() {
  try {
    const { data: mitraData, error: errMitra } = await supabase.from('users').select('*').eq('role', 'Owner');
    const { data: leadsData, error: errLeads } = await supabase.from('leads').select('*');
    const { data: trxData, error: errTrx } = await supabase.from('transaksi').select('*').in('status', ['Berhasil', 'Sudah Digunakan']);

    if (errMitra) console.error("Error Mitra:", errMitra);
    if (errLeads) console.error("Error Leads:", errLeads);
    if (errTrx) console.error("Error Trx:", errTrx);

    document.getElementById('valMitra').innerText = mitraData ? mitraData.length : 0;
    document.getElementById('valLeads').innerText = leadsData ? leadsData.length : 0;
    
    let totalPendapatan = 0;
    if (trxData) {
        trxData.forEach(trx => { totalPendapatan += Number(trx.totalBayar || trx.nominal || 0); });
    }
    document.getElementById('valPendapatan').innerText = "Rp " + totalPendapatan.toLocaleString('id-ID');
  } catch (e) {
    console.error("Global stats error:", e);
    document.getElementById('valMitra').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valLeads').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valPendapatan').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
  }
}

window.dataMitraGlobal = [];
async function muatDaftarMitra() {
  try {
    const { data, error } = await supabase.from('users').select('*').eq('role', 'Owner');
    if (error) throw error;
    window.dataMitraGlobal = data || [];
    window.filterMitra('Semua');
  } catch (e) {
    document.getElementById('tableMitraBody').innerHTML = '<tr><td colspan="5" style="color:red;text-align:center;">Gagal memuat mitra</td></tr>';
  }
}

window.filterMitra = function(status) {
    let tbody = document.getElementById('tableMitraBody');
    let filtered = window.dataMitraGlobal;
    if (status !== 'Semua') {
        filtered = window.dataMitraGlobal.filter(m => m.status_langganan === status);
    }
    
    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada mitra.</td></tr>';
        return;
    }
    
    let html = "";
    filtered.forEach(m => {
        let badge = m.status_langganan === 'Aktif' ? 'badge-aktif' : 'badge-nonaktif';
        html += `<tr>
           <td>${m.id || m.email}</td>
           <td>${m.nama}</td>
           <td>-</td>
           <td>-</td>
           <td><span class="${badge}">${m.status_langganan || 'Pending'}</span></td>
        </tr>`;
    });
    tbody.innerHTML = html;
};

window.prosesUpdateStatus = async function() {
  let id = document.getElementById('inputIDMitra').value;
  let status = document.getElementById('selectStatus').value;
  let info = document.getElementById('statusInfo');
  if(!id) return;
  info.innerText = "Memperbarui...";
  
  const { error } = await supabase.from('users').update({ status_langganan: status }).or(`id.eq.${id},email.eq.${id}`);
  if (!error) {
     info.innerText = "Berhasil!";
     info.style.color = "green";
     muatDaftarMitra();
  } else {
     info.innerText = "Gagal!";
     info.style.color = "red";
  }
};

async function muatTransaksi() {
  let tbody = document.getElementById('tableTrxBody');
  try {
    const { data, error } = await supabase.from('transaksi').select('*').order('created_at', { ascending: false });
    if (error) throw error;
    if (!data || data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada transaksi.</td></tr>';
        return;
    }
    
    let html = "";
    data.forEach(t => {
        html += `<tr>
           <td>${t.created_at || t.tanggal}</td>
           <td>${t.id}</td>
           <td>${t.namaProduk || '-'}</td>
           <td>${t.owner || '-'}</td>
           <td>Rp ${Number(t.totalBayar||0).toLocaleString('id-ID')}</td>
        </tr>`;
    });
    tbody.innerHTML = html;
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="5" style="color:red;text-align:center;">Error memuat trx: ${e.message || JSON.stringify(e)}</td></tr>`; console.error('Trx err:', e);
  }
}

async function muatDaftarPengguna() {
  let tbody = document.getElementById('tableUsersBody');
  try {
     const { data, error } = await supabase.from('users').select('*');
     if (error) throw error;
     
     if(!data || data.length === 0) { tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;">Belum ada pengguna (Tabel kosong)</td></tr>'; return; }
     let html = "";
     data.forEach(u => {
        let bg = u.role === 'Admin' ? 'background:#8B5CF6;color:white' : (u.role === 'Owner' ? 'background:#F59E0B;color:white' : 'background:#E5E7EB;color:black');
        html += `<tr onclick="document.getElementById('inputEmailUser').value='${u.email}'" style="cursor:pointer;">
           <td>${u.nama}</td>
           <td>${u.email}</td>
           <td><span style="padding:4px 10px;border-radius:15px;font-size:12px;${bg}">${u.role}</span></td>
        </tr>`;
     });
     tbody.innerHTML = html;
  } catch(e) {
     tbody.innerHTML = `<tr><td colspan="3" style="color:red;">Error memuat user: ${e.message || JSON.stringify(e)}</td></tr>`; console.error('Users err:', e);
  }
}

window.prosesUpdateRole = async function() {
  let email = document.getElementById('inputEmailUser').value;
  let role = document.getElementById('selectRole').value;
  let info = document.getElementById('roleInfo');
  
  if(!email) return;
  info.innerText = "Memperbarui...";
  
  const { error } = await supabase.from('users').update({ role: role }).eq('email', email);
  if (!error) {
     info.innerText = "Berhasil update role!";
     info.style.color = "green";
     muatDaftarPengguna();
  } else {
     info.innerText = "Gagal!";
  }
};


window.simpanCMS = async function() {
  let id = document.getElementById('cmsID').value.trim();
  let owner = document.getElementById('cmsIDOwner').value.trim();
  let nama = document.getElementById('cmsNama').value.trim();
  let kategori = document.getElementById('cmsKategori').value;
  let lokasi = document.getElementById('cmsDestinasi').value.trim();
  let harga = document.getElementById('cmsHarga').value.trim();
  
  if(!nama || !kategori || !harga) {
      Swal.fire('Perhatian', 'Nama, Kategori, dan Harga wajib diisi!', 'warning');
      return;
  }
  
  let btn = (window.event && window.event.target) || document.querySelector('button[onclick="simpanCMS()"]');
  let oldText = btn ? btn.innerText : 'Tambahkan ke Database';
  if (btn) { btn.innerText = "Menyimpan..."; btn.disabled = true; }
  
  // Field-field formulir CMS
  let deskripsi = document.getElementById('cmsDeskripsi') ? document.getElementById('cmsDeskripsi').value.trim() : '';
  let fasilitas = document.getElementById('cmsFasilitas') ? document.getElementById('cmsFasilitas').value.trim() : '';
  let varian = document.getElementById('cmsVarian') ? document.getElementById('cmsVarian').value.trim() : '';
  let tags = document.getElementById('cmsTags') ? document.getElementById('cmsTags').value.trim() : '';
  let itinerary = document.getElementById('cmsItinerary') ? document.getElementById('cmsItinerary').value.trim() : '';
  let durasi = document.getElementById('cmsDurasi') ? document.getElementById('cmsDurasi').value.trim() : '';
  let maps = document.getElementById('cmsMaps') ? document.getElementById('cmsMaps').value.trim() : '';
  let wa = document.getElementById('cmsWA') ? document.getElementById('cmsWA').value.trim() : '';
  let ig = document.getElementById('cmsIG') ? document.getElementById('cmsIG').value.trim() : '';
  let tiktok = document.getElementById('cmsTikTok') ? document.getElementById('cmsTikTok').value.trim() : '';
  let fb = document.getElementById('cmsFB') ? document.getElementById('cmsFB').value.trim() : '';
  let hargaCoret = document.getElementById('cmsHargaCoret') ? document.getElementById('cmsHargaCoret').value.trim() : '';
  let fotoUrl = document.getElementById('cmsFotoUrl') ? document.getElementById('cmsFotoUrl').value.trim() : '';

  // Tangani file upload jika ada file dipilih dan belum terisi di fotoUrl
  let fileInput = document.getElementById('cmsFotoUpload');
  if (fileInput && fileInput.files && fileInput.files.length > 0 && !fotoUrl) {
    try {
      let fileArr = Array.from(fileInput.files);
      let compressedPromises = fileArr.slice(0, 10).map(f => window.compressImageClient(f, 800, 0.65));
      let results = await Promise.all(compressedPromises);
      fotoUrl = results.filter(Boolean).join(',\n');
    } catch(e) {}
  }

  // Fallback cerdas jika fotoUrl masih kosong agar produk selalu memiliki gambar yang menawan
  if (!fotoUrl) {
    let katLow = String(kategori).toLowerCase();
    if (katLow.includes('penginapan') || katLow.includes('hotel')) {
      fotoUrl = 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=800&q=80';
    } else if (katLow.includes('kuliner')) {
      fotoUrl = 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=800&q=80';
    } else if (katLow.includes('rental')) {
      fotoUrl = 'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=800&q=80';
    } else {
      fotoUrl = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80';
    }
  }

  // Data dasar (selalu ada di skema tabel wisata)
  let basePayload = {
      nama: nama,
      kategori: kategori,
      lokasi: lokasi,
      harga: Number(harga),
      owner: owner || 'Admin',
      status: document.getElementById('cmsStatusLangganan') ? document.getElementById('cmsStatusLangganan').value : 'Aktif',
      foto: fotoUrl,
      wa: wa || null
  };

  // Data lengkap (kolom tambahan modern)
  let fullPayload = {
      ...basePayload,
      deskripsi: deskripsi || null,
      fasilitas: fasilitas || null,
      varian: varian || null,
      tags: tags || null,
      itinerary: itinerary || null,
      durasi: durasi || null,
      maps: maps || null,
      ig: ig || null,
      tiktok: tiktok || null,
      fb: fb || null,
      harga_coret: (hargaCoret && !isNaN(hargaCoret)) ? Number(hargaCoret) : null
  };

  const resetForm = () => {
    ['cmsID', 'cmsIDOwner', 'cmsNama', 'cmsDestinasi', 'cmsHarga', 'cmsHargaCoret', 'cmsFotoUrl', 'cmsDurasi', 'cmsMaps', 'cmsWA', 'cmsIG', 'cmsTikTok', 'cmsFB', 'cmsDeskripsi', 'cmsFasilitas', 'cmsVarian', 'cmsTags', 'cmsItinerary'].forEach(fid => {
      let el = document.getElementById(fid);
      if (el) el.value = '';
    });
    let fi = document.getElementById('cmsFotoUpload');
    if (fi) fi.value = '';
    if (typeof window.resetCmsFotoPreview === 'function') window.resetCmsFotoPreview();
  };

  const sqlMigrationCode = `ALTER TABLE public.wisata 
ADD COLUMN IF NOT EXISTS deskripsi text,
ADD COLUMN IF NOT EXISTS fasilitas text,
ADD COLUMN IF NOT EXISTS varian text,
ADD COLUMN IF NOT EXISTS tags text,
ADD COLUMN IF NOT EXISTS itinerary text,
ADD COLUMN IF NOT EXISTS harga_coret numeric,
ADD COLUMN IF NOT EXISTS durasi text,
ADD COLUMN IF NOT EXISTS maps text,
ADD COLUMN IF NOT EXISTS ig text,
ADD COLUMN IF NOT EXISTS tiktok text,
ADD COLUMN IF NOT EXISTS fb text;`;

  try {
      let savedId = id;
      if (id) {
          const { error } = await supabase.from('wisata').update(fullPayload).eq('id', id);
          if (error) throw error;
      } else {
          // Jangan kirim ID string manual karena kolom id Supabase bertipe UUID
          const { data, error } = await supabase.from('wisata').insert([fullPayload]).select();
          if (error) throw error;
          if (data && data[0]) savedId = data[0].id;
      }

      // Simpan juga ke cache metadata lokal agar halaman PDP langsung menampilkan data
      if (savedId) {
          try {
            localStorage.setItem('kamawak_meta_' + savedId, JSON.stringify(fullPayload));
          } catch(e) {}
      }

      Swal.fire({
          icon: 'success',
          title: 'Berhasil Disimpan!',
          text: 'Data produk dan deskripsi berhasil disimpan ke Supabase.',
          timer: 2000
      });
      resetForm();
      if (typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();

  } catch(err) {
      let msg = (err && err.message) ? err.message : String(err);
      
      // Deteksi jika error karena kolom belum ada di database Supabase (PGRST204 / schema cache)
      if (msg.includes("Could not find the '") || msg.includes("schema cache") || err.code === 'PGRST204') {
          Swal.fire({
              title: 'Kolom Database Belum Ditambahkan',
              html: `
                <div style="text-align:left; font-size:13px; color:#374151;">
                  <p>Tabel <b>wisata</b> di database Supabase Anda belum memiliki kolom <b>deskripsi</b> (dan fitur pelengkap lainnya).</p>
                  <p style="margin-top:10px;"><strong>Langkah Mudah Mengaktifkannya (10 Detik):</strong></p>
                  <ol style="margin-left:18px; margin-bottom:10px; line-height: 1.6;">
                    <li>Buka <b>Supabase Dashboard &gt; SQL Editor</b>.</li>
                    <li>Jalankan (Run) perintah SQL berikut:</li>
                  </ol>
                  <textarea readonly id="sqlCopyAreaCMS" style="width:100%; height:110px; font-family:monospace; font-size:11px; background:#1E293B; color:#A7F3D0; padding:8px; border-radius:6px; border:none; resize:none;">${sqlMigrationCode}</textarea>
                  <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('sqlCopyAreaCMS').value); alert('Perintah SQL berhasil disalin ke clipboard!');" style="margin-top:8px; padding:6px 14px; background:#3B82F6; color:white; border:none; border-radius:6px; font-size:12px; cursor:pointer;">
                    <i class="fa-solid fa-copy"></i> Salin Perintah SQL
                  </button>
                  <hr style="margin:15px 0; border:none; border-top:1px solid #E5E7EB;">
                  <p style="font-size:12px; color:#4B5563;"><b>Mode Adaptif Otomatis:</b> Anda dapat menyimpan produk sekarang juga (data utama tersimpan di Supabase &amp; deskripsi/fasilitas dicadangkan di cache lokal).</p>
                </div>
              `,
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'Simpan dengan Mode Adaptif',
              cancelButtonText: 'Tutup & Jalankan SQL Dulu',
              confirmButtonColor: '#10B981',
              cancelButtonColor: '#6B7280'
          }).then(async (result) => {
              if (result.isConfirmed) {
                  try {
                      let fallbackSavedId = id;
                      if (id) {
                          const { error: fbErr } = await supabase.from('wisata').update(basePayload).eq('id', id);
                          if (fbErr) throw fbErr;
                      } else {
                          const { data: fbData, error: fbErr } = await supabase.from('wisata').insert([basePayload]).select();
                          if (fbErr) throw fbErr;
                          if (fbData && fbData[0]) fallbackSavedId = fbData[0].id;
                      }
                      
                      if (fallbackSavedId) {
                          localStorage.setItem('kamawak_meta_' + fallbackSavedId, JSON.stringify(fullPayload));
                      }
                      
                      Swal.fire('Tersimpan Adaptif', 'Produk berhasil disimpan ke Supabase! Deskripsi dan rincian paket tetap aktif.', 'success');
                      resetForm();
                      if (typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();
                  } catch (eFallback) {
                      Swal.fire('Gagal', eFallback.message || 'Gagal menyimpan data dasar.', 'error');
                  }
              }
          });
      } else {
          Swal.fire('Gagal Menyimpan', msg || 'Terjadi kesalahan sistem', 'error');
      }
  } finally {
      if (btn) { btn.innerText = oldText; btn.disabled = false; }
  }
};

