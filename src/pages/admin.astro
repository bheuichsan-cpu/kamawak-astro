window.simpanBukuKas = async function() {
    let jenis = document.getElementById('kasJenis').value;
    let kategori = document.getElementById('kasKategori').value;
    let keterangan = document.getElementById('kasKet').value;
    let nominal = document.getElementById('kasNominal').value;
    if (!keterangan || !nominal) {
        Swal.fire('Error', 'Lengkapi keterangan dan nominal', 'warning');
        return;
    }

    let btn = window.event ? window.event.target : document.querySelector('button[onclick="simpanBukuKas()"]');
    let old = btn.innerText; btn.innerText = "Menyimpan..."; btn.disabled = true;

    try {
        const { error } = await supabase.from('buku_kas').insert([{
            jenis: jenis, kategori: kategori, keterangan: keterangan, nominal: Number(nominal)
        }]);
        if (error) throw error;
        Swal.fire('Sukses', 'Transaksi kas berhasil dicatat', 'success');
        document.getElementById('kasKet').value = "";
        document.getElementById('kasNominal').value = "";
        muatKas();
    } catch (e) {
        Swal.fire('Gagal', e.message || JSON.stringify(e), 'error');
    } finally {
        if(btn) { btn.innerText = old; btn.disabled = false; }
    }
};

window.muatKas = async function() {
    try {
        const { data, error } = await supabase.from('buku_kas').select('*').order('created_at', { ascending: false });
        if (error) throw error;
        
        let masuk = 0;
        let keluar = 0;
        let pLangganan = 0, pOTA = 0, pLain = 0;
        let bOpr = 0, bMar = 0, bGaji = 0, bLain = 0;
        
        let html = "";
        
        if (!data || data.length === 0) {
            document.getElementById('tableKasBody').innerHTML = '<tr><td colspan="6" style="text-align: center;">Belum ada riwayat kas.</td></tr>';
        } else {
            data.forEach(item => {
                let nom = Number(item.nominal || 0);
                if (item.jenis === 'Pemasukan') {
                    masuk += nom;
                    if (item.kategori === 'Langganan Mitra') pLangganan += nom;
                    else if (item.kategori === 'Komisi OTA' || item.kategori === 'Komisi OTA / Platform') pOTA += nom;
                    else pLain += nom;
                } else {
                    keluar += nom;
                    if (item.kategori === 'Operasional' || item.kategori === 'Operasional / Server') bOpr += nom;
                    else if (item.kategori === 'Pemasaran' || item.kategori === 'Pemasaran (Marketing)') bMar += nom;
                    else if (item.kategori === 'Gaji' || item.kategori === 'Gaji / Fee') bGaji += nom;
                    else bLain += nom;
                }
                
                let tgl = item.created_at ? new Date(item.created_at).toLocaleDateString('id-ID') : '-';
                let warna = item.jenis === 'Pemasukan' ? '#10B981' : '#EF4444';
                let tanda = item.jenis === 'Pemasukan' ? '+' : '-';
                html += `<tr>
                  <td>${tgl}</td>
                  <td style="color:${warna}; font-weight:600;">${item.jenis}</td>
                  <td>${item.kategori}</td>
                  <td>${item.keterangan}</td>
                  <td style="color:${warna}; font-weight:600;">${tanda} Rp ${nom.toLocaleString('id-ID')}</td>
                  <td><button onclick="hapusKas('${item.id}')" style="background:#EF4444; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer;"><i class="fa-solid fa-trash"></i></button></td>
                </tr>`;
            });
            document.getElementById('tableKasBody').innerHTML = html;
        }
        
        document.getElementById('valKasMasuk').innerHTML = `Rp ${masuk.toLocaleString('id-ID')}`;
        document.getElementById('valKasKeluar').innerHTML = `Rp ${keluar.toLocaleString('id-ID')}`;
        let saldo = masuk - keluar;
        document.getElementById('valKasSaldo').innerHTML = `Rp ${saldo.toLocaleString('id-ID')}`;
        
        document.getElementById('lrLangganan').innerText = `Rp ${pLangganan.toLocaleString('id-ID')}`;
        document.getElementById('lrOTA').innerText = `Rp ${pOTA.toLocaleString('id-ID')}`;
        document.getElementById('lrLainP').innerText = `Rp ${pLain.toLocaleString('id-ID')}`;
        document.getElementById('lrTotalP').innerText = `Rp ${masuk.toLocaleString('id-ID')}`;
        
        document.getElementById('lrOpr').innerText = `Rp ${bOpr.toLocaleString('id-ID')}`;
        document.getElementById('lrMar').innerText = `Rp ${bMar.toLocaleString('id-ID')}`;
        document.getElementById('lrGaji').innerText = `Rp ${bGaji.toLocaleString('id-ID')}`;
        document.getElementById('lrLainB').innerText = `Rp ${bLain.toLocaleString('id-ID')}`;
        document.getElementById('lrTotalB').innerText = `Rp ${keluar.toLocaleString('id-ID')}`;
        
        document.getElementById('lrNet').innerText = `Rp ${saldo.toLocaleString('id-ID')}`;
        
    } catch (e) {
        console.error('Kas err:', e);
        document.getElementById('valKasMasuk').innerHTML = 'Err';
        document.getElementById('valKasKeluar').innerHTML = 'Err';
        document.getElementById('valKasSaldo').innerHTML = 'Err';
        document.getElementById('tableKasBody').innerHTML = `<tr><td colspan="6" style="color:red;text-align:center;">Gagal memuat data kas: ${e.message}</td></tr>`;
    }
};

window.hapusKas = async function(id) {
    if(!confirm('Hapus transaksi kas ini?')) return;
    try {
        const { error } = await supabase.from('buku_kas').delete().eq('id', id);
        if (error) throw error;
        muatKas();
    } catch(e) {
        alert('Gagal hapus: ' + e.message);
    }
};

window.previewHero = function(num, url) {
    let img = document.getElementById('imgHero' + num);
    let txt = document.getElementById('txtHero' + num);
    let btnHapus = document.getElementById('btnHapusHero' + num);
    let badge = document.getElementById('heroBadge' + num);
    if(url && url.trim() !== '') {
        img.src = url.trim();
        img.style.display = 'block';
        txt.style.display = 'none';
        if(btnHapus) btnHapus.style.display = 'flex';
        if(badge) {
            if(url.indexOf('googleusercontent.com') !== -1 || url.indexOf('drive.google.com') !== -1) {
                badge.innerText = "Google Drive";
                badge.style.background = "#D1FAE5";
                badge.style.color = "#065F46";
            } else if(url.indexOf('data:image') === 0) {
                badge.innerText = "Lokal";
                badge.style.background = "#FEF3C7";
                badge.style.color = "#92400E";
            } else {
                badge.innerText = "URL Web";
                badge.style.background = "#E0E7FF";
                badge.style.color = "#3730A3";
            }
        }
        img.onerror = function() {
            img.style.display = 'none';
            txt.style.display = 'block';
            txt.innerText = 'Gagal memuat URL';
            if(btnHapus) btnHapus.style.display = 'none';
            if(badge) { badge.innerText = "Error"; badge.style.background = "#FEE2E2"; badge.style.color = "#B91C1C"; }
        };
    } else {
        img.style.display = 'none';
        txt.style.display = 'block';
        txt.innerHTML = '<i class="fa-solid fa-image" style="font-size: 20px; display: block; margin-bottom: 4px;"></i>Preview Banner ' + num;
        if(btnHapus) btnHapus.style.display = 'none';
        if(badge) { badge.innerText = "Kosong"; badge.style.background = "#F1F5F9"; badge.style.color = "#64748B"; }
    }
};

window.uploadHeroFile = function(num) {
    let fileInput = document.getElementById('heroFile' + num);
    let msg = document.getElementById('heroMsg' + num);
    let badge = document.getElementById('heroBadge' + num);
    if (!fileInput || fileInput.files.length === 0) return;

    let file = fileInput.files[0];
    if (file.size > 5 * 1024 * 1024) {
        if(msg) { msg.style.color = "#EF4444"; msg.innerText = "Maksimal ukuran file 5MB!"; }
        return;
    }

    if(badge) { badge.innerText = "Mengunggah..."; badge.style.background = "#FEF3C7"; badge.style.color = "#D97706"; }
    if(msg) { msg.style.color = "#3B82F6"; msg.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengupload ke Google Drive...'; }

    let reader = new FileReader();
    reader.onload = function(e) {
        let base64Full = e.target.result;
        let base64Data = base64Full.split(',')[1];
        
        previewHero(num, base64Full);

        let dataObj = {
            bannerIndex: num,
            fotoBase64: base64Data,
            fotoType: file.type || "image/jpeg",
            fotoName: file.name || ("hero_banner_" + num + ".jpg")
        };

        if (typeof google !== 'undefined' && google.script && google.script.run) {
            google.script.run
                .withSuccessHandler(function(res) {
                    if (res && res.success && res.url) {
                        let driveUrl = res.url;
                        document.getElementById('heroBanner' + num).value = driveUrl;
                        previewHero(num, driveUrl);
                        localStorage.setItem("kamawak_hero_" + num, driveUrl);
                        if(msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check-circle"></i> Berhasil disimpan di Google Drive!'; }
                    } else {
                        let fallbackUrl = base64Full;
                        document.getElementById('heroBanner' + num).value = fallbackUrl;
                        localStorage.setItem("kamawak_hero_" + num, fallbackUrl);
                        if(msg) { msg.style.color = "#F59E0B"; msg.innerText = "Tersimpan lokal di browser."; }
                    }
                })
                .withFailureHandler(function(err) {
                    let fallbackUrl = base64Full;
                    document.getElementById('heroBanner' + num).value = fallbackUrl;
                    localStorage.setItem("kamawak_hero_" + num, fallbackUrl);
                    if(msg) { msg.style.color = "#F59E0B"; msg.innerText = "Tersimpan lokal di browser."; }
                })
                .uploadHeroBanner(dataObj);
        } else {
            let fallbackUrl = base64Full;
            document.getElementById('heroBanner' + num).value = fallbackUrl;
            localStorage.setItem("kamawak_hero_" + num, fallbackUrl);
            if(msg) { msg.style.color = "#10B981"; msg.innerHTML = '<i class="fa-solid fa-check"></i> Foto berhasil dimuat lokal.'; }
        }
    };
    reader.readAsDataURL(file);
};

