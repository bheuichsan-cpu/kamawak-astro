window.switchTab = function(tabId) {
  document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
  
  const allTabs = ['tabDashboard', 'tabCMS', 'tabPromo', 'tabTransaksi', 'tabKeuangan', 'tabUsers', 'tabAds', 'tabComposer', 'tabPengaturan'];
  allTabs.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });
  
  document.querySelectorAll('[id^="btnTab"]').forEach(b => { 
    b.classList.remove('active', 'tab-active');
    b.style.background = '#FFFFFF'; 
    b.style.color = '#475569'; 
    b.style.borderColor = '#FED7AA';
    b.style.boxShadow = 'none';
  });
  
  const targetContent = document.getElementById(tabId);
  if (targetContent) targetContent.style.display = 'block';

  const targetBtn = document.getElementById('btn' + tabId.charAt(0).toUpperCase() + tabId.slice(1));
  if (targetBtn) {
    targetBtn.classList.add('active', 'tab-active');
    targetBtn.style.background = 'var(--primary)';
    targetBtn.style.color = '#FFFFFF';
    targetBtn.style.borderColor = 'var(--primary)';
    targetBtn.style.boxShadow = '0 4px 14px rgba(255, 94, 31, 0.25)';
  }

  if (tabId === 'tabCMS' && typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();
  if (tabId === 'tabPromo' && typeof muatDaftarPromo === 'function') muatDaftarPromo();
  if (tabId === 'tabAds' && typeof muatDaftarIklan === 'function') muatDaftarIklan();
  if ((tabId === 'tabPengaturan' || tabId === 'tabComposer') && typeof muatPengaturan === 'function') muatPengaturan();
  if (tabId === 'tabComposer' && typeof muatDaftarPintasanKota === 'function') muatDaftarPintasanKota();
  if (tabId === 'tabKeuangan' && typeof muatKas === 'function') muatKas();
  if (tabId === 'tabDashboard' && typeof muatDaftarMitra === 'function') muatDaftarMitra();
};

window.logout = function() {
  localStorage.clear();
  window.location.href = '/';
};

window.onload = async function() {
  const savedId = localStorage.getItem("kamawak_id");
  const savedUser = localStorage.getItem("kamawak_user");
  const savedRole = localStorage.getItem("kamawak_role");

  // Jika tidak ada session atau role bukan admin, tolak akses langsung
  if ((!savedId && !savedUser) || !savedRole || savedRole.toLowerCase() !== "admin") {
    localStorage.clear();
    window.location.href = "/login";
    return;
  }

  try {
    let query = supabase.from('users').select('id, nama, role');
    if (savedId) {
      query = query.eq('id', savedId);
    } else {
      query = query.eq('nama', savedUser);
    }
    const { data: userAuth, error: authErr } = await query.single();

    if (authErr || !userAuth || (userAuth.role || '').toLowerCase() !== 'admin') {
      console.warn("Akses Admin ditolak: Kredensial tidak valid di database.");
      localStorage.clear();
      window.location.href = "/login";
      return;
    }

    // Perbarui session dari record database valid
    localStorage.setItem("kamawak_id", userAuth.id);
    localStorage.setItem("kamawak_user", userAuth.nama);
    localStorage.setItem("kamawak_role", userAuth.role);

    // Buka tampilan setelah diverifikasi resmi oleh database
    const mainBody = document.getElementById("mainBody");
    if (mainBody) mainBody.style.display = "block";

    const adminNameEl = document.getElementById("adminName");
    if (adminNameEl) adminNameEl.innerText = "Halo, " + userAuth.nama;

    muatStatistikGlobal();
    muatDaftarMitra();
    muatTransaksi();
    muatDaftarPengguna();
    muatKas();
    muatPengaturan();
    if (typeof muatDaftarPintasanKota === 'function') muatDaftarPintasanKota();
    if (typeof muatDaftarPromo === 'function') muatDaftarPromo();
  } catch (err) {
    console.error("Gagal verifikasi sesi admin:", err);
    localStorage.clear();
    window.location.href = "/login";
  }
};

async function muatStatistikGlobal() {
  try {
    const { data: wisataData, error: errWisata } = await supabase.from('wisata').select('id, status');
    const { data: usersData, error: errUsers } = await supabase.from('users').select('id, role, status_langganan');
    const { data: leadsData, error: errLeads } = await supabase.from('leads').select('*');
    const { data: trxData, error: errTrx } = await supabase.from('transaksi').select('*').in('status', ['Berhasil', 'Sudah Digunakan']);

    if (errWisata) console.warn("Wisata stats err:", errWisata);
    if (errUsers) console.warn("Users stats err:", errUsers);
    if (errLeads) console.warn("Leads stats err:", errLeads);
    if (errTrx) console.warn("Trx stats err:", errTrx);

    let activeWisata = (wisataData || []).filter(w => (w.status || '').toLowerCase() !== 'nonaktif').length;
    let activeMitraUsers = (usersData || []).filter(u => {
      let r = (u.role || '').toLowerCase();
      return (r === 'owner' || r === 'mitra') && (u.status_langganan || '').toLowerCase() === 'aktif';
    }).length;
    let totalMitraAktif = Math.max(activeWisata, activeMitraUsers, (wisataData || []).length);

    document.getElementById('valMitra').innerText = totalMitraAktif;
    document.getElementById('valLeads').innerText = leadsData ? leadsData.length : 0;
    
    let totalPendapatan = 0;
    if (trxData) {
        trxData.forEach(trx => { totalPendapatan += Number(trx.totalBayar || trx.nominal || 0); });
    }
    document.getElementById('valPendapatan').innerText = "Rp " + totalPendapatan.toLocaleString('id-ID');
  } catch (e) {
    console.error("Global stats error:", e);
    document.getElementById('valMitra').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valLeads').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
    document.getElementById('valPendapatan').innerHTML = '<span style="color:red; font-size:16px;">Error DB</span>';
  }
}

