window.muatPengaturan = function() {
    let b1 = localStorage.getItem("kamawak_hero_1") || "";
    let b2 = localStorage.getItem("kamawak_hero_2") || "";
    let b3 = localStorage.getItem("kamawak_hero_3") || "";
    if(document.getElementById('heroBanner1')) {
        document.getElementById('heroBanner1').value = b1; previewHero(1, b1);
        document.getElementById('heroBanner2').value = b2; previewHero(2, b2);
        document.getElementById('heroBanner3').value = b3; previewHero(3, b3);
    }
    if(document.getElementById('profNamaUsaha')) {
        document.getElementById('profNamaUsaha').value = localStorage.getItem("kamawak_prof_nama") || "";
        document.getElementById('profTagline').value = localStorage.getItem("kamawak_prof_tagline") || "";
        document.getElementById('profNoWA').value = localStorage.getItem("kamawak_prof_wa") || "";
        document.getElementById('profEmail').value = localStorage.getItem("kamawak_prof_email") || "";
        document.getElementById('profAlamat').value = localStorage.getItem("kamawak_prof_alamat") || "";
        document.getElementById('profDeskripsi').value = localStorage.getItem("kamawak_prof_deskripsi") || "";
        document.getElementById('profIG').value = localStorage.getItem("kamawak_prof_ig") || "";
        document.getElementById('profTikTok').value = localStorage.getItem("kamawak_prof_tiktok") || "";
        document.getElementById('profFB').value = localStorage.getItem("kamawak_prof_fb") || "";
    }

    if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
            .withSuccessHandler(function(config) {
                if(!config) return;
                if(config.HERO_BANNER_1 && document.getElementById('heroBanner1')) { document.getElementById('heroBanner1').value = config.HERO_BANNER_1; previewHero(1, config.HERO_BANNER_1); }
                if(config.HERO_BANNER_2 && document.getElementById('heroBanner2')) { document.getElementById('heroBanner2').value = config.HERO_BANNER_2; previewHero(2, config.HERO_BANNER_2); }
                if(config.HERO_BANNER_3 && document.getElementById('heroBanner3')) { document.getElementById('heroBanner3').value = config.HERO_BANNER_3; previewHero(3, config.HERO_BANNER_3); }

                if(config.PROFIL_NAMA_USAHA && document.getElementById('profNamaUsaha')) document.getElementById('profNamaUsaha').value = config.PROFIL_NAMA_USAHA;
                if(config.PROFIL_TAGLINE && document.getElementById('profTagline')) document.getElementById('profTagline').value = config.PROFIL_TAGLINE;
                if(config.PROFIL_NO_WA && document.getElementById('profNoWA')) document.getElementById('profNoWA').value = config.PROFIL_NO_WA;
                if(config.PROFIL_EMAIL && document.getElementById('profEmail')) document.getElementById('profEmail').value = config.PROFIL_EMAIL;
                if(config.PROFIL_ALAMAT && document.getElementById('profAlamat')) document.getElementById('profAlamat').value = config.PROFIL_ALAMAT;
                if(config.PROFIL_DESKRIPSI && document.getElementById('profDeskripsi')) document.getElementById('profDeskripsi').value = config.PROFIL_DESKRIPSI;
                if(config.PROFIL_IG && document.getElementById('profIG')) document.getElementById('profIG').value = config.PROFIL_IG;
                if(config.PROFIL_TIKTOK && document.getElementById('profTikTok')) document.getElementById('profTikTok').value = config.PROFIL_TIKTOK;
                if(config.PROFIL_FB && document.getElementById('profFB')) document.getElementById('profFB').value = config.PROFIL_FB;
            })
            .getPengaturan();
    }
};

</script>
