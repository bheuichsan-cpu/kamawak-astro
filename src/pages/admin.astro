window.resetAdForm = function() {
  document.getElementById('adName').value = "";
  if(document.getElementById('adTargetId')) document.getElementById('adTargetId').value = "";
  if(document.getElementById('adFoto')) document.getElementById('adFoto').value = "";
  if(document.getElementById('adUrlManual')) document.getElementById('adUrlManual').value = "";
  resetAdPreview();
  let info = document.getElementById('adUploadInfo');
  if(info) info.innerText = "";
};

function resetAdPreview() {
  let img = document.getElementById('imgAdPreview');
  let txt = document.getElementById('txtAdPreview');
  let btn = document.getElementById('btnResetAd');
  let badge = document.getElementById('adBadge');
  if(img) { img.src = ""; img.style.display = 'none'; }
  if(txt) { txt.style.display = 'block'; txt.innerHTML = '<i class="fa-solid fa-panorama" style="font-size: 24px; display: block; margin-bottom: 4px;"></i>Pilih file atau masukkan link untuk melihat preview'; }
  if(btn) btn.style.display = 'none';
  if(badge) { badge.innerText = "Belum ada gambar"; badge.style.background = "#F1F5F9"; badge.style.color = "#64748B"; }
}

window.uploadAd = function() {
  let nama = document.getElementById('adName').value.trim();
  let target = document.getElementById('adTargetId') ? document.getElementById('adTargetId').value.trim() : "";
  let fileInput = document.getElementById('adFoto');
  let urlManual = document.getElementById('adUrlManual') ? document.getElementById('adUrlManual').value.trim() : "";
  let info = document.getElementById('adUploadInfo');

  if (!nama) {
    Swal.fire("Data Belum Lengkap", "Mohon isi Judul / Nama Promo!", "warning");
    return;
  }
  let hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
  if (!hasFile && !urlManual) {
    Swal.fire("Foto Belum Dipilih", "Mohon pilih file spanduk atau masukkan link URL gambar!", "warning");
    return;
  }

  if (info) {
    info.style.color = "var(--primary)";
    info.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengunggah spanduk ke Google Drive... Mohon tunggu.';
  }

  function kirimBackend(dataObj) {
    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(function(res) {
          if (typeof res === 'string') {
            try { res = JSON.parse(res); } catch(e) {}
          }
          if (res && res.success) {
            Swal.fire("Berhasil", "Spanduk iklan berhasil ditayangkan!", "success");
            resetAdForm();
            muatDaftarIklan();
          } else {
            Swal.fire("Gagal", "Gagal menyimpan iklan: " + (res && res.error ? res.error : "Unknown error"), "error");
            if (info) { info.style.color = "#EF4444"; info.innerText = "Gagal: " + (res && res.error || "Gagal menyimpan"); }
          }
        })
        .withFailureHandler(function(err) {
          Swal.fire("Error", "Gagal mengunggah: " + err, "error");
          if (info) { info.style.color = "#EF4444"; info.innerText = "Error: " + err; }
        })
        .tambahIklanBaru(dataObj);
    } else {
      let localAds = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
      localAds.push({
        baris: localAds.length + 1,
        nama: dataObj.nama,
        target_id: dataObj.target_id,
        foto: dataObj.fotoUrl || (dataObj.fotoBase64 ? "data:" + dataObj.fotoType + ";base64," + dataObj.fotoBase64 : ""),
        impresi: 0,
        klik: 0,
        status: "Aktif"
      });
      localStorage.setItem('kamawak_ads', JSON.stringify(localAds));
      Swal.fire("Berhasil", "Spanduk iklan berhasil disimpan!", "success");
      resetAdForm();
      muatDaftarIklan();
    }
  }

  if (hasFile) {
    let file = fileInput.files[0];
    let reader = new FileReader();
    reader.onload = function(e) {
      let dataObj = {
        nama: nama,
        target_id: target,
        fotoBase64: e.target.result.split(",")[1],
        fotoType: file.type || "image/jpeg",
        fotoName: file.name || ("ad_" + Date.now() + ".jpg")
      };
      kirimBackend(dataObj);
    };
    reader.readAsDataURL(file);
  } else {
    let dataObj = {
      nama: nama,
      target_id: target,
      fotoUrl: urlManual
    };
    kirimBackend(dataObj);
  }
};

window.muatDaftarIklan = function() {
  let tbody = document.getElementById('tableAdsBody');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 25px;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat data spanduk iklan...</td></tr>';

  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run
      .withSuccessHandler(function(resString) {
        try {
          let res = typeof resString === 'string' ? JSON.parse(resString) : resString;
          if (!res.success) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#EF4444; padding:20px;">Gagal memuat iklan: ${res.error}</td></tr>`;
            return;
          }
          renderTabelIklan(res.data);
        } catch(e) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#EF4444; padding:20px;">Error parsing: ${e.message}</td></tr>`;
        }
      })
      .withFailureHandler(function(err) {
        let local = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
        renderTabelIklan(local);
      })
      .getAllAdsAdmin();
  } else {
    let local = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
    renderTabelIklan(local);
  }
};

function renderTabelIklan(data) {
  let tbody = document.getElementById('tableAdsBody');
  if (!tbody) return;
  if (!data || data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-gray); padding: 30px;"><i class="fa-solid fa-info-circle" style="font-size: 20px; display:block; margin-bottom:8px;"></i>Belum ada spanduk iklan. Tambahkan spanduk baru di atas.</td></tr>';
    return;
  }

  let htmlStr = "";
  data.forEach(item => {
    let isAktif = String(item.status).toLowerCase() === 'aktif';
    let badgeStatus = isAktif 
      ? '<span style="background:#D1FAE5; color:#065F46; padding:4px 8px; border-radius:12px; font-size:11px; font-weight:600;"><i class="fa-solid fa-check"></i> Aktif</span>' 
      : '<span style="background:#FEE2E2; color:#991B1B; padding:4px 8px; border-radius:12px; font-size:11px; font-weight:600;"><i class="fa-solid fa-pause"></i> Non-Aktif</span>';
    
    let impresi = item.impresi || 0;
    let klik = item.klik || 0;
    let ctr = impresi > 0 ? ((klik / impresi) * 100).toFixed(1) + '%' : '0%';

    htmlStr += `
      <tr>
        <td>
          <img src="${item.foto}" style="width:120px; height:50px; object-fit:cover; border-radius:6px; border:1px solid #E2E8F0;" onerror="this.src='https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?w=300'">
        </td>
        <td>
          <strong style="color:var(--text-dark); font-size:13px;">${item.nama}</strong><br>
          <small style="color:var(--text-gray);"><i class="fa-solid fa-link"></i> ${item.target_id || '-'}</small>
        </td>
        <td style="text-align: center; font-weight:700; font-size:15px; color:#475569;">${impresi.toLocaleString('id-ID')}</td>
        <td style="text-align: center; font-weight:700; font-size:15px; color:#3B82F6;">${klik.toLocaleString('id-ID')}</td>
        <td style="text-align: center; font-weight:600; font-size:12px; color:#059669;">${ctr}</td>
        <td style="text-align: center;">${badgeStatus}</td>
        <td style="text-align: center;">
          <div style="display:flex; gap:6px; justify-content:center;">
            <button onclick="toggleStatusIklan(${item.baris}, '${item.status}')" style="background:#F3F4F6; border:1px solid #E5E7EB; padding:6px 10px; border-radius:6px; cursor:pointer; font-size:11px; font-weight:600;" title="Ubah Status">
              ${isAktif ? '<i class="fa-solid fa-pause" style="color:#D97706;"></i> Matikan' : '<i class="fa-solid fa-play" style="color:#10B981;"></i> Aktifkan'}
            </button>
            <button onclick="hapusIklan(${item.baris})" style="background:#FEE2E2; border:none; padding:6px 10px; border-radius:6px; cursor:pointer; color:#EF4444; font-size:11px;" title="Hapus Spanduk">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  });
  tbody.innerHTML = htmlStr;
}

window.toggleStatusIklan = function(baris, statusLama) {
  let newStatus = String(statusLama).toLowerCase() === 'aktif' ? 'Non-Aktif' : 'Aktif';
  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run
      .withSuccessHandler(function() { muatDaftarIklan(); })
      .updateStatusIklan(baris, newStatus);
  } else {
    let local = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
    let target = local.find(x => x.baris === baris);
    if(target) target.status = newStatus;
    localStorage.setItem('kamawak_ads', JSON.stringify(local));
    muatDaftarIklan();
  }
};

window.hapusIklan = function(baris) {
  if (!confirm("Hapus spanduk iklan ini?")) return;
  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run
      .withSuccessHandler(function() { 
        Swal.fire("Terhapus", "Spanduk iklan berhasil dihapus.", "success");
        muatDaftarIklan(); 
      })
      .hapusIklanAdmin(baris);
  } else {
    let local = JSON.parse(localStorage.getItem('kamawak_ads') || '[]');
    local = local.filter(x => x.baris !== baris);
    localStorage.setItem('kamawak_ads', JSON.stringify(local));
    Swal.fire("Terhapus", "Spanduk iklan berhasil dihapus.", "success");
    muatDaftarIklan();
  }
};
