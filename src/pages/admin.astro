                let badgeStatus = String(item.status).toLowerCase() === 'aktif' ? '<span style="background:#10B981; color:white; padding:4px 8px; border-radius:4px; font-size:12px;">Aktif</span>' : '<span style="background:#EF4444; color:white; padding:4px 8px; border-radius:4px; font-size:12px;">Non-Aktif</span>';
                
                htmlStr += '<tr>' +
                  '<td><img src="' + item.foto + '" style="width:100px; height:40px; object-fit:cover; border-radius:4px;"></td>' +
                  '<td>' + item.nama + '<br><small style="color:var(--text-gray)">Target: ' + (item.target_id || '-') + '</small></td>' +
                  '<td style="font-weight:600; font-size:16px;">' + (item.impresi || 0) + '</td>' +
                  '<td style="font-weight:600; font-size:16px; color:#3B82F6;">' + (item.klik || 0) + '</td>' +
                  '<td>' + badgeStatus + '</td>' +
                  '<td>' +
                     '<button onclick="toggleStatusIklan(' + item.baris + ', \'' + item.status + '\')" style="background:#F3F4F6; border:none; padding:6px 12px; border-radius:4px; cursor:pointer;">' +
                        (String(item.status).toLowerCase() === 'aktif' ? 'Matikan' : 'Aktifkan') +
                     '</button>' +
                  '</td>' +
                '</tr>';
             });
             tbody.innerHTML = htmlStr;
           } catch(e) {}
        })
        .getAllAdsAdmin();
    }
    
    function uploadAd() {
      let nama = document.getElementById('adName').value.trim();
      let target = document.getElementById('adTargetId').value.trim();
      let fileInput = document.getElementById('adFoto');
      let info = document.getElementById('adUploadInfo');
      
      if(!nama || fileInput.files.length === 0) {
         info.style.color = "red"; info.innerText = "Mohon isi Nama Promo dan pilih File Spanduk!"; return;
      }
      
      let file = fileInput.files[0];
      if (file.size > 2 * 1024 * 1024) { info.style.color = "red"; info.innerText = "Maksimal ukuran file 2MB!"; return; }
      
      info.style.color = "var(--text-gray)"; info.innerText = "Mengonversi dan mengunggah ke server... Mohon tunggu.";
      
      let reader = new FileReader();
      reader.onload = function(e) {
         let dataObj = {
            nama: nama,
            target_id: target,
            fotoBase64: e.target.result.split(",")[1],
            fotoType: file.type,
            fotoName: file.name
         };
         
         google.script.run
           .withFailureHandler(function(err){ info.style.color = "red"; info.innerText = "Gagal: " + err; })
           .withSuccessHandler(function(res){
               if(res.success) {
                   info.style.color = "#10B981"; info.innerText = "Iklan berhasil ditambahkan!";
                   document.getElementById('adName').value = ""; document.getElementById('adTargetId').value = ""; document.getElementById('adFoto').value = "";
                   muatDaftarIklan();
               } else {
                   info.style.color = "red"; info.innerText = "Gagal: " + res.error;
               }
           })
           .tambahIklanBaru(dataObj);
      };
      reader.readAsDataURL(file);
    }
    
    function toggleStatusIklan(baris, statusLama) {
       let newStatus = statusLama.toLowerCase() === 'aktif' ? 'Non-Aktif' : 'Aktif';
       document.getElementById('tableAdsBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Memperbarui status...</td></tr>';
       google.script.run
         .withSuccessHandler(function(res){ muatDaftarIklan(); })
         .updateStatusIklan(baris, newStatus);
    }

    function muatDaftarTag() {
      document.getElementById('tableTagsBody').innerHTML = '<tr><td colspan="5" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat data tag...</td></tr>';
      google.script.run
        .withFailureHandler(function(e){ document.getElementById('tableTagsBody').innerHTML = '<tr><td colspan="5" style="text-align:center; color:red;">Server Error: '+e+'</td></tr>'; }).withSuccessHandler(function(resString) {
           try {
             let res = JSON.parse(resString);
             let tbody = document.getElementById('tableTagsBody');
             if(!res.success) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Gagal: '+res.error+'</td></tr>'; return; }
             
             if(res.data.length === 0) {
                 tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Belum ada Tag yang dibuat.</td></tr>'; return;
             }
             
             let htmlStr = "";
             res.data.forEach(item => {
                let badgeStatus = String(item.status).toLowerCase() === 'aktif' ? '<span style="background:#10B981; color:white; padding:4px 8px; border-radius:4px; font-size:12px;">Aktif</span>' : '<span style="background:#EF4444; color:white; padding:4px 8px; border-radius:4px; font-size:12px;">Sembunyi</span>';
                
                htmlStr += '<tr>' +
                  '<td><img src="' + item.foto + '" style="width:60px; height:60px; object-fit:cover; border-radius:8px;"></td>' +
                  '<td style="font-weight:600; font-size:16px;">' + item.nama + '</td>' +
                  '<td style="color:var(--text-gray); font-size:14px;">' + (item.subtag || "-") + '</td>' +
                  '<td>' + badgeStatus + '</td>' +
                  '<td>' +
                     '<button onclick="toggleStatusTag(' + item.baris + ', \'' + item.status + '\')" style="background:#F3F4F6; border:none; padding:6px 12px; border-radius:4px; cursor:pointer;">' +
                        (String(item.status).toLowerCase() === 'aktif' ? 'Sembunyikan' : 'Aktifkan') +
                     '</button>' +
                  '</td>' +
                '</tr>';
             });
             tbody.innerHTML = htmlStr;
           } catch(e) {}
        })
        .getAllTagsAdmin();
    }
    
    function uploadTag() {
      let nama = document.getElementById('tagName').value.trim();
      let subtag = document.getElementById('tagSub') ? document.getElementById('tagSub').value.trim() : "";
      let fileInput = document.getElementById('tagFoto');
      let info = document.getElementById('tagUploadInfo');
      
      if(!nama || fileInput.files.length === 0) {
         info.style.color = "red"; info.innerText = "Mohon isi Nama Tag dan pilih Foto Sampul!"; return;
      }
      
      let file = fileInput.files[0];
      if (file.size > 2 * 1024 * 1024) { info.style.color = "red"; info.innerText = "Maksimal ukuran file 2MB!"; return; }
      
      info.style.color = "var(--text-gray)"; info.innerText = "Mengunggah tag ke database... Mohon tunggu.";
      
      let reader = new FileReader();
      reader.onload = function(e) {
         let dataObj = {
            nama: nama,
            subtag: subtag,
            fotoBase64: e.target.result.split(",")[1],
            fotoType: file.type,
            fotoName: file.name
         };
         
         google.script.run
           .withFailureHandler(function(err){ info.style.color = "red"; info.innerText = "Gagal: " + err; })
           .withSuccessHandler(function(res){
               if(res.success) {
                   info.style.color = "#10B981"; info.innerText = "Tag berhasil ditambahkan!";
                   document.getElementById('tagName').value = ""; document.getElementById('tagFoto').value = "";
                   muatDaftarTag();
               } else {
                   info.style.color = "red"; info.innerText = "Gagal: " + res.error;
               }
           })
           .tambahTagBaru(dataObj);
      };
      reader.readAsDataURL(file);
    }
    
    function toggleStatusTag(baris, statusLama) {
       let newStatus = statusLama.toLowerCase() === 'aktif' ? 'Non-Aktif' : 'Aktif';
       document.getElementById('tableTagsBody').innerHTML = '<tr><td colspan="4" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Memperbarui status...</td></tr>';
       google.script.run
         .withSuccessHandler(function(res){ muatDaftarTag(); })
         .updateStatusTag(baris, newStatus);
    }

    var currentLayouts = [];

    function muatLayout() {
      document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat susunan layout...</td></tr>';
      google.script.run.withFailureHandler(function(e){ document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Server Error: '+e+'</td></tr>'; }).withSuccessHandler(function(resString) {
        try {
           let res = JSON.parse(resString);
           if (res.success) {
              currentLayouts = res.data;
              renderTableLayout();
           } else {
              document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">'+res.error+'</td></tr>';
           }
        } catch(e) {
           document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Error memuat data.</td></tr>';
        }
      }).getLayoutData();
    }

    function renderTableLayout() {
      let tbody = document.getElementById('tableLayoutBody');
      tbody.innerHTML = "";
      if (currentLayouts.length === 0) {
         tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Belum ada section. Silakan tambah baru.</td></tr>';
         return;
      }
      
      // Sort by urutan
      currentLayouts.sort((a,b) => a.urutan - b.urutan);
      
      currentLayouts.forEach((item, index) => {
         let tr = document.createElement('tr');
         tr.innerHTML = 
           '<td>' + item.urutan + '</td>' +
           '<td style="font-weight:600;">' + item.judul + '</td>' +
           '<td><span style="background:#F3F4F6; padding:4px 8px; border-radius:4px; font-size:12px;">' + item.tipe + '</span></td>' +
           '<td>' + item.nilai + '</td>' +
           '<td>' + (item.status === 'Aktif' ? '<span class="badge-aktif">Aktif</span>' : '<span class="badge-nonaktif">Nonaktif</span>') + '</td>' +
           '<td>' +
              '<button onclick="hapusLayout(' + index + ')" style="background:none; border:none; color:#EF4444; cursor:pointer;"><i class="fa-solid fa-trash"></i></button>' +
           '</td>';
         tbody.appendChild(tr);
      });
    }

    function ubahOpsiComposer() {
      let tipe = document.getElementById('compTipe').value;
      let inputNilai = document.getElementById('compNilai');
      if (tipe === 'Otomatis') {
         inputNilai.value = 'Populer';
         inputNilai.readOnly = true;
      } else {
         inputNilai.value = '';
         inputNilai.readOnly = false;
         inputNilai.placeholder = "Contoh: " + (tipe === 'Tag' ? 'Promo' : (tipe === 'Kategori' ? 'Penginapan' : 'Bukittinggi'));
      }
    }

    function tambahLayout() {
      let judul = document.getElementById('compJudul').value;
      let tipe = document.getElementById('compTipe').value;
      let nilai = document.getElementById('compNilai').value;
      let urutan = document.getElementById('compUrutan').value;
      let status = document.getElementById('compStatus').value;
      
      if(!judul || !nilai) {
         Swal.fire('Oops', 'Judul dan Nilai wajib diisi!', 'warning');
         return;
      }
      
      let newId = "LAY-" + Date.now();
      currentLayouts.push({
         id: newId,
         judul: judul,
         tipe: tipe,
         nilai: nilai,
         urutan: Number(urutan),
         status: status
      });
      
      document.getElementById('compJudul').value = "";
      document.getElementById('compNilai').value = tipe === 'Otomatis' ? 'Populer' : "";
      document.getElementById('compUrutan').value = Number(urutan) + 1;
      
      renderTableLayout();
    }

    function hapusLayout(index) {
       currentLayouts.splice(index, 1);
       renderTableLayout();
    }

    function simpanSemuaLayout() {
       document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> Menyimpan ke server...</td></tr>';
       google.script.run.withFailureHandler(function(e){ document.getElementById('tableLayoutBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Server Error: '+e+'</td></tr>'; }).withSuccessHandler(function(resString) {
          let res = JSON.parse(resString);
          if (res.success) {
             Swal.fire('Berhasil', 'Susunan halaman berhasil disimpan!', 'success');
             muatLayout();
          } else {
             Swal.fire('Gagal', res.error, 'error');
             muatLayout();
          }
       }).simpanLayoutData(currentLayouts);
    }

</script>



