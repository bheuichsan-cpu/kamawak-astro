  let wa = document.getElementById('cmsWA') ? document.getElementById('cmsWA').value.trim() : '';
  let ig = document.getElementById('cmsIG') ? document.getElementById('cmsIG').value.trim() : '';
  let tiktok = document.getElementById('cmsTikTok') ? document.getElementById('cmsTikTok').value.trim() : '';
  let fb = document.getElementById('cmsFB') ? document.getElementById('cmsFB').value.trim() : '';
  let hargaCoret = document.getElementById('cmsHargaCoret') ? document.getElementById('cmsHargaCoret').value.trim() : '';
  let fotoUrl = document.getElementById('cmsFotoUrl') ? document.getElementById('cmsFotoUrl').value.trim() : '';

  // Tangani file upload jika ada file dipilih dan belum terisi di fotoUrl
  let fileInput = document.getElementById('cmsFotoUpload');
  if (fileInput && fileInput.files && fileInput.files.length > 0 && !fotoUrl) {
    try {
      let fileArr = Array.from(fileInput.files);
      let compressedPromises = fileArr.slice(0, 10).map(f => window.compressImageClient(f, 550, 0.55));
      let results = await Promise.all(compressedPromises);
      fotoUrl = results.filter(Boolean).join('|||');
    } catch(e) {}
  }

  // Batasi fotoUrl maksimal 10 foto jika diinput manual
  if (fotoUrl) {
    let parsedFoto = (typeof window.parseCmsFotoList === 'function') 
      ? window.parseCmsFotoList(fotoUrl)
      : fotoUrl.split(/,\s*(?=https?:\/\/|data:image\/)/i);
    if (parsedFoto.length > 10) {
      fotoUrl = parsedFoto.slice(0, 10).join('|||');
    }
  }

  // Data dasar (selalu ada di skema tabel wisata)
  let basePayload = {
      nama: nama,
      kategori: kategori,
      lokasi: lokasi,
      harga: Number(harga),
      owner: owner || 'Admin',
      status: document.getElementById('cmsStatusLangganan') ? document.getElementById('cmsStatusLangganan').value : 'Aktif',
      foto: fotoUrl || null,
      wa: wa || null
  };

  // Data lengkap (kolom tambahan modern)
  let fullPayload = {
      ...basePayload,
      deskripsi: deskripsi || null,
      fasilitas: fasilitas || null,
      varian: varian || null,
      tags: tags || null,
      itinerary: itinerary || null,
      durasi: durasi || null,
      maps: maps || null,
      ig: ig || null,
      tiktok: tiktok || null,
      fb: fb || null,
      harga_coret: (hargaCoret && !isNaN(hargaCoret)) ? Number(hargaCoret) : null
  };

  const resetForm = () => {
    ['cmsID', 'cmsIDOwner', 'cmsNama', 'cmsDestinasi', 'cmsHarga', 'cmsHargaCoret', 'cmsFotoUrl', 'cmsDurasi', 'cmsMaps', 'cmsWA', 'cmsIG', 'cmsTikTok', 'cmsFB', 'cmsDeskripsi', 'cmsFasilitas', 'cmsVarian', 'cmsTags', 'cmsItinerary'].forEach(fid => {
      let el = document.getElementById(fid);
      if (el) el.value = '';
    });
    let fi = document.getElementById('cmsFotoUpload');
    if (fi) fi.value = '';
    if (typeof window.resetCmsFotoPreview === 'function') window.resetCmsFotoPreview();
    if (typeof window.updateFacilityTagHighlights === 'function') window.updateFacilityTagHighlights();
    if (typeof window.updateCardPreviewLanding === 'function') window.updateCardPreviewLanding();
  };

  const sqlRLSCode = `ALTER TABLE public.wisata DISABLE ROW LEVEL SECURITY;
ALTER TABLE public.transaksi DISABLE ROW LEVEL SECURITY;
ALTER TABLE public.leads DISABLE ROW LEVEL SECURITY;`;

  const sqlMigrationCode = `ALTER TABLE public.wisata 
ADD COLUMN IF NOT EXISTS deskripsi text,
ADD COLUMN IF NOT EXISTS fasilitas text,
ADD COLUMN IF NOT EXISTS varian text,
ADD COLUMN IF NOT EXISTS tags text,
ADD COLUMN IF NOT EXISTS itinerary text,
ADD COLUMN IF NOT EXISTS harga_coret numeric,
ADD COLUMN IF NOT EXISTS durasi text,
ADD COLUMN IF NOT EXISTS maps text,
ADD COLUMN IF NOT EXISTS ig text,
ADD COLUMN IF NOT EXISTS tiktok text,
ADD COLUMN IF NOT EXISTS fb text;`;

  try {
      let savedId = id;
      let rlsBlocked = false;

      if (id) {
          const { data, error } = await supabase.from('wisata').update(fullPayload).eq('id', id).select();
          if (error) {
              if (error.code === '42501' || String(error.message).includes('row-level security')) {
                  rlsBlocked = true;
              } else {
                  throw error;
              }
          } else if (!data || data.length === 0) {
              rlsBlocked = true;
          }
      } else {
          // Jangan kirim ID string manual karena kolom id Supabase bertipe UUID
          const { data, error } = await supabase.from('wisata').insert([fullPayload]).select();
          if (error) {
              if (error.code === '42501' || String(error.message).includes('row-level security')) {
                  rlsBlocked = true;
                  savedId = 'local_' + Date.now();
              } else {
                  throw error;
              }
          } else if (data && data[0]) {
              savedId = data[0].id;
          }
      }

      // Selalu simpan juga ke cache metadata lokal & override agar halaman Beranda & PDP langsung menampilkan data baru
      if (savedId) {
          try {
            fullPayload.id = savedId;
            localStorage.setItem('kamawak_override_' + savedId, JSON.stringify(fullPayload));
            localStorage.setItem('kamawak_meta_' + savedId, JSON.stringify(fullPayload));
            let deletedList = JSON.parse(localStorage.getItem('kamawak_deleted_wisata') || '[]');
            deletedList = deletedList.filter(did => did !== savedId);
            localStorage.setItem('kamawak_deleted_wisata', JSON.stringify(deletedList));
          } catch(e) {}
      }

      if (rlsBlocked) {
          Swal.fire({
              icon: 'warning',
              title: 'Perhatian: Izin Database Perlu Dibuka',
              html: `
                <div style="text-align:left; font-size:13px; color:#374151;">
                  <p>Data berhasil diperbarui di browser ini, namun <b>Supabase membatasi penyimpanan</b> karena fitur <b>Row Level Security (RLS)</b> sedang aktif di tabel <code>wisata</code>.</p>
                  <p style="margin-top:10px;"><strong>Agar tersimpan permanen di Supabase untuk semua pengunjung:</strong></p>
                  <ol style="margin-left:18px; margin-bottom:10px; line-height: 1.6;">
                    <li>Buka <b>Supabase Dashboard &gt; SQL Editor</b>.</li>
                    <li>Jalankan perintah SQL 1-baris berikut:</li>
                  </ol>
                  <textarea readonly id="sqlCopyAreaRLS" style="width:100%; height:75px; font-family:monospace; font-size:11px; background:#1E293B; color:#A7F3D0; padding:8px; border-radius:6px; border:none; resize:none;">${sqlRLSCode}</textarea>
                  <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('sqlCopyAreaRLS').value); alert('Perintah SQL berhasil disalin ke clipboard!');" style="margin-top:8px; padding:6px 14px; background:#3B82F6; color:white; border:none; border-radius:6px; font-size:12px; cursor:pointer;">
                    <i class="fa-solid fa-copy"></i> Salin Perintah SQL
                  </button>
                </div>
              `
          });
      } else {
          Swal.fire({
              icon: 'success',
              title: 'Berhasil Disimpan!',
              text: 'Data produk dan deskripsi berhasil disimpan ke Supabase.',
              timer: 2000
          });
      }

      resetForm();
      if (typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();

  } catch(err) {
      let msg = (err && err.message) ? err.message : String(err);
      
      // Deteksi jika error karena kolom belum ada di database Supabase (PGRST204 / schema cache)
      if (msg.includes("Could not find the '") || msg.includes("schema cache") || err.code === 'PGRST204') {
          Swal.fire({
              title: 'Kolom Database Belum Ditambahkan',
              html: `
                <div style="text-align:left; font-size:13px; color:#374151;">
                  <p>Tabel <b>wisata</b> di database Supabase Anda belum memiliki kolom <b>deskripsi</b> (dan fitur pelengkap lainnya).</p>
                  <p style="margin-top:10px;"><strong>Langkah Mudah Mengaktifkannya (10 Detik):</strong></p>
                  <ol style="margin-left:18px; margin-bottom:10px; line-height: 1.6;">
                    <li>Buka <b>Supabase Dashboard &gt; SQL Editor</b>.</li>
                    <li>Jalankan (Run) perintah SQL berikut:</li>
                  </ol>
                  <textarea readonly id="sqlCopyAreaCMS" style="width:100%; height:110px; font-family:monospace; font-size:11px; background:#1E293B; color:#A7F3D0; padding:8px; border-radius:6px; border:none; resize:none;">${sqlMigrationCode}</textarea>
                  <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('sqlCopyAreaCMS').value); alert('Perintah SQL berhasil disalin ke clipboard!');" style="margin-top:8px; padding:6px 14px; background:#3B82F6; color:white; border:none; border-radius:6px; font-size:12px; cursor:pointer;">
                    <i class="fa-solid fa-copy"></i> Salin Perintah SQL
                  </button>
                  <hr style="margin:15px 0; border:none; border-top:1px solid #E5E7EB;">
                  <p style="font-size:12px; color:#4B5563;"><b>Mode Adaptif Otomatis:</b> Anda dapat menyimpan produk sekarang juga (data utama tersimpan di Supabase &amp; deskripsi/fasilitas dicadangkan di cache lokal).</p>
                </div>
              `,
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'Simpan dengan Mode Adaptif',
              cancelButtonText: 'Tutup & Jalankan SQL Dulu',
              confirmButtonColor: '#10B981',
              cancelButtonColor: '#6B7280'
          }).then(async (result) => {
              if (result.isConfirmed) {
                  try {
                      let fallbackSavedId = id;
                      if (id) {
                          const { error: fbErr } = await supabase.from('wisata').update(basePayload).eq('id', id);
                          if (fbErr) throw fbErr;
                      } else {
                          const { data: fbData, error: fbErr } = await supabase.from('wisata').insert([basePayload]).select();
                          if (fbErr) throw fbErr;
                          if (fbData && fbData[0]) fallbackSavedId = fbData[0].id;
                      }
                      
                      if (fallbackSavedId) {
                          localStorage.setItem('kamawak_override_' + fallbackSavedId, JSON.stringify(fullPayload));
                          localStorage.setItem('kamawak_meta_' + fallbackSavedId, JSON.stringify(fullPayload));
                      }
                      
                      Swal.fire('Tersimpan Adaptif', 'Produk berhasil disimpan ke Supabase! Deskripsi dan rincian paket tetap aktif.', 'success');
                      resetForm();
                      if (typeof muatDaftarWisataCMS === 'function') muatDaftarWisataCMS();
                  } catch (eFallback) {
                      Swal.fire('Gagal', eFallback.message || 'Gagal menyimpan data dasar.', 'error');
                  }
              }
          });
      } else {
          Swal.fire('Gagal Menyimpan', msg || 'Terjadi kesalahan sistem', 'error');
      }
  } finally {
      if (btn) { btn.innerText = oldText; btn.disabled = false; }
  }
};

window.muatDaftarWisataCMS = async function() {
  let tbody = document.getElementById('tableWisataCMSBody');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;"><i class="fa-solid fa-spinner fa-spin"></i> Memuat katalog produk...</td></tr>';
  
  try {
    const { data: rawData, error } = await supabase.from('wisata').select('*').order('created_at', { ascending: false });
    if (error) throw error;
    
    let deletedList = JSON.parse(localStorage.getItem('kamawak_deleted_wisata') || '[]');
    let data = (rawData || []).filter(item => !deletedList.includes(item.id));

    // Gabungkan juga produk lokal baru jika ada yang baru ditambahkan
    for (let i = 0; i < localStorage.length; i++) {
      let key = localStorage.key(i);
      if (key && key.startsWith('kamawak_override_local_')) {
        try {
          let localItem = JSON.parse(localStorage.getItem(key));
          if (localItem && !deletedList.includes(localItem.id) && !data.some(d => d.id === localItem.id)) {
            data.unshift(localItem);
          }
        } catch(e) {}
      }
    }

    if (!data || data.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-gray);">Belum ada produk wisata di database. Silakan tambahkan melalui form di atas.</td></tr>';
      return;
    }

    let html = '';
    data.forEach(item => {
      try {
        let localMeta = JSON.parse(localStorage.getItem('kamawak_override_' + item.id) || localStorage.getItem('kamawak_meta_' + item.id) || 'null');
        if (localMeta) {
          Object.keys(localMeta).forEach(k => {
            if (localMeta[k] !== undefined && localMeta[k] !== null && localMeta[k] !== '') {
              item[k] = localMeta[k];
            }
          });
        }
      } catch(e) {}

      let foto = (typeof window.getFirstValidFoto === 'function') 
        ? window.getFirstValidFoto(item.foto, 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=200')
        : (item.foto ? item.foto.split(',')[0].trim() : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=200');
      let statusBg = item.status === 'Aktif' ? 'background:#10B981;color:white;' : (item.status === 'Nonaktif' ? 'background:#EF4444;color:white;' : 'background:#F59E0B;color:white;');
      let namaSafe = (item.nama || '').replace(/'/g, "\\'");
      
      html += `
        <tr>
          <td><img src="${foto}" style="width:50px; height:40px; object-fit:cover; border-radius:6px; border:1px solid #E5E7EB;" onerror="this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=200'"></td>
          <td style="font-weight:600; font-size:13px;">${item.nama || '-'}</td>
          <td><span style="background:#F3F4F6; padding:3px 8px; border-radius:4px; font-size:12px;">${item.kategori || '-'}</span></td>
          <td style="font-size:13px;">${item.lokasi || item.destinasi || '-'}</td>
          <td style="font-size:13px; font-weight:600;">Rp ${Number(item.harga || 0).toLocaleString('id-ID')}</td>
          <td><span style="padding:3px 8px; border-radius:12px; font-size:11px; font-weight:600; ${statusBg}">${item.status || 'Aktif'}</span></td>
          <td style="text-align: center; white-space: nowrap;">
            <button onclick="editProdukCMS('${item.id}')" style="background:#3B82F6; color:white; border:none; padding:5px 9px; border-radius:6px; font-size:12px; cursor:pointer; margin-right:4px;" title="Edit Produk"><i class="fa-solid fa-pen"></i></button>
            <a href="/pdp?id=${item.id}" target="_blank" style="background:#10B981; color:white; border:none; padding:5px 9px; border-radius:6px; font-size:12px; text-decoration:none; display:inline-block; margin-right:4px;" title="Lihat di Halaman PDP"><i class="fa-solid fa-eye"></i></a>
            <button onclick="hapusProdukCMS('${item.id}', '${namaSafe}')" style="background:#EF4444; color:white; border:none; padding:5px 9px; border-radius:6px; font-size:12px; cursor:pointer;" title="Hapus Produk"><i class="fa-solid fa-trash"></i></button>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = html;
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:red;">Gagal memuat produk: ${e.message}</td></tr>`;
  }
};

