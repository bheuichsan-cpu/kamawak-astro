// ==========================================
// FITUR: MANAJEMEN VOUCHER PROMO ADMIN
// ==========================================
const DEFAULT_ADMIN_PROMOS = [
  { kode: 'MINANGSERU', tipe: 'persen', nilai: 10, min: 100000, deskripsi: 'Diskon 10% Spesial Jelajah Minangkabau', aktif: true },
  { kode: 'HEMAT50K', tipe: 'nominal', nilai: 50000, min: 200000, deskripsi: 'Potongan Langsung Rp 50.000', aktif: true },
  { kode: 'PROMOAWAL', tipe: 'persen', nilai: 15, min: 150000, deskripsi: 'Diskon 15% Eksklusif Wisatawan Baru', aktif: true }
];

function isMasterPromoAktif() {
  let val = localStorage.getItem('kamawak_promo_master_aktif');
  if (val === null || val === undefined) return true;
  return val === 'true';
}

function getPromosFromStorage() {
  let raw = localStorage.getItem('kamawak_promo_codes');
  if (raw === null || raw === undefined) {
    localStorage.setItem('kamawak_promo_codes', JSON.stringify(DEFAULT_ADMIN_PROMOS));
    return DEFAULT_ADMIN_PROMOS;
  }
  try {
    let parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed;
  } catch(e) {
    return [];
  }
}

function syncPromosToCloud(promos, masterAktif) {
  localStorage.setItem('kamawak_promo_codes', JSON.stringify(promos));
  localStorage.setItem('kamawak_promo_master_aktif', String(masterAktif));

  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run
      .withSuccessHandler(function() {})
      .simpanPengaturanForm([
        { key: 'VOUCHER_PROMO', value: JSON.stringify(promos), desc: 'Daftar Voucher Promo & Kupon Diskon' },
        { key: 'FITUR_VOUCHER_AKTIF', value: String(masterAktif), desc: 'Status Fitur Voucher Global (true/false)' }
      ]);
  }
}

window.toggleMasterPromo = function() {
  const current = isMasterPromoAktif();
  const next = !current;
  const promos = getPromosFromStorage();
  syncPromosToCloud(promos, next);
  muatDaftarPromo();
  Swal.fire({
    icon: next ? 'success' : 'warning',
    title: next ? 'Fitur Voucher Diaktifkan' : 'Fitur Voucher Dimatikan',
    text: next ? 'Voucher promo kini aktif dan dapat digunakan di website.' : 'Seluruh voucher promo dan kolom kupon kini disembunyikan dari Beranda & PDP.',
    timer: 2000,
    showConfirmButton: false
  });
};

window.muatDaftarPromo = function() {
  const tbody = document.getElementById('tablePromoBody');
  if (!tbody) return;

  const promos = getPromosFromStorage();
  const masterAktif = isMasterPromoAktif();

  const badgeMaster = document.getElementById('badgeMasterPromo');
  const btnMaster = document.getElementById('btnToggleMasterPromo');
  if (badgeMaster && btnMaster) {
    if (masterAktif) {
      badgeMaster.style.background = '#ECFDF5';
      badgeMaster.style.color = '#059669';
      badgeMaster.innerHTML = '<i class="fa-solid fa-circle-check"></i> Fitur Aktif';
      btnMaster.innerHTML = '<i class="fa-solid fa-power-off"></i> Matikan Fitur';
      btnMaster.style.color = '#DC2626';
    } else {
      badgeMaster.style.background = '#FEE2E2';
      badgeMaster.style.color = '#DC2626';
      badgeMaster.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Fitur Nonaktif';
      btnMaster.innerHTML = '<i class="fa-solid fa-power-off"></i> Aktifkan Fitur';
      btnMaster.style.color = '#059669';
    }
  }

  let totalAktif = 0;
  let totalPersen = 0;
  let totalNominal = 0;

  promos.forEach(p => {
    if (p.aktif !== false) totalAktif++;
    if (p.tipe === 'persen') totalPersen++;
    else totalNominal++;
  });

  const elTotal = document.getElementById('valTotalPromo');
  const elAktif = document.getElementById('valPromoAktif');
  const elTipe = document.getElementById('valPromoTipe');
  if (elTotal) elTotal.innerText = promos.length;
  if (elAktif) elAktif.innerText = masterAktif ? totalAktif : '0 (Fitur Off)';
  if (elTipe) elTipe.innerText = `${totalPersen} % / ${totalNominal} Rp`;

  if (promos.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-gray); padding: 25px;">Belum ada voucher promo. Klik "Tambah Kupon Baru" untuk membuat kupon diskon.</td></tr>';
    return;
  }

  let html = '';
  promos.forEach((p, idx) => {
    const isAktif = p.aktif !== false;
    const badgeStatus = isAktif
      ? '<span style="background: #ECFDF5; color: #059669; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Aktif</span>'
      : '<span style="background: #FEE2E2; color: #DC2626; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;"><i class="fa-solid fa-circle-xmark"></i> Nonaktif</span>';

    const diskonStr = p.tipe === 'persen'
      ? `<span style="background: #EFF6FF; color: #2563EB; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 12px;"><i class="fa-solid fa-percent"></i> ${p.nilai}%</span>`
      : `<span style="background: #FEF3C7; color: #D97706; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 12px;"><i class="fa-solid fa-money-bill-wave"></i> Rp ${Number(p.nilai).toLocaleString('id-ID')}</span>`;

    const minStr = p.min && p.min > 0 ? `Rp ${Number(p.min).toLocaleString('id-ID')}` : '<span style="color: #9CA3AF;">Tanpa Min.</span>';

    html += `
      <tr>
        <td>
          <div style="display: flex; align-items: center; gap: 8px;">
            <code style="background: #F3F4F6; color: var(--primary); font-weight: 800; padding: 4px 8px; border-radius: 6px; font-size: 13px; letter-spacing: 0.5px;">${p.kode}</code>
            <button onclick="salinKodePromo('${p.kode}')" title="Salin kode" style="border: none; background: transparent; cursor: pointer; color: #9CA3AF; padding: 2px;"><i class="fa-regular fa-copy"></i></button>
          </div>
        </td>
        <td>${diskonStr}</td>
        <td style="font-weight: 600; font-size: 13px;">${minStr}</td>
        <td style="font-size: 13px; color: #4B5563;">${p.deskripsi || '-'}</td>
        <td>${badgeStatus}</td>
        <td style="text-align: center;">
          <div style="display: inline-flex; gap: 6px;">
            <button onclick="toggleStatusPromo(${idx})" class="btn-action" style="background: ${isAktif ? '#FEF3C7' : '#D1FAE5'}; color: ${isAktif ? '#B45309' : '#047857'};" title="${isAktif ? 'Nonaktifkan' : 'Aktifkan'}">
              <i class="fa-solid ${isAktif ? 'fa-ban' : 'fa-check'}"></i>
            </button>
            <button onclick="hapusPromoAdmin(${idx})" class="btn-action" style="background: #FEE2E2; color: #DC2626;" title="Hapus Voucher">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
};

window.salinKodePromo = function(kode) {
  navigator.clipboard.writeText(kode).then(() => {
    Swal.fire({
      toast: true,
      position: 'top-end',
      icon: 'success',
      title: `Kode "${kode}" disalin ke clipboard!`,
      showConfirmButton: false,
      timer: 1500
    });
  });
};

window.bukaModalTambahPromo = function() {
  const modal = document.getElementById('modalTambahPromo');
  if (modal) modal.style.display = 'flex';
  const inp = document.getElementById('promoKodeInput');
  if (inp) inp.focus();
};

window.tutupModalTambahPromo = function() {
  const modal = document.getElementById('modalTambahPromo');
  if (modal) modal.style.display = 'none';
  const form = document.getElementById('formPromoBaru');
  if (form) form.reset();
};

window.updateLabelNilaiPromo = function() {
  const tipe = document.getElementById('promoTipeInput').value;
  const lbl = document.getElementById('lblNilaiPromo');
  const inp = document.getElementById('promoNilaiInput');
  if (tipe === 'persen') {
    lbl.innerHTML = 'Nilai Diskon (%) <span style="color:red;">*</span>';
    inp.placeholder = 'Contoh: 10';
  } else {
    lbl.innerHTML = 'Potongan Nominal (Rp) <span style="color:red;">*</span>';
    inp.placeholder = 'Contoh: 50000';
  }
};

window.simpanPromoBaru = function() {
  const kode = (document.getElementById('promoKodeInput').value || '').trim().toUpperCase();
  const tipe = document.getElementById('promoTipeInput').value;
  const nilai = Number(document.getElementById('promoNilaiInput').value || 0);
  const min = Number(document.getElementById('promoMinInput').value || 0);
  const deskripsi = (document.getElementById('promoDeskripsiInput').value || '').trim();

  if (!kode) {
    Swal.fire('Perhatian', 'Kode promo wajib diisi.', 'warning');
    return;
  }
  if (nilai <= 0) {
    Swal.fire('Perhatian', 'Nilai diskon harus lebih besar dari 0.', 'warning');
    return;
  }
  if (tipe === 'persen' && nilai > 100) {
    Swal.fire('Perhatian', 'Diskon persen tidak boleh melebihi 100%.', 'warning');
    return;
  }

  const list = getPromosFromStorage();
  const indexAda = list.findIndex(p => p.kode.toUpperCase() === kode);
  if (indexAda > -1) {
    Swal.fire('Kupon Sudah Ada', `Kode voucher "${kode}" sudah terdaftar sebelumnya. Gunakan kode lain.`, 'error');
    return;
  }

  list.unshift({
    kode: kode,
    tipe: tipe,
    nilai: nilai,
    min: min,
    deskripsi: deskripsi || `Diskon ${tipe === 'persen' ? nilai + '%' : 'Rp ' + nilai.toLocaleString('id-ID')}`,
    aktif: true
  });

  const masterAktif = isMasterPromoAktif();
  syncPromosToCloud(list, masterAktif);
  tutupModalTambahPromo();
  muatDaftarPromo();
  Swal.fire('Kupon Dibuat! 🎉', `Voucher diskon <strong>${kode}</strong> berhasil disimpan dan langsung aktif di checkout PDP.`, 'success');
};

window.toggleStatusPromo = function(index) {
  const list = getPromosFromStorage();
  if (!list[index]) return;
  list[index].aktif = !list[index].aktif;
  const masterAktif = isMasterPromoAktif();
  syncPromosToCloud(list, masterAktif);
  muatDaftarPromo();
  Swal.fire({
    toast: true,
    position: 'top-end',
    icon: 'info',
    title: `Status Kupon ${list[index].kode} diubah jadi ${list[index].aktif ? 'Aktif' : 'Nonaktif'}`,
    showConfirmButton: false,
    timer: 1500
  });
};

window.hapusPromoAdmin = function(index) {
  const list = getPromosFromStorage();
  if (!list[index]) return;
  const promo = list[index];

  Swal.fire({
    title: 'Hapus Kupon Promo?',
    html: `Apakah Anda yakin ingin menghapus kupon <strong>${promo.kode}</strong>? Kupon tidak dapat digunakan wisatawan lagi.`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#EF4444',
    cancelButtonColor: '#6B7280',
    confirmButtonText: 'Ya, Hapus',
    cancelButtonText: 'Batal'
  }).then((res) => {
    if (res.isConfirmed) {
      list.splice(index, 1);
      const masterAktif = isMasterPromoAktif();
      syncPromosToCloud(list, masterAktif);
      muatDaftarPromo();
      Swal.fire('Terhapus', `Kupon ${promo.kode} telah dihapus.`, 'success');
    }
  });
};

</script>
</div>
<BottomNav current="profile" />
</body>
</html>
